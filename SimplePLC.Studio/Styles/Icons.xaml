    <!-- ========================================================================= -->
    <!-- 4. REUSABLE INDUSTRIAL PATH VECTOR STYLES                                 -->
    <!-- ========================================================================= -->

    <!-- Base Vector Style: Clean 1.5px stroke, rounded caps and joins -->
    <Style x:Key="IecVectorIconBaseStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Toolbox Expander Category Header Icon: 12.5x12.5, Slate-600 -->
    <Style x:Key="IecToolboxExpanderIconStyle" TargetType="Path" BasedOn="{StaticResource IecVectorIconBaseStyle}">
        <Setter Property="Width" Value="12.5" />
        <Setter Property="Height" Value="12.5" />
        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Toolbox Block Card Icon: 12.5x12.5, neutral slate or overridden per block -->
    <Style x:Key="IecToolboxCardIconStyle" TargetType="Path" BasedOn="{StaticResource IecVectorIconBaseStyle}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Toolbar Operation Icon: 15x15 -->
    <Style x:Key="IecToolbarIconStyle" TargetType="Path" BasedOn="{StaticResource IecVectorIconBaseStyle}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Status / Mini Indicator Icon: 12x12 -->
    <Style x:Key="IecStatusIconStyle" TargetType="Path" BasedOn="{StaticResource IecVectorIconBaseStyle}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

