                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionInactiveBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IndustrialBorderSubtleBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
