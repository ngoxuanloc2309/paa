                                    <Setter Property="Fill" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorActive}" Value="True">
                                            <Setter Property="Fill" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusyActive}" Value="True">
                                            <Setter Property="Fill" Value="#D97706" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDoneActive}" Value="True">
                                            <Setter Property="Fill" Value="#107C41" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusPillText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="105">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorActive}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusyActive}" Value="True">
                                            <Setter Property="Foreground" Value="#D97706" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDoneActive}" Value="True">
                                            <Setter Property="Foreground" Value="#107C41" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </nodify:Node>
    </DataTemplate>

    <!-- 13. Direct Write Node Template (Direct Physical Output Actuator & Pixel / Pulse Driver) -->
    <DataTemplate DataType="{x:Type vm:DirectWriteNodeViewModel}">
        <nodify:Node Style="{StaticResource IndustrialDynamicNodeStyle}"
                     Width="210"
                     HeaderBrush="{StaticResource NodeActionBrush}"
                     Input="{Binding InputConnectors}"
                     Output="{Binding OutputConnectors}">
            <nodify:Node.Header>
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#0284C7" />
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="#111827" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="2" Padding="4,1" HorizontalAlignment="Right">
                        <TextBlock Text="PULSE" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#0284C7" />
                    </Border>
                </DockPanel>
            </nodify:Node.Header>
            <nodify:Node.InputConnectorTemplate>
                <DataTemplate>
                    <nodify:NodeInput Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                        IsConnected="{Binding IsConnected}"
                                        Header="{Binding Title}"
                                        ToolTip="{Binding TooltipText}"
                                        Margin="0,1" />
                </DataTemplate>
            </nodify:Node.InputConnectorTemplate>
            <nodify:Node.OutputConnectorTemplate>
                <DataTemplate>
                    <nodify:NodeOutput Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                        IsConnected="{Binding IsConnected}"
                                        Header="{Binding Title}"
                                        ToolTip="{Binding TooltipText}"
                                        Margin="0,1" />
                </DataTemplate>
            </nodify:Node.OutputConnectorTemplate>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                <!-- Physical Target & Output Mode Summary -->
                <TextBlock Text="{Binding TargetPinDisplay}" FontWeight="Bold" FontSize="11" FontFamily="Consolas" TextAlignment="Center" HorizontalAlignment="Center" Foreground="#0F172A" Margin="0,0,0,1" ToolTip="{Binding SummaryText}" />
                <TextBlock Text="{Binding ModeSummaryDisplay}" FontWeight="SemiBold" FontSize="10" FontFamily="Consolas" TextAlignment="Center" HorizontalAlignment="Center" Foreground="#475569" Margin="0,0,0,4" ToolTip="{Binding SummaryText}" />

                <!-- Status Pill -->
                <Border CornerRadius="2" Padding="6,2" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsErrorActive}" Value="True">
                                    <Setter Property="Background" Value="#FEF2F2" />
                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusyActive}" Value="True">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Setter Property="BorderBrush" Value="#D97706" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDoneActive}" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="BorderBrush" Value="#107C41" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorActive}" Value="True">
                                            <Setter Property="Fill" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusyActive}" Value="True">
                                            <Setter Property="Fill" Value="#D97706" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDoneActive}" Value="True">
                                            <Setter Property="Fill" Value="#107C41" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusPillText}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorActive}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusyActive}" Value="True">
                                            <Setter Property="Foreground" Value="#D97706" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDoneActive}" Value="True">
                                            <Setter Property="Foreground" Value="#107C41" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </nodify:Node>
    </DataTemplate>

    <!-- Connection Line Template: Straight or Orthogonal PLC Ladder Wire from Pin to Pin -->
    <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
        <Grid Background="Transparent">
            <!-- Vùng hit-test vô hình dày 12px để click chuột mượt mà -->
            <controls:IndustrialStepConnection Source="{Binding Source.Anchor}"
                                               Target="{Binding Target.Anchor}"
                                               SourceOffset="0,0"
                                               TargetOffset="0,0"
                                               ArrowEnds="None"
                                               Stroke="Transparent"
                                               StrokeThickness="12" />
            
            <!-- Dây hiển thị thực tế: nét liền phẳng chuẩn công nghiệp, đường thẳng hoặc vuông góc 90 độ -->
            <controls:IndustrialStepConnection Source="{Binding Source.Anchor}"
                                               Target="{Binding Target.Anchor}"
                                               SourceOffset="0,0"
                                               TargetOffset="0,0"
                                               IsHitTestVisible="False">
                <controls:IndustrialStepConnection.Style>
                    <Style TargetType="{x:Type controls:IndustrialStepConnection}">
                        <Setter Property="Stroke" Value="#64748B" />
                        <Setter Property="StrokeThickness" Value="2" />
                        <Setter Property="ArrowEnds" Value="None" />
                        <Setter Property="ArrowSize" Value="6,6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="#006487" />
                                <Setter Property="StrokeThickness" Value="2.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Stroke" Value="#107C41" />
                                <Setter Property="StrokeThickness" Value="2.5" />
                                <Setter Property="ArrowEnds" Value="End" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:IndustrialStepConnection.Style>
            </controls:IndustrialStepConnection>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
