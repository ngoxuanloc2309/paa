<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
                    xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
                    xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
                    xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
                    xmlns:services="clr-namespace:SimplePLC.Studio.Services">

    <converters:NodeLiveBadgeBackgroundConverter x:Key="NodeLiveBadgeBackgroundConverter" />
    <converters:NodeLiveBadgeBorderConverter x:Key="NodeLiveBadgeBorderConverter" />
    <converters:NodeLiveBadgeForegroundConverter x:Key="NodeLiveBadgeForegroundConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- =================== Industrial Block Icon Geometries (16x16 WPF Vector Path) =================== -->
    <!-- Single-color, scalable, crisp at all DPI — replaces non-rendering Unicode Emoji -->
    <!-- Input Signal: Arrow pointing right with inlet mark -->
    <Geometry x:Key="IconInputSignal">M2,8 L12,8 M8,4 L12,8 L8,12</Geometry>
    <!-- Trigger / Lightning bolt: FBD sharp angular bolt -->
    <Geometry x:Key="IconTriggerLightning">M10,1 L5,8.5 L8.5,8.5 L6,15 L11,7.5 L7.5,7.5 Z</Geometry>
    <!-- Guard / Shield: standard IEC safety shield silhouette -->
    <Geometry x:Key="IconGuardShield">M8,1.5 L13.5,4 L13.5,9.5 Q13.5,13.5 8,15 Q2.5,13.5 2.5,9.5 L2.5,4 Z</Geometry>
    <!-- Action / Coil: IEC 61131-3 coil symbol ( )— -->
    <Geometry x:Key="IconActionCoil">M2,8 L4,8 M12,8 L14,8 M4,4.5 A3.5,3.5 0 1 1 4,11.5</Geometry>
    <!-- Timer / Clock: partial arc + hour/minute hands -->
    <Geometry x:Key="IconTimerClock">M8,1.5 A6.5,6.5 0 1 1 1.5,8 M8,1.5 L8,8 L11,10</Geometry>
    <!-- Counter / Tally grid: horizontal and vertical count lines -->
    <Geometry x:Key="IconCounterHash">M5.5,3 L5.5,13 M10.5,3 L10.5,13 M2,6.5 L14,6.5 M2,10 L14,10</Geometry>
    <!-- Scale / Linear Ramp: step-up ramp representing y=kx+b analog scale -->
    <Geometry x:Key="IconScaleRamp">M2,13 L5,13 L5,9.5 L8,9.5 L8,6 L11,6 L11,3 L14,3</Geometry>
    <!-- Comparator / Relational Operator: two horizontal bars + chevron -->
    <Geometry x:Key="IconComparatorOp">M3.5,6 L8,9 L3.5,12 M9.5,7 L13,7 M9.5,10.5 L13,10.5</Geometry>
    <!-- MQTT / IIoT Broadcast: Antenna tower with radiating waves -->
    <Geometry x:Key="IconMqttBroadcast">M8,14 L8,8 M5,10 A4,4 0 0 1 11,10 M3,7.5 A7,7 0 0 1 13,7.5 M1.5,5 A9.5,9.5 0 0 1 14.5,5</Geometry>
    <!-- Modbus Master / Serial Bus: Bidirectional communication arrows -->
    <Geometry x:Key="IconModbusMaster">M2,5 L14,5 M14,5 L10,2 M14,5 L10,8 M14,11 L2,11 M2,11 L6,8 M2,11 L6,14</Geometry>

    <!-- Shared style for all block header icons: 11×11 viewport, single-color Slate stroke -->
    <Style x:Key="NodeHeaderIconStyle" TargetType="Path">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="#475569"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <!-- =================== End Icon Geometries =================== -->

    <!-- Industrial Typography Standard Tokens -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IndustrialFontSizePin">9.5</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IndustrialFontSizeMeta">10.0</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IndustrialFontSizeBody">11.0</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IndustrialFontSizeHeader">12.5</sys:Double>

    <!-- ControlTemplate for Industrial Port Pins: Crisp circular dot without background overlay on labels -->
    <ControlTemplate x:Key="IndustrialPortPinTemplate" TargetType="{x:Type Control}">
        <Grid Width="10" Height="10" Background="Transparent" VerticalAlignment="Center">
            <Ellipse x:Name="PinBg"
                     Fill="#FFFFFF"
                     Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="2" />
        </Grid>
        <ControlTemplate.Triggers>
            <!-- When connected, only the circular dot fills with the port color -->
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter TargetName="PinBg" Property="Fill" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="PinBg" Property="Stroke" Value="#DC2626" />
                <Setter TargetName="PinBg" Property="Fill" Value="#FEE2E2" />
                <Setter TargetName="PinBg" Property="StrokeThickness" Value="2.5" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PinBg" Property="StrokeThickness" Value="2.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Global NodeInput & NodeOutput Styles: 100% transparent backgrounds, zero dark color blocks -->
    <Style TargetType="{x:Type nodify:NodeInput}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#006487" />
        <Setter Property="Foreground" Value="#475569" />
        <Setter Property="FontSize" Value="{StaticResource IndustrialFontSizePin}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="Cursor" Value="Cross" />
        <Setter Property="ConnectorTemplate" Value="{StaticResource IndustrialPortPinTemplate}" />
    </Style>

    <Style TargetType="{x:Type nodify:NodeOutput}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#107C41" />
        <Setter Property="Foreground" Value="#475569" />
        <Setter Property="FontSize" Value="{StaticResource IndustrialFontSizePin}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="Cursor" Value="Cross" />
        <Setter Property="ConnectorTemplate" Value="{StaticResource IndustrialPortPinTemplate}" />
    </Style>


    <!-- Master Industrial Node Style: Modern, Sleek, Crisp Card with Side Edge Connectors -->
    <Style x:Key="IndustrialNodeStyle" TargetType="{x:Type nodify:Node}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#D1D5DB" />
        <Setter Property="Width" Value="180" />
        <Setter Property="Height" Value="86" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nodify:Node}">
                    <Border x:Name="NodeBorder"
                            Background="#FFFFFF"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Row 0: Top Accent Stripe (4px Chẵn) -->
                                <RowDefinition Height="4" />
                                <!-- Row 1: Header (26px Chẵn) -->
                                <RowDefinition Height="26" />
                                <!-- Row 2: Central Body (56px Cố định chẵn) -->
                                <RowDefinition Height="56" />
                            </Grid.RowDefinitions>

                            <!-- 0. Top Accent Stripe -->
                            <Border x:Name="AccentStripe"
                                    Grid.Row="0"
                                    Background="{TemplateBinding HeaderBrush}"
                                    CornerRadius="2,2,0,0" />

                            <!-- 1. Header with subtle technical gray background and high contrast typography -->
                            <Border Grid.Row="1"
                                    Background="#F3F4F6"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,0">
                                <DockPanel LastChildFill="True">
                                    <!-- In-Place Industrial Network # Badge (Leftmost) -->
                                    <Border DockPanel.Dock="Left" VerticalAlignment="Center"
                                            Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1"
                                            CornerRadius="2" Padding="4,1" Margin="0,0,6,0"
                                            Visibility="{Binding HasNetworkNumber, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding NetworkBadgeText}">
                                        <TextBlock Text="{Binding NetworkBadgeText}" FontSize="9" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="#0F172A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- In-Place Industrial Diagnostic Glyph Badges (Rightmost) -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="DiagErrorBadge"
                                                Background="#DC2626" BorderBrush="#991B1B" BorderThickness="1"
                                                CornerRadius="7" Width="14" Height="14" Margin="2,0,0,0" Visibility="Collapsed"
                                                Cursor="Help" ToolTip="{Binding ErrorMessage}">
                                            <TextBlock Text="!" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,-1,0,0" />
                                        </Border>
                                        <Border x:Name="DiagWarningBadge"
                                                Background="#D97706" BorderBrush="#92400E" BorderThickness="1"
                                                CornerRadius="7" Width="14" Height="14" Margin="2,0,0,0" Visibility="Collapsed"
                                                Cursor="Help" ToolTip="{Binding ErrorMessage}">
                                            <TextBlock Text="!" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,-1,0,0" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Node Header Content (Fills center) -->
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- 2. Integrated Body with Left & Right Ports -->
                            <Grid Grid.Row="2" Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Inputs on the left edge, vertically centered -->
                                <ItemsControl x:Name="PART_Input"
                                              Grid.Column="0"
                                              ItemsSource="{TemplateBinding Input}"
                                              ItemTemplate="{TemplateBinding InputConnectorTemplate}"
                                              VerticalAlignment="Center"
                                              Margin="-6,0,2,0" />

                                <!-- Body Content in the middle: Centered, clean, high contrast -->
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />

                                <!-- Outputs on the right edge, vertically centered -->
                                <ItemsControl x:Name="PART_Output"
                                              Grid.Column="2"
                                              ItemsSource="{TemplateBinding Output}"
                                              ItemTemplate="{TemplateBinding OutputConnectorTemplate}"
                                              VerticalAlignment="Center"
                                              Margin="2,0,-6,0" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Priority 1 (lowest): Selection — informational only -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#006487" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <!-- Priority 2: Ghost state — editing placeholder -->
                        <DataTrigger Binding="{Binding IsGhost}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#475569" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Opacity" Value="0.65" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#475569" />
                            <Setter TargetName="PART_Input" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="PART_Output" Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                        <!-- Priority 3a: Timer Timing in progress (Industrial Indigo) -->
                        <DataTrigger Binding="{Binding IsTiming}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#4C1D95" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Background" Value="#F5F3FF" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#4C1D95" />
                        </DataTrigger>
                        <!-- Priority 3b: Simulation / Live Active — runtime OK state (IEC green border & accent stripe, crisp neutral body) -->
                        <DataTrigger Binding="{Binding IsSimActive}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#107C41" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#107C41" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#107C41" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#107C41" />
                        </DataTrigger>
                        <!-- Priority 4: Simulation Blocked — runtime fault state (IEC red) -->
                        <DataTrigger Binding="{Binding IsSimBlocked}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#B91C1C" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Background" Value="#FEE2E2" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#B91C1C" />
                        </DataTrigger>
                        <!-- Priority 5: Warning — static compile warning; must override sim states -->
                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#D97706" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="DiagWarningBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Priority 6 (highest): Error — critical fault; must override everything -->
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#DC2626" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="DiagErrorBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DiagWarningBadge" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Master Industrial Dynamic Node Style: Auto-expanding height for variable dynamic pins (e.g. MQTT Subscribe) -->
    <Style x:Key="IndustrialDynamicNodeStyle" TargetType="{x:Type nodify:Node}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#D1D5DB" />
        <Setter Property="Width" Value="185" />
        <Setter Property="MinHeight" Value="86" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nodify:Node}">
                    <Border x:Name="NodeBorder"
                            Background="#FFFFFF"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Row 0: Top Accent Stripe (4px) -->
                                <RowDefinition Height="4" />
                                <!-- Row 1: Header (26px) -->
                                <RowDefinition Height="26" />
                                <!-- Row 2: Central Body (Auto-expanding with min 56px) -->
                                <RowDefinition Height="*" MinHeight="56" />
                            </Grid.RowDefinitions>

                            <!-- 0. Top Accent Stripe -->
                            <Border x:Name="AccentStripe"
                                    Grid.Row="0"
                                    Background="{TemplateBinding HeaderBrush}"
                                    CornerRadius="2,2,0,0" />

                            <!-- 1. Header with subtle technical gray background and high contrast typography -->
                            <Border Grid.Row="1"
                                    Background="#F3F4F6"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,0">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" VerticalAlignment="Center"
                                            Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1"
                                            CornerRadius="2" Padding="4,1" Margin="0,0,6,0"
                                            Visibility="{Binding HasNetworkNumber, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding NetworkBadgeText}">
                                        <TextBlock Text="{Binding NetworkBadgeText}" FontSize="9" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="#0F172A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="DiagErrorBadge"
                                                Background="#DC2626" BorderBrush="#991B1B" BorderThickness="1"
                                                CornerRadius="7" Width="14" Height="14" Margin="2,0,0,0" Visibility="Collapsed"
                                                Cursor="Help" ToolTip="{Binding ErrorMessage}">
                                            <TextBlock Text="!" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,-1,0,0" />
                                        </Border>
                                        <Border x:Name="DiagWarningBadge"
                                                Background="#D97706" BorderBrush="#92400E" BorderThickness="1"
                                                CornerRadius="7" Width="14" Height="14" Margin="2,0,0,0" Visibility="Collapsed"
                                                Cursor="Help" ToolTip="{Binding ErrorMessage}">
                                            <TextBlock Text="!" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,-1,0,0" />
                                        </Border>
                                    </StackPanel>

                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- 2. Integrated Body with Left & Right Ports (Dynamic Height) -->
                            <Grid Grid.Row="2" MinHeight="56" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Inputs on the left edge, vertically aligned top -->
                                <ItemsControl x:Name="PART_Input"
                                              Grid.Column="0"
                                              ItemsSource="{TemplateBinding Input}"
                                              ItemTemplate="{TemplateBinding InputConnectorTemplate}"
                                              VerticalAlignment="Top"
                                              Margin="-6,2,2,2" />

                                <!-- Body Content in the middle: Centered, clean -->
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="4,2" />

                                <!-- Outputs on the right edge, vertically stacked, dynamic growth -->
                                <ItemsControl x:Name="PART_Output"
                                              Grid.Column="2"
                                              ItemsSource="{TemplateBinding Output}"
                                              ItemTemplate="{TemplateBinding OutputConnectorTemplate}"
                                              VerticalAlignment="Top"
                                              Margin="2,2,-6,2" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Priority 1 (lowest): Selection — informational only -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#006487" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <!-- Priority 2: Ghost state — editing placeholder -->
                        <DataTrigger Binding="{Binding IsGhost}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#475569" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Opacity" Value="0.65" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#475569" />
                            <Setter TargetName="PART_Input" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="PART_Output" Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                        <!-- Priority 3a: Timer Timing in progress (Industrial Indigo) -->
                        <DataTrigger Binding="{Binding IsTiming}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#4C1D95" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Background" Value="#F5F3FF" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#4C1D95" />
                        </DataTrigger>
                        <!-- Priority 3b: Simulation / Live Active — runtime OK state (IEC green border & accent stripe, crisp neutral body) -->
                        <DataTrigger Binding="{Binding IsSimActive}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#107C41" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#107C41" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#107C41" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#107C41" />
                        </DataTrigger>
                        <!-- Priority 4: Simulation Blocked — runtime fault state (IEC red) -->
                        <DataTrigger Binding="{Binding IsSimBlocked}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#B91C1C" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="NodeBorder" Property="Background" Value="#FEE2E2" />
                            <Setter TargetName="AccentStripe" Property="Background" Value="#B91C1C" />
                        </DataTrigger>
                        <!-- Priority 5: Warning — static compile warning; must override sim states -->
                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#D97706" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="DiagWarningBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Priority 6 (highest): Error — critical fault; must override everything -->
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#DC2626" />
                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="DiagErrorBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DiagWarningBadge" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 1. Input Node Template (Modern, High Contrast, Zero Redundancy) -->
    <DataTemplate DataType="{x:Type vm:InputNodeViewModel}">
        <nodify:Node Style="{StaticResource IndustrialNodeStyle}"
                     HeaderBrush="#1E3A8A"
                     Output="{Binding OutputConnectors}">
            <nodify:Node.Header>
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Path Style="{StaticResource NodeHeaderIconStyle}" Data="{StaticResource IconInputSignal}"/>
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="#111827" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="2" Padding="4,1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TagKindText}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#1E3A8A" />
                    </Border>
                </DockPanel>
            </nodify:Node.Header>
            <nodify:Node.OutputConnectorTemplate>
                <DataTemplate>
                    <nodify:NodeOutput Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                       IsConnected="{Binding IsConnected}"
                                       ToolTip="{Binding TooltipText}" />
                </DataTemplate>
            </nodify:Node.OutputConnectorTemplate>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
