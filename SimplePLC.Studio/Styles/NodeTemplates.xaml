                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="#4C1D95" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                        <Setter Property="Foreground" Value="#107C41" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
                <Border CornerRadius="2" Padding="6,2" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F3F4F6" />
                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                    <Setter Property="Background" Value="#E6F4EA" />
                                    <Setter Property="BorderBrush" Value="#107C41" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTiming}" Value="True">
                                    <Setter Property="Background" Value="#EDE9FE" />
                                    <Setter Property="BorderBrush" Value="#4C1D95" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#64748B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                            <Setter Property="Fill" Value="#107C41" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTiming}" Value="True">
                                            <Setter Property="Fill" Value="#4C1D95" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1E293B" />
                                    <Setter Property="Text" Value="{Binding TimerStatusPillText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                            <Setter Property="Foreground" Value="#107C41" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTiming}" Value="True">
                                            <Setter Property="Foreground" Value="#4C1D95" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </nodify:Node>
    </DataTemplate>

