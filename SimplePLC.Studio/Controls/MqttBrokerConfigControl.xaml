<UserControl x:Class="SimplePLC.Studio.Controls.MqttBrokerConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
             xmlns:viewmodels="clr-namespace:SimplePLC.Studio.ViewModels"
             xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Configuration Cards -->
            <RowDefinition Height="*" />
            <!-- 1. Diagnostics & Test Ping Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

<ScrollViewer  VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                <StackPanel>
                    <!-- Card 1: Dịch vụ & Máy chủ Broker -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Card 1 Header: Tiêu đề + Checkbox Kích hoạt -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding [MqttBrokerSectionNetwork], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding [MqttBrokerEnabledLabel], Source={x:Static services:LocalizationService.Instance}}"
                                          FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Notice Banner when MQTT Client is Disabled -->
                            <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                                    BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" 
                                    BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysAlertTriangle}" 
                                          Width="12" Height="12" Stroke="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [MqttBrokerServiceDisabledNotice], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card 1 Body: Disabled and Dimmed when IsEnabled is False -->
                            <StackPanel IsEnabled="{Binding IsEnabled}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                            <!-- Endpoint & TLS Toggle Row -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Host / IP -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [MqttBrokerHostLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="HostTextBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,5" FontSize="12" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                                        <TextBlock Text="{Binding [MqttBrokerHostPlaceholder], Source={x:Static services:LocalizationService.Instance}}"
                                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"
                                                   Margin="9,6,0,0" IsHitTestVisible="False" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=HostTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <!-- Port -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [MqttBrokerPortLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" 
                                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- TLS / SSL Toggle CheckBox -->
                                <CheckBox Grid.Column="4" IsChecked="{Binding UseTls}" 
                                          Content="{Binding [MqttBrokerTlsLabel], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" 
                                          VerticalAlignment="Bottom" Margin="0,0,0,7" />
                            </Grid>

                            <!-- TLS / SSL Certificate & Security Parameters (Shows when UseTls is True) -->
                            <Border Background="{DynamicResource BgWindowBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                    Visibility="{Binding UseTls, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <!-- TLS Sub-Header: Title & Standards Badge -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [MqttBrokerSectionTls], Source={x:Static services:LocalizationService.Instance}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{DynamicResource IndustrialBorderSubtleBrush}" CornerRadius="2" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="TLS 1.2 / 1.3" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- TLS Mode Selection: One-Way TLS vs Mutual TLS (mTLS) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton Content="{Binding [MqttBrokerTlsModeOneWay], Source={x:Static services:LocalizationService.Instance}}"
                                                     IsChecked="{Binding UseMtls, Converter={StaticResource InverseBool}}"
                                                     GroupName="TlsModeGroup" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,20,0" />
                                        <RadioButton Content="{Binding [MqttBrokerTlsModeMtls], Source={x:Static services:LocalizationService.Instance}}"
                                                     IsChecked="{Binding UseMtls}"
                                                     GroupName="TlsModeGroup" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <!-- A. Server Root CA Certificate Section (Always available in TLS) -->
                                    <TextBlock Text="{Binding [MqttBrokerCaCertLabel], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" Text="{Binding CaCertPath, Mode=OneWay}" IsReadOnly="True"
                                                 Padding="6,4" FontSize="11" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" Background="{DynamicResource BgPanelBrush}" />

                                        <Button Grid.Column="2" Content="{Binding [MqttBrokerBrowseBtn], Source={x:Static services:LocalizationService.Instance}}"
                                                Command="{Binding BrowseCaCertCommand}"
                                                Padding="10,4" FontSize="11" Style="{StaticResource BtnSecondary}" />

                                        <Button Grid.Column="4" Content="{Binding [MqttBrokerClearBtn], Source={x:Static services:LocalizationService.Instance}}"
                                                Command="{Binding ClearCaCertCommand}"
                                                IsEnabled="{Binding HasCaCert}"
                                                Padding="8,4" FontSize="11" Style="{StaticResource BtnSecondary}" />
                                    </Grid>

                                    <!-- Server CA Cert Details Info Badge (When HasCaCert is True) -->
                                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" 
                                            BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,6"
                                            Visibility="{Binding HasCaCert, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="75" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [MqttBrokerCertIssuer], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaCertIssuer}"
                                                       FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                                            <TextBlock  Grid.Column="0" Text="{Binding [MqttBrokerCertExpiry], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            <TextBlock  Grid.Column="1" Text="{Binding CaCertExpiry}"
                                                       FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [MqttBrokerCertFingerprint], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CaCertSha256}"
                                                       FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </Grid>
                                    </Border>

                                    <!-- Default Root CA Note when HasCaCert is False -->
                                    <TextBlock Text="{Binding [MqttBrokerCertNone], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCaCert}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- B. Mutual TLS (mTLS) Client Credentials Section (Shows when UseMtls is True) -->
                                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" 
                                            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,2,0,6"
                                            Visibility="{Binding UseMtls, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <!-- Client Certificate -->
                                            <TextBlock Text="{Binding [MqttBrokerClientCertLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0" Text="{Binding ClientCertPath, Mode=OneWay}" IsReadOnly="True"
                                                         Padding="6,4" FontSize="11" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" Background="{DynamicResource BgWindowBrush}" />

                                                <Button Grid.Column="2" Content="{Binding [MqttBrokerBrowseBtn], Source={x:Static services:LocalizationService.Instance}}"
                                                        Command="{Binding BrowseClientCertCommand}"
                                                        Padding="10,4" FontSize="11" Style="{StaticResource BtnSecondary}" />

                                                <Button Grid.Column="4" Content="{Binding [MqttBrokerClearBtn], Source={x:Static services:LocalizationService.Instance}}"
                                                        Command="{Binding ClearClientCertCommand}"
                                                        IsEnabled="{Binding HasClientCert}"
                                                        Padding="8,4" FontSize="11" Style="{StaticResource BtnSecondary}" />
                                            </Grid>

                                            <!-- Client Private Key & Passphrase Row -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Private Key File -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding [MqttBrokerClientKeyLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0" Text="{Binding ClientKeyPath, Mode=OneWay}" IsReadOnly="True"
                                                                 Padding="6,4" FontSize="11" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" Background="{DynamicResource BgWindowBrush}" />

                                                        <Button Grid.Column="2" Content="{Binding [MqttBrokerBrowseBtn], Source={x:Static services:LocalizationService.Instance}}"
                                                                Command="{Binding BrowseClientKeyCommand}"
                                                                Padding="10,4" FontSize="11" Style="{StaticResource BtnSecondary}" />

                                                        <Button Grid.Column="4" Content="{Binding [MqttBrokerClearBtn], Source={x:Static services:LocalizationService.Instance}}"
                                                                Command="{Binding ClearClientKeyCommand}"
                                                                IsEnabled="{Binding HasClientKey}"
                                                                Padding="8,4" FontSize="11" Style="{StaticResource BtnSecondary}" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Passphrase -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding [MqttBrokerClientKeyPassLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding ClientKeyPassword, UpdateSourceTrigger=PropertyChanged}" 
                                                             Padding="6,4" FontSize="11" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Client Cert Details Info Badge (When HasClientCert is True) -->
                                            <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" 
                                                    BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,2"
                                                    Visibility="{Binding HasClientCert, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="75" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [MqttBrokerCertSubject], Source={x:Static services:LocalizationService.Instance}}"
                                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClientCertSubject}"
                                                               FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                                                    <TextBlock  Grid.Column="0" Text="{Binding [MqttBrokerCertExpiry], Source={x:Static services:LocalizationService.Instance}}"
                                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                    <TextBlock  Grid.Column="1" Text="{Binding ClientCertExpiry}"
                                                               FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [MqttBrokerCertFingerprint], Source={x:Static services:LocalizationService.Instance}}"
                                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClientCertSha256}"
                                                               FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </Grid>
                                            </Border>

                                            <!-- Client Cert None Note when HasClientCert is False -->
                                            <TextBlock Text="{Binding [MqttBrokerClientCertNone], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasClientCert}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- C. Advanced Security & Protocol Expander -->
                                    <Expander Header="{Binding [MqttBrokerTlsAdvancedTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                              IsExpanded="False" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,2">
                                        <StackPanel Margin="0,6,0,0">
                                            <!-- TLS Version & SNI Hostname Row -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="1.5*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Protocol Version -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding [MqttBrokerTlsVersionLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                    <ComboBox SelectedIndex="{Binding TlsVersionIndex}" Height="26" FontSize="11" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}">
                                                        <ComboBoxItem Content="Auto (TLS 1.2 / 1.3)" />
                                                        <ComboBoxItem Content="TLS 1.2 Only" />
                                                        <ComboBoxItem Content="TLS 1.3 Only" />
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- SNI Hostname -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding [MqttBrokerSniLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding SniHostname, UpdateSourceTrigger=PropertyChanged}" 
                                                             Padding="6,4" FontSize="11" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Allow Self-Signed Checkbox -->
                                            <CheckBox IsChecked="{Binding AllowSelfSigned}"
                                                      Content="{Binding [MqttBrokerAllowSelfSignedLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                      FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,3" />

                                            <!-- Ignore Hostname Checkbox -->
                                            <CheckBox IsChecked="{Binding IgnoreHostname}"
                                                      Content="{Binding [MqttBrokerIgnoreHostnameLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                      FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Xác thực, Định danh & Thông số phiên (Gộp Client ID + KeepAlive + CleanSession + Credentials) -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                            IsEnabled="{Binding IsEnabled}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding [MqttBrokerSectionAuth], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

                            <!-- Row 1: Client ID -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding [MqttBrokerClientIdLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid>
                                    <TextBox x:Name="ClientIdTextBox" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,5" FontSize="12" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                                    <TextBlock Text="{Binding [MqttBrokerClientIdPlaceholder], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"
                                               Margin="9,6,0,0" IsHitTestVisible="False" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ClientIdTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!-- Row 2: Username & Password -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Username -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [MqttBrokerUserLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,5" FontSize="12" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                                </StackPanel>

                                <!-- Password -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [MqttBrokerPassLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,5" FontSize="12" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Session Protocol Parameters (KeepAlive + CleanSession) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [MqttBrokerKeepAliveLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding KeepAliveSec, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="64" Padding="6,4" FontSize="12" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                                         HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                                <CheckBox IsChecked="{Binding CleanSession}" 
                                          Content="{Binding [MqttBrokerCleanSessionLabel], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" 
                                          Margin="24,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Last Will & Testament (LWT) -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="12,10"
                            IsEnabled="{Binding IsEnabled}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding [MqttWillSectionTitle], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <CheckBox IsChecked="{Binding WillEnabled}" HorizontalAlignment="Right"
                                          Content="{Binding [MqttWillEnableLabel], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>

                            <StackPanel Visibility="{Binding WillEnabled, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Will Topic -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [MqttWillTopicLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding WillTopic, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"
                                                 Padding="8,5" FontSize="12" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                                    </StackPanel>

                                    <!-- Will QoS -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="QoS" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox SelectedIndex="{Binding WillQos}" Height="28" FontSize="11.5" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}">
                                            <ComboBoxItem Content="QoS 0" />
                                            <ComboBoxItem Content="QoS 1" />
                                            <ComboBoxItem Content="QoS 2" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Will Retain -->
                                    <CheckBox Grid.Column="4" IsChecked="{Binding WillRetain}" VerticalAlignment="Bottom" Margin="0,0,0,7"
                                              Content="{Binding [MqttWillRetainLabel], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>

                                <!-- Will Payload -->
                                <StackPanel>
                                    <TextBlock Text="{Binding [MqttWillPayloadLabel], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding WillPayload, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"
                                             Padding="8,5" FontSize="12" FontFamily="Consolas" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        <!-- Diagnostic Reachability Ping Bar -->
        <Border Grid.Row="1" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
<StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding [MqttBrokerTestBtn], Source={x:Static services:LocalizationService.Instance}}"
                            ToolTip="{Binding [MqttBrokerTestBtnTip], Source={x:Static services:LocalizationService.Instance}}"
                            Command="{Binding TestConnectionCommand}"
                            Style="{StaticResource BtnSecondary}"
                            Padding="12,5" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <TextBlock Text="{Binding TestStatusMessage}" 
                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="320">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTestSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTestSuccess}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
        </Border>
    </Grid>
</UserControl>
