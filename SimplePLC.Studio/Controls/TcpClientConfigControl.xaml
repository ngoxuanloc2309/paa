<UserControl x:Class="SimplePLC.Studio.Controls.TcpClientConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
             xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- TWO-COLUMN MASTER-DETAIL BODY -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Column: Master Settings (1.35*) -->
            <ColumnDefinition Width="1.35*" />
            <ColumnDefinition Width="16" />
            <!-- Right Column: Sticky Live Socket Preview & Diagnostics (380px) -->
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANE: SCROLLABLE SETTINGS CARDS -->
        <ScrollViewer x:Name="MainScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <!-- CARD 1: SOCKET CONNECTION PARAMETERS -->
                <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding [TcpClientGroupConnection], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding [TcpClientGroupConnectionDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Labels -->
                            <DockPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <TextBlock Text="{Binding [TcpClientFieldHost], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RemoteHost.Length, StringFormat='{}{0}/48'}" 
                                           FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Grid.Row="0" Grid.Column="2" 
                                       Text="{Binding [TcpClientFieldPort], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" />

                            <TextBlock Grid.Row="0" Grid.Column="4" 
                                       Text="{Binding [TcpClientFieldReconnect], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" />

                            <!-- Row 1: Controls -->
                            <TextBox Grid.Row="1" Grid.Column="0" 
                                     Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [TcpClientFieldHostTip], Source={x:Static services:LocalizationService.Instance}}" 
                                     FontFamily="Consolas" FontSize="11" Padding="8,4" Height="30" VerticalContentAlignment="Center" />

                            <TextBox Grid.Row="1" Grid.Column="2" 
                                     Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [TcpClientFieldPortTip], Source={x:Static services:LocalizationService.Instance}}"
                                     FontFamily="Consolas" FontSize="11" Padding="8,4" Height="30" VerticalContentAlignment="Center" TextAlignment="Right" />

                            <TextBox Grid.Row="1" Grid.Column="4" 
                                     Text="{Binding ReconnectDelaySec, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [TcpClientFieldReconnectTip], Source={x:Static services:LocalizationService.Instance}}"
                                     FontFamily="Consolas" FontSize="11" Padding="8,4" Height="30" VerticalContentAlignment="Center" TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: STREAM PAYLOAD MODE & FRAMING DELIMITER -->
                <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding [TcpClientGroupPayload], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding [TcpClientGroupPayloadDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Payload Mode & Framing Row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Payload Mode -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [TcpClientFieldPayloadMode], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <ComboBox SelectedValue="{Binding PayloadMode, Mode=TwoWay}" SelectedValuePath="Tag" 
                                          ToolTip="{Binding [TcpClientFieldPayloadModeTip], Source={x:Static services:LocalizationService.Instance}}"
                                          Height="30" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="{Binding [TcpClientOptRawDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="Raw" />
                                    <ComboBoxItem Content="{Binding [TcpClientOptCustomDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="Custom" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Framing Delimiter -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [TcpClientFieldFraming], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" SelectedValue="{Binding FramingDelimiter, Mode=TwoWay}" SelectedValuePath="Tag" 
                                              ToolTip="{Binding [TcpClientFieldFramingTip], Source={x:Static services:LocalizationService.Instance}}"
                                              Height="30" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="{Binding [TcpClientOptFramingCrlf], Source={x:Static services:LocalizationService.Instance}}" Tag="CRLF" />
                                        <ComboBoxItem Content="{Binding [TcpClientOptFramingLf], Source={x:Static services:LocalizationService.Instance}}" Tag="LF" />
                                        <ComboBoxItem Content="{Binding [TcpClientOptFramingNone], Source={x:Static services:LocalizationService.Instance}}" Tag="None" />
                                        <ComboBoxItem Content="{Binding [TcpClientOptFramingCustom], Source={x:Static services:LocalizationService.Instance}}" Tag="Custom" />
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Text="{Binding CustomDelimiterText, UpdateSourceTrigger=PropertyChanged}" 
                                             Visibility="{Binding IsCustomDelimiter, Converter={StaticResource BoolToVis}}" 
                                             Width="75" Height="30" Margin="6,0,0,0" Padding="6,2" FontFamily="Consolas" FontSize="11" VerticalContentAlignment="Center"
                                             ToolTip="Ký tự ngắt khung tùy chọn (ví dụ: ; hoặc | hoặc \0)" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Data Source Tag -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding [TcpClientFieldDataTag], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding AvailableDataTags}" 
                                      SelectedItem="{Binding SelectedDataTagOption, Mode=TwoWay}" 
                                      DisplayMemberPath="DisplayName" 
                                      ToolTip="{Binding [TcpClientFieldDataTagTip], Source={x:Static services:LocalizationService.Instance}}"
                                      Height="30" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Raw Mode Hint -->
                        <TextBlock Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVis}}" 
                                   Text="{Binding [SourceUseFbdPinTcpTip], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,0" TextWrapping="Wrap" />

                        <!-- Custom Mode Editor -->
                        <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding [TcpClientFieldTemplate], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{}{val}" Click="InsertToken_Click" Tag="{}{val}" ToolTip="Chèn giá trị dữ liệu đo lường ({val})" 
                                            Style="{StaticResource TiaTactileBtnStyle}" Padding="6,2" Height="22" FontSize="10" Margin="0,0,4,0" />
                                    <Button Content="{}{tag}" Click="InsertToken_Click" Tag="{}{tag}" ToolTip="Chèn tên biến Tag ({tag})" 
                                            Style="{StaticResource TiaTactileBtnStyle}" Padding="6,2" Height="22" FontSize="10" Margin="0,0,4,0" />
                                    <Button Content="{}{device}" Click="InsertToken_Click" Tag="{}{device}" ToolTip="Chèn mã định danh thiết bị ({device})" 
                                            Style="{StaticResource TiaTactileBtnStyle}" Padding="6,2" Height="22" FontSize="10" Margin="0,0,4,0" />
                                    <Button Content="{}{ts}" Click="InsertToken_Click" Tag="{}{ts}" ToolTip="Chèn timestamp UTC ({ts})" 
                                            Style="{StaticResource TiaTactileBtnStyle}" Padding="6,2" Height="22" FontSize="10" />
                                </StackPanel>
                            </DockPanel>
                            <TextBox x:Name="TxtCustomTemplate" 
                                     Text="{Binding CustomTemplate, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [TcpClientFieldTemplateTip], Source={x:Static services:LocalizationService.Instance}}"
                                     AcceptsReturn="True" AcceptsTab="True" MinLines="3" MaxLines="6"
                                     FontFamily="Consolas" FontSize="11" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="{Binding [TcpClientCustomModeHint], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="2,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 3: GATEWAY REGISTRATION & HEARTBEAT PING -->
                <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding [TcpClientGroupReg], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding [TcpClientGroupRegDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Section 1: Registration Mechanism -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Labels -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding [TcpClientFieldRegType], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" />

                            <TextBlock Grid.Row="0" Grid.Column="2" 
                                       Text="{Binding [TcpClientFieldRegPayload], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegistrationEnabled}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Setter Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Row 1: Controls -->
                            <ComboBox Grid.Row="1" Grid.Column="0" 
                                      SelectedValue="{Binding RegistrationType, Mode=TwoWay}" SelectedValuePath="Tag" 
                                      ToolTip="{Binding [TcpClientFieldRegTypeTip], Source={x:Static services:LocalizationService.Instance}}"
                                      Height="30" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="{Binding [TcpClientOptRegNoneDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="None" />
                                <ComboBoxItem Content="{Binding [TcpClientOptRegOnConnectDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="OnConnect" />
                                <ComboBoxItem Content="{Binding [TcpClientOptRegPrependDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="PrependToEveryPacket" />
                            </ComboBox>

                            <TextBox Grid.Row="1" Grid.Column="2" 
                                     Text="{Binding RegistrationPayload, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsRegistrationEnabled}"
                                     ToolTip="{Binding [TcpClientFieldRegPayloadTip], Source={x:Static services:LocalizationService.Instance}}"
                                     FontFamily="Consolas" FontSize="11" Padding="8,4" Height="30" VerticalContentAlignment="Center" />
                        </Grid>

                        <!-- Section 2: Heartbeat Keep-Alive -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Labels -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding [TcpClientFieldHeartbeatSec], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" />

                            <TextBlock Grid.Row="0" Grid.Column="2" 
                                       Text="{Binding [TcpClientFieldHeartbeatPayload], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeartbeatEnabled}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Setter Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Row 1: Controls -->
                            <TextBox Grid.Row="1" Grid.Column="0" 
                                     Text="{Binding HeartbeatIntervalSec, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [TcpClientFieldHeartbeatSecTip], Source={x:Static services:LocalizationService.Instance}}"
                                     FontFamily="Consolas" FontSize="11" Padding="8,4" Height="30" VerticalContentAlignment="Center" TextAlignment="Right" />

                            <TextBox Grid.Row="1" Grid.Column="2" 
                                     Text="{Binding HeartbeatPayload, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsHeartbeatEnabled}"
                                     ToolTip="{Binding [TcpClientFieldHeartbeatPayloadTip], Source={x:Static services:LocalizationService.Instance}}"
                                     FontFamily="Consolas" FontSize="11" Padding="8,4" Height="30" VerticalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT PANE: STICKY LIVE SOCKET STREAM & PACKET PREVIEW (380px) -->
        <Border Grid.Column="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0. Header -->
                    <RowDefinition Height="Auto" />
                    <!-- 1. Full-Height Monospace Stream Viewer -->
                    <RowDefinition Height="*" />
                    <!-- 2. Diagnostic Summary Box -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Preview Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding [TcpClientPreviewTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Row 1: Full-Height Monospace Stream Viewer -->
                <Border Grid.Row="1" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12"
                        ToolTip="{Binding [TcpClientPreviewTip], Source={x:Static services:LocalizationService.Instance}}">
                    <TextBox Text="{Binding PreviewStreamText, Mode=OneWay}" 
                             IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                             FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                             TextWrapping="NoWrap" Padding="10,8" />
                </Border>

                <!-- Row 2: Socket Diagnostics Summary Box -->
                <Border Grid.Row="2" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [TcpClientDiagTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding [TcpClientDiagRemoteSocket], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SummarySocketText}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding [TcpClientDiagFraming], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SummaryFramingText}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding [TcpClientDiagHeartbeat], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SummaryHeartbeatText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
