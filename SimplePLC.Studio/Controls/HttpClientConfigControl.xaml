<UserControl x:Class="SimplePLC.Studio.Controls.HttpClientConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
             xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- TWO-COLUMN MASTER-DETAIL BODY -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Column: Master Settings (1.35*) -->
            <ColumnDefinition Width="1.35*" />
            <ColumnDefinition Width="16" />
            <!-- Right Column: Sticky Live Preview & Diagnostics (360px) -->
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANE: SCROLLABLE SETTINGS CARDS -->
        <ScrollViewer x:Name="MainScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <!-- CARD 1: ENDPOINT & HTTP METHOD -->
                <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding [HttpClientGroupEndpoint], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding [HttpClientGroupEndpointDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Method & URL Row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Labels -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding [HttpClientFieldMethod], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" />

                            <DockPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <TextBlock Text="{Binding [HttpClientFieldUrl], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Url.Length, StringFormat='{}{0}/64'}" 
                                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                            </DockPanel>

                            <!-- Row 1: Controls -->
                            <ComboBox Grid.Row="1" Grid.Column="0" 
                                      SelectedValue="{Binding Method, Mode=TwoWay}" SelectedValuePath="Tag" 
                                      ToolTip="{Binding [HttpClientFieldMethodTip], Source={x:Static services:LocalizationService.Instance}}"
                                      Height="28" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="{Binding [HttpClientOptPostDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="POST" />
                                <ComboBoxItem Content="{Binding [HttpClientOptPutDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="PUT" />
                            </ComboBox>

                            <TextBox Grid.Row="1" Grid.Column="2" 
                                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [HttpClientFieldUrlTip], Source={x:Static services:LocalizationService.Instance}}" 
                                     FontSize="11.5" Padding="8,4" Height="28" VerticalContentAlignment="Center" />
                        </Grid>

                        <!-- Headers & Timeout Row -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Labels -->
                            <DockPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <TextBlock Text="{Binding [HttpClientFieldHeaders], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CustomHeaders.Length, StringFormat='{}{0}/56'}" 
                                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Grid.Row="0" Grid.Column="2" 
                                       Text="{Binding [HttpClientFieldTimeout], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" />

                            <!-- Row 1: Controls -->
                            <TextBox Grid.Row="1" Grid.Column="0" 
                                     Text="{Binding CustomHeaders, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [HttpClientFieldHeadersTip], Source={x:Static services:LocalizationService.Instance}}" 
                                     FontSize="11.5" Padding="8,4" Height="28" VerticalContentAlignment="Center" />

                            <TextBox Grid.Row="1" Grid.Column="2" 
                                     Text="{Binding TimeoutSec, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [HttpClientFieldTimeoutTip], Source={x:Static services:LocalizationService.Instance}}"
                                     FontSize="11.5" Padding="8,4" Height="28" VerticalContentAlignment="Center" TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: TRIGGER & TIMING MODE -->
                <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding [HttpClientGroupTrigger], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding [HttpClientGroupTriggerDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Labels -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding [HttpClientFieldTriggerMode], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" />

                            <TextBlock Grid.Row="0" Grid.Column="2" 
                                       Text="{Binding [HttpClientFieldPeriodicInterval], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" />

                            <!-- Row 1: Controls -->
                            <ComboBox Grid.Row="1" Grid.Column="0" 
                                      SelectedValue="{Binding TriggerMode, Mode=TwoWay}" SelectedValuePath="Tag" 
                                      ToolTip="{Binding [HttpClientFieldTriggerTip], Source={x:Static services:LocalizationService.Instance}}"
                                      Height="28" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="{Binding [HttpClientOptTrigDataDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="Event" />
                                <ComboBoxItem Content="{Binding [HttpClientOptPeriodicDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="Cyclic" />
                            </ComboBox>

                            <!-- Right Column: When Cyclic show Numeric Interval, when Event show Informative Badge -->
                            <Grid Grid.Row="1" Grid.Column="2">
                                <TextBox Visibility="{Binding IsPeriodicMode, Converter={StaticResource BoolToVis}}" 
                                         Text="{Binding PeriodicIntervalSec, UpdateSourceTrigger=PropertyChanged}" 
                                         ToolTip="{Binding [HttpClientFieldIntervalTip], Source={x:Static services:LocalizationService.Instance}}"
                                         FontSize="11.5" Padding="8,4" Height="28" VerticalContentAlignment="Center" TextAlignment="Right" />

                                <Border Visibility="{Binding IsEventMode, Converter={StaticResource BoolToVis}}" 
                                        Height="28" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,0"
                                        ToolTip="{Binding [HttpClientTriggerEventBadge], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [HttpClientTriggerEventBadge], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 3: PAYLOAD FORMATTING & DATA SOURCE -->
                <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding [HttpClientGroupPayload], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding [HttpClientGroupPayloadDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Payload Mode Selection -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding [HttpClientFieldPayloadMode], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox SelectedValue="{Binding PayloadMode, Mode=TwoWay}" SelectedValuePath="Tag" 
                                      ToolTip="{Binding [HttpClientFieldPayloadModeTip], Source={x:Static services:LocalizationService.Instance}}"
                                      Width="300" Height="30" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                                <ComboBoxItem Content="{Binding [HttpClientOptJsonFieldsDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="JSON" />
                                <ComboBoxItem Content="{Binding [HttpClientOptCustomDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="Custom" />
                                <ComboBoxItem Content="{Binding [HttpClientOptRawPlainDesc], Source={x:Static services:LocalizationService.Instance}}" Tag="Raw" />
                            </ComboBox>
                        </DockPanel>

                        <!-- MODE 1: VISUAL FIELD BUILDER (When JSON) -->
                        <StackPanel Visibility="{Binding IsFieldsMode, Converter={StaticResource BoolToVis}}">
                            <Border BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource BgPanelBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Table Header -->
                                    <Grid Grid.Row="0" Background="{DynamicResource BgSubtleBrush}" Height="28" Margin="4,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" MinWidth="110" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="1.4*" MinWidth="140" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [HttpClientColKey], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding [HttpClientColTag], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding [HttpClientColDataType], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>

                                    <!-- Field Rows -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Fields}" Margin="4,4,4,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*" MinWidth="110" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="1.4*" MinWidth="140" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="75" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Key -->
                                                    <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                             ToolTip="{Binding [HttpClientColKeyTip], Source={x:Static services:LocalizationService.Instance}}"
                                                             Height="28" Padding="6,2" FontSize="11" VerticalContentAlignment="Center" 
                                                             Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                                                    <!-- Source Tag ComboBox -->
                                                    <ComboBox Grid.Column="2" 
                                                              ItemsSource="{Binding DataContext.TagCatalog.AllTags, RelativeSource={RelativeSource AncestorType={x:Type controls:HttpClientConfigControl}}}" 
                                                              SelectedItem="{Binding Tag, Mode=TwoWay}" 
                                                              DisplayMemberPath="DisplayName" 
                                                              ToolTip="{Binding [HttpClientColTagTip], Source={x:Static services:LocalizationService.Instance}}"
                                                              Height="28" Padding="4,2" FontSize="11" VerticalContentAlignment="Center" 
                                                              BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                                                    <!-- Data Type Badge -->
                                                    <Border Grid.Column="4" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Height="28" VerticalAlignment="Center"
                                                            ToolTip="{Binding [HttpClientColDataTypeTip], Source={x:Static services:LocalizationService.Instance}}">
                                                        <TextBlock Text="{Binding DataTypeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Delete Field Button -->
                                                    <Button Grid.Column="6" 
                                                            Style="{StaticResource TableRowDeleteBtnStyle}"
                                                            Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:HttpClientConfigControl}}}" 
                                                            CommandParameter="{Binding}" 
                                                            ToolTip="{Binding [HttpClientBtnDeleteFieldTip], Source={x:Static services:LocalizationService.Instance}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- Add Field Button -->
                            <Button Content="{Binding [HttpClientBtnAddField], Source={x:Static services:LocalizationService.Instance}}" 
                                    Command="{Binding AddFieldCommand}" 
                                    ToolTip="{Binding [HttpClientBtnAddFieldTip], Source={x:Static services:LocalizationService.Instance}}"
                                    Margin="0,8,0,0" Padding="12,5" Height="28" 
                                    Style="{StaticResource TiaTactileBtnStyle}" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- MODE 2: CUSTOM JSON TEMPLATE (Freeform Editor) -->
                        <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding [HttpClientFieldTemplate], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />

                            <TextBox x:Name="TxtCustomTemplate" 
                                     Text="{Binding CustomTemplate, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [HttpClientFieldTemplateTip], Source={x:Static services:LocalizationService.Instance}}"
                                     AcceptsReturn="True" AcceptsTab="True" MinLines="8" MaxLines="14"
                                     FontFamily="Consolas" FontSize="11" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <!-- MODE 3: PLAIN TEXT / RAW DATA (When Raw) -->
                        <StackPanel Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding [HttpClientFieldDataTag], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding AvailableDataTags}" 
                                      SelectedItem="{Binding SelectedDataTagOption, Mode=TwoWay}" 
                                      DisplayMemberPath="DisplayName" 
                                      ToolTip="{Binding [HttpClientFieldDataTagTip], Source={x:Static services:LocalizationService.Instance}}"
                                      Height="30" VerticalContentAlignment="Center" />
                            <TextBlock Text="{Binding [SourceUseFbdPinTip], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="2,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT PANE: STICKY LIVE PAYLOAD PREVIEW & DIAGNOSTICS (360px) -->
        <Border Grid.Column="2" VerticalAlignment="Top" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0. Header & Validity Pill -->
                    <RowDefinition Height="Auto" />
                    <!-- 1. Full-Height Monospace Payload Viewer -->
                    <RowDefinition Height="*" />
                    <!-- 2. Diagnostic Summary Box -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Preview Header with Syntax Validity Indicator -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding [HttpClientPreviewTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- JSON Validity Indicators (Fields / Custom mode) -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsJsonMode, Converter={StaticResource BoolToVis}}">
                            <Border Visibility="{Binding IsJsonValid, Converter={StaticResource BoolToVis}}" 
                                    Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysCheck}" Stroke="{DynamicResource SuccessBrush}" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [HttpClientJsonValidBadgeShort], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Visibility="{Binding HasJsonError, Converter={StaticResource BoolToVis}}" 
                                    Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysClear}" Stroke="{DynamicResource DangerBrush}" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [HttpClientJsonInvalidBadgeShort], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Plain Text Badge (Raw mode) -->
                        <Border Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVis}}" 
                                Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding [HttpClientRawBadge], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Row 1: Monospace Payload Viewer (Clean, no hovering tooltip) -->
                <Border Grid.Row="1" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" MinHeight="140" MaxHeight="360">
                    <TextBox Text="{Binding PreviewPayloadText, Mode=OneWay}" 
                             IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top"
                             Background="Transparent" BorderThickness="0" 
                             FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                             TextWrapping="NoWrap" Padding="10,8" />
                </Border>

                <!-- Row 2: Payload Diagnostics Summary Box (Non-duplicate technical metrics) -->
                <Border Grid.Row="2" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [HttpClientDiagTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding [HttpClientDiagPayloadSize], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding PayloadByteSizeText}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding [HttpClientDiagSource], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SummarySourceDataText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding [HttpClientDiagContentType], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SummaryContentType}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding [HttpClientDiagTrigger], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SummaryTriggerText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
