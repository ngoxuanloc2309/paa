<UserControl x:Class="SimplePLC.Studio.Controls.ZigbeeConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
             xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel>
            <!-- TOP BANNER: MASTER SERVICE ENABLE SWITCH -->
            <Border Background="{DynamicResource BgPanelBrush}" 
                    BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                    BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [ZigbeeEnableTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding [ZigbeeEnableSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                            Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysRadio}" 
                                  Width="12" Height="12" Margin="0,0,6,0"
                                  Stroke="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="{Binding StatusSummaryBadge}" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- DISABLED WARNING BANNER -->
            <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" 
                    CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysAlertTriangle}" 
                          Width="14" Height="14" Stroke="{DynamicResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [ZigbeeDisabledSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- CONFIGURATION SECTION (DIMMED WHEN DISABLED) -->
            <Border CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Setter Property="Opacity" Value="1.0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- CARD 1: WIRELESS NETWORK & NODE IDENTITY -->
                    <Border Background="{DynamicResource BgPanelBrush}" 
                            BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding [ZigbeeCardNetworkTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding [ZigbeeCardNetworkDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,12" />

                            <!-- ROLE SELECTION -->
                            <TextBlock Text="{Binding [ZigbeeFieldRole], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton Content="{Binding [ZigbeeRoleSlave], Source={x:Static services:LocalizationService.Instance}}" 
                                             IsChecked="{Binding IsRoleSlave}" GroupName="ZigbeeRoleGroup" Margin="0,0,24,0" FontSize="11" />
                                <RadioButton Content="{Binding [ZigbeeRoleMaster], Source={x:Static services:LocalizationService.Instance}}" 
                                             IsChecked="{Binding IsRoleMaster}" GroupName="ZigbeeRoleGroup" FontSize="11" />
                            </StackPanel>

                            <!-- NETWORK PARAMETERS 3-COLUMN GRID -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Column 0: Station ID (1..247) -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="{Binding [ZigbeeFieldStationId], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtStationId"
                                         Text="{Binding StationIdText, UpdateSourceTrigger=PropertyChanged}" 
                                         LostFocus="TxtStationId_LostFocus"
                                         FontFamily="Cascadia Code, Consolas" Height="28" Padding="6,4" />
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                           Text="{Binding StationIdErrorMessage}" 
                                           Visibility="{Binding HasStationIdError, Converter={StaticResource BoolToVis}}" 
                                           FontSize="10" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                <!-- Column 1: PAN ID -->
                                <TextBlock Grid.Row="0" Grid.Column="2" 
                                           Text="{Binding [ZigbeeFieldPanId], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Border Grid.Row="1" Grid.Column="2" 
                                        Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                                        BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Height="28">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="0x" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" 
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,2,0" />
                                        <TextBox x:Name="TxtPanId"
                                                 Text="{Binding PanIdHex, UpdateSourceTrigger=PropertyChanged}" 
                                                 LostFocus="TxtPanId_LostFocus"
                                                 BorderThickness="0" Background="Transparent" 
                                                 FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center" Padding="4,2" />
                                    </DockPanel>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding [ZigbeePanIdRangeHint], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />

                                <!-- Column 2: Channel -->
                                <TextBlock Grid.Row="0" Grid.Column="4" 
                                           Text="{Binding [ZigbeeFieldChannel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox Grid.Row="1" Grid.Column="4"
                                          ItemsSource="{Binding AvailableChannels}"
                                          SelectedValuePath="Channel"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding Channel}"
                                          Height="28" FontFamily="Cascadia Code, Consolas" />
                            </Grid>

                            <!-- ANTENNA SELECTION -->
                            <Separator Background="{DynamicResource IndustrialBorderDefaultBrush}" Margin="0,4,0,12" />
                            <TextBlock Text="{Binding [ZigbeeFieldAntenna], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{Binding [ZigbeeAntennaPcb], Source={x:Static services:LocalizationService.Instance}}" 
                                             IsChecked="{Binding IsAntennaPcb}" GroupName="ZigbeeAntennaGroup" Margin="0,0,24,0" FontSize="11" />
                                <RadioButton Content="{Binding [ZigbeeAntennaExternal], Source={x:Static services:LocalizationService.Instance}}" 
                                             IsChecked="{Binding IsAntennaExternal}" GroupName="ZigbeeAntennaGroup" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: AES-128 WIRELESS SECURITY (IEC 62443) -->
                    <Border Background="{DynamicResource BgPanelBrush}" 
                            BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [ZigbeeCardSecurityTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding [ZigbeeCardSecurityDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- KEY_SET STATUS BADGE -->
                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                                        Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                                        BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysLock}" 
                                              Width="11" Height="11" Margin="0,0,6,0"
                                              Stroke="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding KeySetBadgeText}" FontSize="10.5" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <!-- ENABLE AES-128 CHECKBOX -->
                            <CheckBox IsChecked="{Binding IsSecurityEnabled}" Margin="0,0,0,12" FontSize="11.5">
                                <TextBlock Text="{Binding [ZigbeeFieldEnableSecurity], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" />
                            </CheckBox>

                            <StackPanel Visibility="{Binding IsSecurityEnabled, Converter={StaticResource BoolToVis}}">
                                <!-- NETWORK KEY ROW -->
                                <TextBlock Text="{Binding [ZigbeeFieldKey], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <!-- KEY TEXTBOX -->
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding NetworkKey, UpdateSourceTrigger=PropertyChanged}" 
                                             FontFamily="Cascadia Code, Consolas" Height="28" Padding="6,4" />

                                    <!-- TOGGLE VISIBILITY BUTTON -->
                                    <Button Grid.Column="2" Height="28" 
                                            Command="{Binding ToggleKeyVisibilityCommand}"
                                            Style="{StaticResource TactileToolbarBtnStyle}"
                                            ToolTip="{Binding [ZigbeeShowKey], Source={x:Static services:LocalizationService.Instance}}">
                                        <Path Style="{StaticResource IecStatusIconStyle}" 
                                              Data="{StaticResource IconSysLiveWatch}" 
                                              Width="14" Height="14" 
                                              Stroke="{DynamicResource TextSecondaryBrush}" />
                                    </Button>
                                </Grid>

                                <!-- PRESERVE KEY CHECKBOX -->
                                <CheckBox IsChecked="{Binding PreserveKeyOnDeploy}" Margin="0,0,0,6" FontSize="11">
                                    <TextBlock Text="{Binding [ZigbeeFieldPreserveKey], Source={x:Static services:LocalizationService.Instance}}" />
                                </CheckBox>
                                <TextBlock Text="Chuẩn bảo vệ: Khóa 16 byte là Write-Only, đọc từ thiết bị luôn trả về 0x00 để chống trích xuất qua sóng." 
                                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="20,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
