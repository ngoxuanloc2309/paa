<UserControl x:Class="SimplePLC.Studio.Controls.WifiConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
             xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
             xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- CARD 1: Cấu hình mạng Wi-Fi & Xác thực (Network SSID & Credentials) -->
        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" Padding="18,16">
            <StackPanel>
                <!-- Card Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysLock}" 
                          Stroke="{DynamicResource PrimaryBrush}" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [CardWifiCredentials], Source={x:Static services:LocalizationService.Instance}}" 
                               FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Row 1: Wi-Fi Network Name (SSID) & Scan Networks Button -->
                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <!-- SSID Label -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,5"
                               Text="{Binding [WifiSsidLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                    <!-- SSID Input Box & Scanned Networks Editable Dropdown with Integrated Progress Bar -->
                    <Grid Grid.Row="1" Grid.Column="0">
                        <ComboBox IsEditable="True"
                                  HorizontalContentAlignment="Stretch"
                                  TextSearch.TextPath="Ssid"
                                  Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}" 
                                  ItemsSource="{Binding AvailableAps}" 
                                  SelectedItem="{Binding SelectedAp}"
                                  Height="28" Padding="6,2" FontSize="11.5" VerticalContentAlignment="Center"
                                  BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1" ToolTip="{Binding DetailsTooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="22" />
                                        </Grid.ColumnDefinitions>

                                        <!-- SSID Name -->
                                        <TextBlock Grid.Column="0" Text="{Binding Ssid}" 
                                                   FontWeight="SemiBold" FontSize="11.5" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Lock Icon in dedicated column -->
                                        <Path Grid.Column="1" Style="{StaticResource IecStatusIconStyle}" 
                                              Data="{StaticResource IconSysLock}" 
                                              Stroke="{DynamicResource TextMutedBrush}" 
                                              Width="10.5" Height="10.5" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding IsSecured, Converter={StaticResource BoolToVis}}" />

                                        <!-- Windows 11 Wi-Fi Signal Fan in dedicated column -->
                                        <Viewbox Grid.Column="2" Width="15" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="22">
                                                <!-- Top Arc (Bar 4) -->
                                                <Path Data="M2,8.5 C7.5,3 16.5,3 22,8.5"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Fill="Transparent">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                                            <Setter Property="Opacity" Value="0.25" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBar4}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <!-- Mid Arc (Bar 3) -->
                                                <Path Data="M5.5,12 C9,7.5 15,7.5 18.5,12"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Fill="Transparent">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                                            <Setter Property="Opacity" Value="0.25" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBar3}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <!-- Low Arc (Bar 2) -->
                                                <Path Data="M9,15.5 C10.8,12.5 13.2,12.5 15,15.5"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Fill="Transparent">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                                            <Setter Property="Opacity" Value="0.25" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBar2}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <!-- Base Dot (Bar 1 - Always Lit) -->
                                                <Ellipse Canvas.Left="10.4" Canvas.Top="17.4" Width="3.2" Height="3.2" 
                                                         Fill="{DynamicResource TextPrimaryBrush}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Sleek Scanning Line (2px) embedded directly on the bottom border - Zero Layout Shift -->
                        <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="2,0,2,1"
                                     Foreground="{DynamicResource PrimaryBrush}" Background="Transparent" BorderThickness="0"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- Scan Networks Button (Aligned right) -->
                    <Button Grid.Row="1" Grid.Column="2" 
                            Command="{Binding ScanCommand}" Style="{StaticResource TiaTactileBtnStyle}" Height="28" Padding="12,4"
                            IsEnabled="{Binding CanScan}"
                            ToolTip="{Binding [WifiBtnScanNearby], Source={x:Static services:LocalizationService.Instance}}">
                        <Grid>
                            <!-- Normal state (Not Scanning) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVis}}">
                                <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysWifi}" 
                                      Stroke="{DynamicResource TextPrimaryBrush}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [WifiBtnScan], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Loading state (Scanning) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                                <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysReset}" 
                                      Stroke="{DynamicResource PrimaryBrush}" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [WifiBtnScanning], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Error Message Banner -->
                <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource DangerBrush}" 
                        BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysAlert}" 
                              Stroke="{DynamicResource DangerBrush}" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>



                <!-- Row 2: Security Password & Show Password CheckBox -->
                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <!-- Label -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="{Binding [WifiPasswordLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <!-- Password Box / Text Box -->
                    <Grid Grid.Row="1" Grid.Column="0">
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="28" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" 
                                 BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                        <PasswordBox x:Name="PasswordBoxControl" PasswordChar="●" 
                                     Height="28" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"
                                     PasswordChanged="PasswordBoxControl_PasswordChanged" 
                                     BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                    </Grid>

                    <!-- Show Password CheckBox (Aligned right with exact same width as Scan Button) -->
                    <CheckBox Grid.Row="1" Grid.Column="2" 
                              IsChecked="{Binding IsPasswordVisible}" 
                              Content="{Binding [WifiShowPassword], Source={x:Static services:LocalizationService.Instance}}"
                              FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" 
                              VerticalAlignment="Center" Height="28" VerticalContentAlignment="Center" />
                </Grid>

                <!-- Row 3: Auto-reconnect Option -->
                <CheckBox IsChecked="{Binding AutoReconnect}" 
                          Content="{Binding [WifiAutoReconnectLabel], Source={x:Static services:LocalizationService.Instance}}"
                          FontWeight="Normal" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" 
                          VerticalAlignment="Center" Margin="0,2,0,0" />

                <!-- Row 4: Diagnostic Test Connection Action Bar -->
                <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                        BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                        BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Live Status Message & Feedback Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Connecting Loading Spinner / Reset Icon -->
                            <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysReset}" 
                                  Stroke="{DynamicResource PrimaryBrush}" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVis}}" />

                            <!-- Connected Check Icon -->
                            <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysCheck}" 
                                  Stroke="{DynamicResource SuccessBrush}" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />

                            <!-- Status Text -->
                            <TextBlock Text="{Binding ConnectionStatusText}" 
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="4">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="5">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Disconnect Button (visible only when connected) -->
                            <Button Command="{Binding DisconnectCommand}"
                                    Content="{Binding [WifiBtnDisconnect], Source={x:Static services:LocalizationService.Instance}}"
                                    Style="{StaticResource TiaTactileBtnStyle}" Height="28" Padding="12,4" Margin="0,0,8,0"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />

                            <!-- Test Connect Button -->
                            <Button Command="{Binding ConnectCommand}"
                                    Style="{StaticResource TiaTactileBtnStyle}" Height="28" Padding="12,4"
                                    IsEnabled="{Binding CanConnect}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconTriggerLightning}" 
                                          Stroke="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [WifiBtnTestConnect], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- CARD 2: Cấu hình địa chỉ IP (IP Protocol Configuration) -->
        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" Padding="18,16">
            <StackPanel>
                <!-- Card Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysGlobe}" 
                          Stroke="{DynamicResource PrimaryBrush}" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [CardWifiIp], Source={x:Static services:LocalizationService.Instance}}" 
                               FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- DHCP Checkbox -->
                <CheckBox IsChecked="{Binding IsDhcp}" 
                          Content="{Binding [WifiDhcpLabel], Source={x:Static services:LocalizationService.Instance}}"
                          FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                <!-- Static IP Fields (Active only when IsDhcp is False) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsEnabled" Value="True" />
                            <Setter Property="Opacity" Value="1.0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDhcp}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Labels -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="{Binding [WifiStaticIpLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <TextBlock Grid.Row="0" Grid.Column="2" 
                               Text="{Binding [WifiSubnetLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <TextBlock Grid.Row="0" Grid.Column="4" 
                               Text="{Binding [WifiGatewayLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <TextBlock Grid.Row="0" Grid.Column="6" 
                               Text="{Binding [WifiDnsLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <!-- Row 1: Monospace IP Inputs -->
                    <TextBox Grid.Row="1" Grid.Column="0" 
                             Text="{Binding StaticIp, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="11.5" Height="28" Padding="8,4" VerticalContentAlignment="Center" 
                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                    <TextBox Grid.Row="1" Grid.Column="2" 
                             Text="{Binding StaticSubnet, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="11.5" Height="28" Padding="8,4" VerticalContentAlignment="Center" 
                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                    <TextBox Grid.Row="1" Grid.Column="4" 
                             Text="{Binding StaticGateway, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="11.5" Height="28" Padding="8,4" VerticalContentAlignment="Center" 
                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                    <TextBox Grid.Row="1" Grid.Column="6" 
                             Text="{Binding StaticDns, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="11.5" Height="28" Padding="8,4" VerticalContentAlignment="Center" 
                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
