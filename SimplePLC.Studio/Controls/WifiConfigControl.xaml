<UserControl x:Class="SimplePLC.Studio.Controls.WifiConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
             xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- CARD 1: Cấu hình mạng Wi-Fi & Xác thực (Network SSID & Credentials) -->
        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" Padding="18,16">
            <StackPanel>
                <!-- Card Header with Real-time RSSI Pill -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysLock}" 
                              Stroke="{DynamicResource PrimaryBrush}" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [CardWifiCredentials], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Real-Time RSSI Telemetry Pill when connected -->
                    <Border Grid.Column="1" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="3" Padding="8,2" VerticalAlignment="Center"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysWifi}" 
                                  Stroke="{DynamicResource SuccessBrush}" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [WifiRssiLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RssiDbm, StringFormat={}{0} dBm}" 
                                       FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 1: Wi-Fi Network Name (SSID) & Scan Networks Button -->
                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <!-- Label -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="{Binding [WifiSsidLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <!-- SSID Input Box -->
                    <TextBox Grid.Row="1" Grid.Column="0" 
                             Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center" 
                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                    <!-- Scan Networks Button (Aligned right) -->
                    <Button Grid.Row="1" Grid.Column="2" 
                            Command="{Binding ScanCommand}" Style="{StaticResource TiaTactileBtnStyle}" Height="30" Padding="12,4"
                            ToolTip="{Binding [WifiBtnScanNearby], Source={x:Static services:LocalizationService.Instance}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysWifi}" 
                                  Stroke="{DynamicResource TextPrimaryBrush}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [WifiBtnScan], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scanned Networks Dropdown (Visible only when APs found) -->
                <Border BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" 
                        Background="{DynamicResource BgSubtleBrush}" Margin="0,0,0,14" Padding="10,8"
                        Visibility="{Binding AvailableAps.Count, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding [WifiSectionScan], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableAps}" SelectedItem="{Binding SelectedAp}"
                                  Height="30" Padding="8,4" FontSize="11" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Ssid}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0">
                                            <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysWifi}" 
                                                  Stroke="{DynamicResource PrimaryBrush}" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RssiDbm, StringFormat={}{0} dBm}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AuthModeDisplay}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Row 2: Security Password & Show Password CheckBox -->
                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <!-- Label -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="{Binding [WifiPasswordLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <!-- Password Box / Text Box -->
                    <Grid Grid.Row="1" Grid.Column="0">
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" 
                                 BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                        <PasswordBox x:Name="PasswordBoxControl" PasswordChar="●" 
                                     Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"
                                     PasswordChanged="PasswordBoxControl_PasswordChanged" 
                                     BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                    </Grid>

                    <!-- Show Password CheckBox (Aligned right with exact same width as Scan Button) -->
                    <CheckBox Grid.Row="1" Grid.Column="2" 
                              IsChecked="{Binding IsPasswordVisible}" 
                              Content="{Binding [WifiShowPassword], Source={x:Static services:LocalizationService.Instance}}"
                              FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" 
                              VerticalAlignment="Center" Height="30" VerticalContentAlignment="Center" />
                </Grid>

                <!-- Row 3: Auto-reconnect Option -->
                <CheckBox IsChecked="{Binding AutoReconnect}" 
                          Content="{Binding [WifiAutoReconnectLabel], Source={x:Static services:LocalizationService.Instance}}"
                          FontWeight="Normal" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" 
                          VerticalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- CARD 2: Cấu hình địa chỉ IP (IP Protocol Configuration) -->
        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" Padding="18,16">
            <StackPanel>
                <!-- Card Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysGlobe}" 
                          Stroke="{DynamicResource PrimaryBrush}" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding [CardWifiIp], Source={x:Static services:LocalizationService.Instance}}" 
                               FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- DHCP Checkbox -->
                <CheckBox IsChecked="{Binding IsDhcp}" 
                          Content="{Binding [WifiDhcpLabel], Source={x:Static services:LocalizationService.Instance}}"
                          FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                <!-- Static IP Fields (Active only when IsDhcp is False) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsEnabled" Value="True" />
                            <Setter Property="Opacity" Value="1.0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDhcp}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Labels -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="{Binding [WifiStaticIpLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <TextBlock Grid.Row="0" Grid.Column="2" 
                               Text="{Binding [WifiSubnetLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <TextBlock Grid.Row="0" Grid.Column="4" 
                               Text="{Binding [WifiGatewayLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <TextBlock Grid.Row="0" Grid.Column="6" 
                               Text="{Binding [WifiDnsLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />

                    <!-- Row 1: Monospace IP Inputs -->
                    <TextBox Grid.Row="1" Grid.Column="0" 
                             Text="{Binding StaticIp, UpdateSourceTrigger=PropertyChanged}" 
                             FontFamily="Consolas" FontSize="11" Height="30" Padding="8,4" VerticalContentAlignment="Center" 
                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                    <TextBox Grid.Row="1" Grid.Column="2" 
                             Text="{Binding StaticSubnet, UpdateSourceTrigger=PropertyChanged}" 
                             FontFamily="Consolas" FontSize="11" Height="30" Padding="8,4" VerticalContentAlignment="Center" 
                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                    <TextBox Grid.Row="1" Grid.Column="4" 
                             Text="{Binding StaticGateway, UpdateSourceTrigger=PropertyChanged}" 
                             FontFamily="Consolas" FontSize="11" Height="30" Padding="8,4" VerticalContentAlignment="Center" 
                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />

                    <TextBox Grid.Row="1" Grid.Column="6" 
                             Text="{Binding StaticDns, UpdateSourceTrigger=PropertyChanged}" 
                             FontFamily="Consolas" FontSize="11" Height="30" Padding="8,4" VerticalContentAlignment="Center" 
                             BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
