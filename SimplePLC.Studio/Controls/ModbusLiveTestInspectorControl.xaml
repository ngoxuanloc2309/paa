<UserControl x:Class="SimplePLC.Studio.Controls.ModbusLiveTestInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             mc:Ignorable="d" 
             d:DesignHeight="650" 
             d:DesignWidth="310"
             FontFamily="Segoe UI Variable, Segoe UI, system-ui">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityConverterEx x:Key="BoolToVis" />
            <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0">
        <!-- ======================================================== -->
        <!-- MODE A: MODBUS RTU MASTER (CLIENT) LIVE PROBE            -->
        <!-- ======================================================== -->
        <StackPanel Visibility="{Binding IsMasterMode, Converter={StaticResource BoolToVis}}">
            <!-- 1. Header: Device-Based Modbus Channel Diagnostics -->
            <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                        <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconIecModbus}" 
                              Stroke="{DynamicResource PrimaryBrush}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [LiveTestTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding [LiveTestSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="14" />
                </Grid>
            </Border>

            <!-- 2. Card 1: Selected Channel Properties (IBM Carbon Key-Value Layout) -->
            <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                    BorderThickness="1" CornerRadius="6" Padding="12,11" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{Binding [InspectorChannelProps], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Target Channel Identity Badge -->
                    <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10"
                            ToolTip="{Binding TargetSummary}">
                        <TextBlock Text="{Binding TargetSummary}" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Property Grid Details (IBM Carbon: Left Label, Right-Aligned Value) -->
                    <Grid Margin="0,0,0,8" ToolTip="{Binding [InspectorDeviceTagTip], Source={x:Static services:LocalizationService.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [InspectorDeviceTagLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding TargetTagDisplay}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,8" ToolTip="{Binding [InspectorTagAliasTip], Source={x:Static services:LocalizationService.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [InspectorTagAliasLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding TargetTagAlias}" FontSize="11" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,8" ToolTip="{Binding [InspectorDataTypeTip], Source={x:Static services:LocalizationService.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [InspectorDataTypeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding TargetDataType}" FontSize="11" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,2" ToolTip="{Binding [InspectorScaleTip], Source={x:Static services:LocalizationService.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [InspectorScaleLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding TargetScaleDisplay}" FontSize="11" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Card 2: Real-Time Sensor Telemetry from Device -->
            <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                    BorderThickness="1" CornerRadius="6" Padding="12,11" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [InspectorLiveTelemetry], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <!-- Hardware Connection Status Pill -->
                        <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                                ToolTip="{Binding [InspectorHardwareStatusTip], Source={x:Static services:LocalizationService.Instance}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DeviceConnectionBadge}" FontSize="10" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Hero Readout Box (Large Value Display) -->
                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="12,12" Margin="0,0,0,9"
                            ToolTip="{Binding [InspectorScaledValueTip], Source={x:Static services:LocalizationService.Instance}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [InspectorScaledValueTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding LiveScaledValue}" FontSize="22" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,5" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding LiveRawValue}" FontSize="10.5" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ResponseLatency}" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Action Probe Buttons (Stacked 2-Row Layout, Full Width) -->
                    <Grid Margin="0,0,0,9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Read Once Button (Full Width) -->
                        <Button Grid.Row="0" Command="{Binding ReadOnceCommand}" IsEnabled="{Binding HasTargetChannel}" 
                                Style="{StaticResource TiaTactileBtnStyle}" Height="30" HorizontalAlignment="Stretch"
                                ToolTip="{Binding [InspectorBtnReadOnceTip], Source={x:Static services:LocalizationService.Instance}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconTriggerLightning}" 
                                      Stroke="{DynamicResource TextPrimaryBrush}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [LiveTestBtnReadOnce], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Continuous Polling Toggle Button (Full Width) -->
                        <ToggleButton Grid.Row="2" IsChecked="{Binding IsPollingActive, Mode=OneWay}" 
                                      Command="{Binding ToggleContinuousPollingCommand}" IsEnabled="{Binding HasTargetChannel}"
                                      Style="{StaticResource TactileToolbarCheckBoxStyle}" Height="30" HorizontalAlignment="Stretch"
                                      ToolTip="{Binding [InspectorBtnContinuousTip], Source={x:Static services:LocalizationService.Instance}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconTimerClock}" 
                                      Stroke="{DynamicResource TextPrimaryBrush}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [LiveTestBtnContinuous], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <!-- Diagnostic & Troubleshooting Alert Banner -->
                    <Border CornerRadius="4" Padding="8,6" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource IndustrialBorderDefaultBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Success">
                                        <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Warning">
                                        <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Danger">
                                        <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource IecStatusIconStyle}">
                                            <Setter Property="Data" Value="{StaticResource IconSysAlertTriangle}" />
                                            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusState}" Value="Success">
                                                    <Setter Property="Data" Value="{StaticResource IconSysCheckCircle}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusState}" Value="Warning">
                                                    <Setter Property="Data" Value="{StaticResource IconSysAlertTriangle}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusState}" Value="Danger">
                                                    <Setter Property="Data" Value="{StaticResource IconSysAlertCircle}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding TroubleshootingHint}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" 
                                       TextWrapping="Wrap" LineHeight="14" Margin="19,3,0,0"
                                       Visibility="{Binding TroubleshootingHint, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- MODE B: SCADA / HMI INTEGRATION GUIDE (MODBUS SLAVE)     -->
        <!-- ======================================================== -->
        <StackPanel Visibility="{Binding IsSlaveMode, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                    BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Card Header: Title & Access Right Badge -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [ModbusSlaveInspectorCardTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <!-- Access Right Badge -->
                        <Border Grid.Column="1" Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                                BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                            <TextBlock Text="{Binding SlaveAccessRightDisplay}" FontSize="10" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <!-- Target Register Identity Badge (Charcoal Dark Text, Clean Segoe UI) -->
                    <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,12"
                            ToolTip="{Binding SelectedRegisterOrChannelSummary}">
                        <TextBlock Text="{Binding SelectedRegisterOrChannelSummary}" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Property Grid Details (IBM Carbon: Left Muted Label, Right Clean Value) -->
                    <!-- Row 1: SCADA Address (1-based) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [ModbusSlaveInspectorAddressLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding SlaveScadaAddress1Based}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Row 2: Offset Address (0-based) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [ModbusSlaveInspectorOffsetLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding SlaveScadaOffset0Based}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Row 3: Modbus Function Code (FC) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [ModbusSlaveInspectorFuncLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding SlaveFunctionCodeDisplay}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Row 4: Data Length & Format -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [ModbusSlaveInspectorLengthLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding SlaveScadaLengthDisplay}" FontSize="11" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Mapping Rules Section Header -->
                    <TextBlock Text="{Binding [ModbusSlaveInspectorRuleLabel], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />

                    <!-- Rich Mapping Notes Box -->
                    <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock Text="{Binding SlaveScadaMappingGuide}" FontSize="11" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="17" TextWrapping="Wrap" />
                    </Border>

                    <!-- Footer: Modbus Server Port Status (Neutral Slate) -->
                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" 
                            BorderThickness="1" CornerRadius="4" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysInfo}" 
                                  Width="13" Height="13" Stroke="{DynamicResource TextSecondaryBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SlaveServerStatusBadge}" FontSize="10.5" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
