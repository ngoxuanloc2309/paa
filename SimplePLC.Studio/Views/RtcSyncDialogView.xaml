<Window x:Class="SimplePLC.Studio.Views.RtcSyncDialogView"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:services="clr-namespace:SimplePLC.Studio.Services"

        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"

        xmlns:viewmodels="clr-namespace:SimplePLC.Studio.ViewModels"

        xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"

        Title="{Binding [RtcDialogTitle], Source={x:Static services:LocalizationService.Instance}}"

        Width="540"

        SizeToContent="Height"

        WindowStartupLocation="CenterOwner"

        ResizeMode="CanResizeWithGrip"

        controls:WindowChromeHelper.EnableIndependentMinimize="True"

        ShowInTaskbar="True"

        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"

        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"

        Background="{DynamicResource BgWindowBrush}"

        Icon="../Assets/app.png"

        FontFamily="Segoe UI, Segoe UI Variable, system-ui"

        TextOptions.TextFormattingMode="Ideal"

        TextOptions.TextRenderingMode="ClearType"

        RenderOptions.ClearTypeHint="Enabled"
        MinWidth="480"
        MinHeight="320">



    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="../Styles/Colors.xaml" />

                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />

            <converters:NullToVisibilityConverter x:Key="NullToVis" />

        </ResourceDictionary>

    </Window.Resources>



    <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">

        <Grid Margin="20">

            <Grid.RowDefinitions>

                <!-- 0. Header -->

                <RowDefinition Height="Auto" />

                <!-- 1. Card 1: Trạng thái Hiện tại trên Bộ điều khiển -->

                <RowDefinition Height="Auto" />

                <!-- 2. Card 2: Cấu hình Múi giờ Triển khai -->

                <RowDefinition Height="Auto" />

                <!-- 3. Error Alert (nếu có) -->

                <RowDefinition Height="Auto" />

                <!-- 4. Footer Actions -->

                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>



            <!-- 0. Header (Đồng bộ chuẩn DeviceInfo & MqttBroker) -->

            <Grid Grid.Row="0" Margin="0,0,0,16">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconTimerClock}" Stroke="{StaticResource PrimaryBrush}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="1.8" />
                </Border>



                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                    <TextBlock Text="{Binding [RtcDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 

                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Text="{Binding [RtcDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 

                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />

                </StackPanel>

            </Grid>



            <!-- 1. Card 1: Hiện trạng trên Bộ điều khiển -->

            <Border Grid.Row="1" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="{Binding [RtcSectionCurrent], Source={x:Static services:LocalizationService.Instance}}"

                               FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />



                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto" MinWidth="150" />

                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>



                        <!-- Row 0: Thời gian hiện hành -->

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [RtcCurrentTimeLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,2" />

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentMcuTimeText}" 

                                   FontSize="13" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,2" />



                        <!-- Row 1: Cơ chế đồng hồ & Badge kỹ thuật -->

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [RtcClockArchitecture], Source={x:Static services:LocalizationService.Instance}}" 

                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,10,0,0" />

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,8,0,0">

                            <!-- Badge chỉ báo kỹ thuật -->

                            <Border BorderThickness="1" CornerRadius="2" Padding="8,3" HorizontalAlignment="Left">

                                <Border.Style>

                                    <Style TargetType="Border">

                                        <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />

                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding HasHardwareRtc}" Value="True">

                                                <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />

                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Border.Style>

                                <TextBlock Text="{Binding HwRtcBadgeText}" FontSize="11" FontWeight="Bold">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding HasHardwareRtc}" Value="True">

                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Border>



                            <!-- Giải thích kỹ thuật phụ trợ -->

                            <TextBlock Text="{Binding HwRtcDescriptionText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                        </StackPanel>

                    </Grid>



                    <!-- Cảnh báo nếu có sự cố gián đoạn nguồn nuôi -->

                    <Border Background="{DynamicResource WarningLightBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,10,0,0"

                            Visibility="{Binding BatteryWarningText, Converter={StaticResource NullToVis}}">

                        <TextBlock Text="{Binding BatteryWarningText}" FontSize="11" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />

                    </Border>

                </StackPanel>

            </Border>



            <!-- 2. Card 2: Thiết lập Múi giờ Triển khai -->

            <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="{Binding [RtcSectionConfig], Source={x:Static services:LocalizationService.Instance}}"

                               FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />



                    <!-- Chọn múi giờ -->

                    <TextBlock Text="{Binding [RtcTimezoneLabel], Source={x:Static services:LocalizationService.Instance}}" 

                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />



                    <ComboBox ItemsSource="{Binding AvailableTimezones}"

                              SelectedItem="{Binding SelectedTimezone}"

                              DisplayMemberPath="DisplayName"

                              TextSearch.TextPath="DisplayName"

                              IsTextSearchEnabled="True"

                              Height="32" FontSize="12" Margin="0,0,0,12"

                              VerticalContentAlignment="Center"

                              Padding="8,0"

                              BorderBrush="{DynamicResource BorderLightBrush}">

                        <ComboBox.ItemContainerStyle>

                            <Style TargetType="ComboBoxItem">

                                <Setter Property="Padding" Value="8,6" />

                                <Setter Property="VerticalContentAlignment" Value="Center" />

                            </Style>

                        </ComboBox.ItemContainerStyle>

                    </ComboBox>



                    <!-- Khung xem trước thời gian địa phương -->

                    <TextBlock Text="{Binding [RtcPreviewLabel], Source={x:Static services:LocalizationService.Instance}}" 

                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />



                    <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">

                        <TextBlock Text="{Binding TargetPreviewTimeText}" 

                                   FontSize="13.5" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource PrimaryBrush}" />

                    </Border>

                </StackPanel>

            </Border>



            <!-- 3. Error Alert (nếu có lỗi giao tiếp) -->

            <Border Grid.Row="3" Background="{DynamicResource DangerLightBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12"

                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" />

            </Border>



            <!-- 4. Footer Actions (Sử dụng đúng Style BtnSecondary & BtnPrimary của Studio) -->

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="{Binding [BtnCancel], Source={x:Static services:LocalizationService.Instance}}"

                        Command="{Binding CancelCommand}"

                        Style="{StaticResource BtnSecondary}"

                        Padding="20,6" FontSize="12" FontWeight="SemiBold"

                        Margin="0,0,10,0" IsCancel="True" />



                <Button Content="{Binding [RtcBtnApply], Source={x:Static services:LocalizationService.Instance}}"

                        Command="{Binding SyncCommand}"

                        Style="{StaticResource BtnPrimary}"

                        Padding="24,6" FontSize="12" FontWeight="SemiBold"

                        IsDefault="True" />

            </StackPanel>

        </Grid>

    </Border>

</Window>

