<UserControl x:Class="SimplePLC.Studio.Views.BlueprintsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Smart Compatibility Filter -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding [BlueprintsTitle], Source={x:Static services:LocalizationService.Instance}}" 
                           FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding [BlueprintsDesc], Source={x:Static services:LocalizationService.Instance}}" 
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Hardware Filter Controls (Option A: Compact Dynamic Checkbox) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding FilterCompatibleOnly}" VerticalAlignment="Center" Cursor="Hand"
                          Content="{Binding FilterCheckboxText}"
                          ToolTip="{Binding FilterCheckboxToolTip}"
                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </DockPanel>

        <!-- Cards List with Smooth Scrolling -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <ItemsControl ItemsSource="{Binding FilteredBlueprints}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="6" Width="340" Margin="0,0,20,20" Padding="18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompatible}" Value="False">
                                            <Setter Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Badge & Icon -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Icon}" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeColor}" />
                                    </Border>
                                </DockPanel>

                                <!-- Title & Subtitle -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Medium" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" MinHeight="54" />

                                <!-- Tags Used Summary -->
                                <Border Grid.Row="3" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [BlueprintsUsedTags], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding TagsSummary}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Incompatible Warning Banner (Shown only when incompatible) -->
                                <Border Grid.Row="4" Margin="0,0,0,12"
                                        Background="{DynamicResource WarningLightBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompatible}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚠ " Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="Bold" />
                                        <TextBlock Text="{Binding IncompatibleReason}" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Apply Button -->
                                <Button Grid.Row="5" Content="{Binding [BlueprintsApplyBtn], Source={x:Static services:LocalizationService.Instance}}" 
                                        Command="{Binding DataContext.ApplyBlueprintCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsCompatible}"
                                        ToolTip="{Binding IncompatibleReason}"
                                        Style="{StaticResource BtnPrimary}"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,9" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
