<UserControl x:Class="SimplePLC.Studio.Views.LiveWatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services">

    <UserControl.Resources>
        <converters:TagQualityToBrushConverter x:Key="QualityBrushConverter" />
        <converters:BooleanQualityToStatusBrushConverter x:Key="BoolStatusBrushConverter" />
        <converters:TagQualityToOpacityConverter x:Key="QualityOpacityConverter" />
        
        <!-- Modern Flat DataGrid Column Header Styles -->
        <Style x:Key="ModernColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenteredColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,8" />
        </Style>

        <!-- Standard Industrial Cell Alignment & Typography Styles (Consistent 12.5pt) -->
        <Style x:Key="CenterCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="LeftCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="MonoCenterCellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="PinStarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- FULL-WIDTH BALANCED INDUSTRIAL LIVE WATCH WORKSPACE (TIA PORTAL / CODESYS STANDARD) -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <!-- 0. Compact Toolbar (Filter, Search, Online Status) -->
            <RowDefinition Height="Auto" />
            <!-- 1. Full-Screen Watch Table Card with Grounded Footer Strip -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. COMPACT INDUSTRIAL TOOLBAR -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <!-- Search Box -->
            <Border DockPanel.Dock="Left" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Width="240">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"
                             ToolTip="{Binding [LiveWatchSearchPrompt], Source={x:Static services:LocalizationService.Instance}}" />
                    <Button Grid.Column="2" Content="✕" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Background="Transparent" BorderThickness="0"
                            Padding="3,0" Cursor="Hand" Command="{Binding ClearSearchCommand}" ToolTip="Xóa tìm kiếm">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Filter Chips -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <!-- ⭐ WATCHLIST -->
                <Button Content="{Binding WatchlistButtonText}"
                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                        ToolTip="{Binding [FilterWatchlist], Source={x:Static services:LocalizationService.Instance}}"
                        Command="{Binding SetKindFilterCommand}" CommandParameter="WATCHLIST">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedKindFilter}" Value="WATCHLIST">
                                    <Setter Property="Background" Value="#D97706" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#D97706" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- ALL -->
                <Button Content="{Binding [FilterAll], Source={x:Static services:LocalizationService.Instance}}"
                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                        Command="{Binding SetKindFilterCommand}" CommandParameter="ALL">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedKindFilter}" Value="ALL">
                                    <Setter Property="Background" Value="#006487" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#006487" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- DI -->
                <Button Content="{Binding [FilterDI], Source={x:Static services:LocalizationService.Instance}}"
                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                        Command="{Binding SetKindFilterCommand}" CommandParameter="DI">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedKindFilter}" Value="DI">
                                    <Setter Property="Background" Value="#006487" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#006487" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- DO -->
                <Button Content="{Binding [FilterDO], Source={x:Static services:LocalizationService.Instance}}"
                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                        Command="{Binding SetKindFilterCommand}" CommandParameter="DO">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedKindFilter}" Value="DO">
                                    <Setter Property="Background" Value="#107C41" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#107C41" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- AI -->
                <Button Content="{Binding [FilterAI], Source={x:Static services:LocalizationService.Instance}}"
                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                        Command="{Binding SetKindFilterCommand}" CommandParameter="AI">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedKindFilter}" Value="AI">
                                    <Setter Property="Background" Value="#C05621" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#C05621" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- VFLAG -->
                <Button Content="{Binding [FilterVFlag], Source={x:Static services:LocalizationService.Instance}}"
                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                        Command="{Binding SetKindFilterCommand}" CommandParameter="VFLAG">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedKindFilter}" Value="VFLAG">
                                    <Setter Property="Background" Value="#4F46E5" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#4F46E5" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- VREG -->
                <Button Content="{Binding [FilterVReg], Source={x:Static services:LocalizationService.Instance}}"
                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                        Command="{Binding SetKindFilterCommand}" CommandParameter="VREG">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedKindFilter}" Value="VREG">
                                    <Setter Property="Background" Value="#0891B2" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#0891B2" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- RETAIN -->
                <Button Content="{Binding [FilterRetain], Source={x:Static services:LocalizationService.Instance}}"
                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                        Command="{Binding SetKindFilterCommand}" CommandParameter="RETAIN">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedKindFilter}" Value="RETAIN">
                                    <Setter Property="Background" Value="#9333EA" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#9333EA" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- COUNTER -->
                <Button Content="{Binding [FilterCounter], Source={x:Static services:LocalizationService.Instance}}"
                        Padding="12,6" Margin="0,0,8,0" FontSize="11.5"
                        Command="{Binding SetKindFilterCommand}" CommandParameter="COUNTER">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedKindFilter}" Value="COUNTER">
                                    <Setter Property="Background" Value="#0D9488" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#0D9488" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Right Status Strip: Mode Switcher, Commissioning Controls & Status Badges -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 1. Mode Button: [⚡ Bật chế độ Debug] or [🔒 Dừng Debug] -->
                <Button Margin="0,0,10,0" Padding="10,4" FontSize="11.5" FontWeight="Bold"
                        IsEnabled="{Binding IsConnected}"
                        Command="{Binding ToggleManualModeCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Setter Property="Content" Value="{Binding [LiveWatchBtnEnterManual], Source={x:Static services:LocalizationService.Instance}}" />
                            <Setter Property="Background" Value="#FEF3C7" />
                            <Setter Property="Foreground" Value="#C05621" />
                            <Setter Property="BorderBrush" Value="#C05621" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsManualModeActive}" Value="True">
                                    <Setter Property="Content" Value="{Binding [LiveWatchBtnExitManual], Source={x:Static services:LocalizationService.Instance}}" />
                                    <Setter Property="Background" Value="#B91C1C" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#B91C1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Online / Offline Badge -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,4" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                                            <Setter Property="Fill" Value="#107C41" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Timing & Cycle -->
                <TextBlock Text="{Binding LastSuccessfulPollText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding [LiveWatchCycle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="3,0,4,0" />
            </StackPanel>
        </DockPanel>

        <!-- 1. FULL-WIDTH LIVE WATCH TABLE CARD CONTAINER -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Table Body -->
                    <RowDefinition Height="*" />
                    <!-- Retain Dirty Action Banner -->
                    <RowDefinition Height="Auto" />
                    <!-- Grounded Industrial Footer Status Strip -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Table Body -->
                <DataGrid Grid.Row="0" ItemsSource="{Binding FilteredTags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          Background="White" BorderThickness="0" RowHeight="38" AlternatingRowBackground="#FAFAFA"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          TextOptions.TextFormattingMode="Display"
                          TextOptions.TextRenderingMode="ClearType"
                          RenderOptions.ClearTypeHint="Enabled">

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding [LiveWatchClearWatchlist], Source={x:Static services:LocalizationService.Instance}}"
                                      Command="{Binding ClearWatchlistCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding [LiveWatchPinTag], Source={x:Static services:LocalizationService.Instance}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Header" Value="{Binding [LiveWatchUnpinTag], Source={x:Static services:LocalizationService.Instance}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{Binding [LiveWatchClearWatchlist], Source={x:Static services:LocalizationService.Instance}}"
                                                  Command="{Binding DataContext.ClearWatchlistCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- 0. Pin / Watchlist Star Column (Centered, 38px) -->
                        <DataGridTemplateColumn Width="38" CanUserResize="False"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="⭐" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Ghim / Watchlist" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PinStarButtonStyle}">
                                        <TextBlock FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="☆" />
                                                    <Setter Property="Foreground" Value="#CBD5E1" />
                                                    <Setter Property="ToolTip" Value="{Binding [LiveWatchPinTag], Source={x:Static services:LocalizationService.Instance}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Text" Value="★" />
                                                            <Setter Property="Foreground" Value="#D97706" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="ToolTip" Value="{Binding [LiveWatchUnpinTag], Source={x:Static services:LocalizationService.Instance}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 1. Index (Centered, 55px) -->
                        <DataGridTextColumn Header="{Binding [ColLiveIndex], Source={x:Static services:LocalizationService.Instance}}"
                                            Binding="{Binding Index}" Width="55"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            ElementStyle="{StaticResource CenterCellText}" />

                        <!-- 2. Tag Name (Left-aligned, 1.2*) -->
                        <DataGridTemplateColumn Header="{Binding [ColLiveTagName], Source={x:Static services:LocalizationService.Instance}}" Width="1.2*" MinWidth="100"
                                                HeaderStyle="{StaticResource ModernColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                     <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Localized Alias / Description (Left-aligned, 2.2*) -->
                        <DataGridTemplateColumn Header="{Binding [ColLiveDescription], Source={x:Static services:LocalizationService.Instance}}" Width="2.2*" MinWidth="180"
                                                HeaderStyle="{StaticResource ModernColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LocalizedAlias}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Modbus Register Address (Centered, 1.4*) -->
                        <DataGridTemplateColumn Header="{Binding [ColLiveModbus], Source={x:Static services:LocalizationService.Instance}}" Width="1.4*" MinWidth="120"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModbusAddressHex}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" FontWeight="SemiBold" Foreground="#006487" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5. Data Type (Centered, 1.1*) -->
                        <DataGridTemplateColumn Header="{Binding [ColLiveDataType], Source={x:Static services:LocalizationService.Instance}}" Width="1.1*" MinWidth="90"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataTypeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 6. Kind / Category (Centered, 1.1*) -->
                        <DataGridTemplateColumn Header="{Binding [ColLiveCategory], Source={x:Static services:LocalizationService.Instance}}" Width="1.1*" MinWidth="90"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KindText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 7. Live Value (Centered, 1.6*) -->
                        <DataGridTemplateColumn Header="{Binding [ColLiveValue], Source={x:Static services:LocalizationService.Instance}}" Width="1.6*" MinWidth="135"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Opacity="{Binding Quality, Converter={StaticResource QualityOpacityConverter}}">
                                        <!-- Boolean LED Indicator -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding BooleanDisplayValue}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource BoolStatusBrushConverter}">
                                                        <Binding Path="IsOn" />
                                                        <Binding Path="Quality" />
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Numeric / Analog Value -->
                                        <TextBlock Text="{Binding FormattedValue}" FontWeight="SemiBold" FontSize="12.5" Foreground="#006487" FontFamily="Consolas, Cascadia Code, Courier New" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBoolean}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 8. Raw (Hex/Debug) (Centered, 1.4*) -->
                        <DataGridTextColumn Header="{Binding [ColLiveRaw], Source={x:Static services:LocalizationService.Instance}}"
                                            Binding="{Binding RawHexText}" Width="1.4*" MinWidth="120"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            ElementStyle="{StaticResource MonoCenterCellText}"
                                            Foreground="#64748B" />

                        <!-- 9. Quality Badge (Centered, 1.2*) -->
                        <DataGridTemplateColumn Header="{Binding [ColLiveQuality], Source={x:Static services:LocalizationService.Instance}}" Width="1.2*" MinWidth="110"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding Quality, Converter={StaticResource QualityBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding QualityText}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Quality, Converter={StaticResource QualityBrushConverter}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 10. Last Updated Timestamp (Centered, 1.5*) -->
                        <DataGridTextColumn Header="{Binding [ColLiveLastTime], Source={x:Static services:LocalizationService.Instance}}"
                                            Binding="{Binding LastUpdatedText}" Width="1.5*" MinWidth="130"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            ElementStyle="{StaticResource CenterCellText}"
                                            Foreground="{StaticResource TextMutedBrush}" />

                        <!-- 11. Manual Control / Force Column (Centered, 2.0*) -->
                        <DataGridTemplateColumn Header="{Binding [ColLiveManualControl], Source={x:Static services:LocalizationService.Instance}}" Width="2.0*" MinWidth="175"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Read-Only Indicator for Non-Forceable tags (DI, AI, Reserved) -->
                                        <TextBlock Text="--" FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsForceable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Boolean Force Controls (DO, VFLAG) -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsForceable}" Value="True" />
                                                                <Condition Binding="{Binding IsBoolean}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <!-- Button [1 / ON] -->
                                            <Button Content="{Binding [LiveWatchBtnOn], Source={x:Static services:LocalizationService.Instance}}"
                                                    Padding="8,2" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold"
                                                    IsEnabled="{Binding DataContext.IsManualModeActive, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    Command="{Binding DataContext.ForceTagBooleanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsManualModeActive, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                                                                    <Condition Binding="{Binding Quality}" Value="Good" />
                                                                    <Condition Binding="{Binding IsOn}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="#107C41" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="BorderBrush" Value="#107C41" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Button [0 / OFF] -->
                                            <Button Content="{Binding [LiveWatchBtnOff], Source={x:Static services:LocalizationService.Instance}}"
                                                    Padding="8,2" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold"
                                                    IsEnabled="{Binding DataContext.IsManualModeActive, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    Command="{Binding DataContext.ForceTagBooleanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsManualModeActive, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                                                                    <Condition Binding="{Binding Quality}" Value="Good" />
                                                                    <Condition Binding="{Binding IsOn}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="#475569" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="BorderBrush" Value="#475569" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Button [✕ Nhả] -->
                                            <Button Content="✕" FontSize="10" Padding="5,2" ToolTip="{Binding [LiveWatchBtnRelease], Source={x:Static services:LocalizationService.Instance}}"
                                                    IsEnabled="{Binding DataContext.IsManualModeActive, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    Command="{Binding DataContext.ReleaseTagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsForced}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>

                                        <!-- Numeric / Analog Force Controls (VREG, VREG_RETAIN, COUNTER) -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsForceable}" Value="True" />
                                                                <Condition Binding="{Binding IsBoolean}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBox Text="{Binding ManualInputValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="65" Height="24" FontSize="11" FontFamily="Consolas" VerticalContentAlignment="Center"
                                                     Padding="4,0" Margin="0,0,4,0"
                                                     IsEnabled="{Binding DataContext.IsManualModeActive, RelativeSource={RelativeSource AncestorType=DataGrid}}" />

                                            <Button Content="{Binding [LiveWatchBtnSet], Source={x:Static services:LocalizationService.Instance}}"
                                                    Padding="6,2" Height="24" FontSize="10.5" Margin="0,0,4,0"
                                                    IsEnabled="{Binding DataContext.IsManualModeActive, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    Command="{Binding DataContext.ForceTagValueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnSecondary}" />

                                            <Button Content="✕" FontSize="10" Padding="5,2" Height="24"
                                                    ToolTip="{Binding [LiveWatchBtnRelease], Source={x:Static services:LocalizationService.Instance}}"
                                                    IsEnabled="{Binding DataContext.IsManualModeActive, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    Command="{Binding DataContext.ReleaseTagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsForced}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty Watchlist Placeholder Overlay -->
                <Border Grid.Row="0" Background="#FAFAFA" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="32,24" Margin="24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedKindFilter}" Value="WATCHLIST" />
                                        <Condition Binding="{Binding FilteredTags.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⭐" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="#D97706" />
                        <TextBlock Text="{Binding [FilterWatchlist], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding [LiveWatchEmptyWatchlist], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Retain Dirty Action Banner -->
                <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="14,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRetainDirty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [LiveWatchRetainDirtyNotice], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{Binding [LiveWatchBtnCommitRetain], Source={x:Static services:LocalizationService.Instance}}"
                                    Padding="10,4" Margin="0,0,8,0" FontSize="11" FontWeight="Bold"
                                    Background="#107C41" Foreground="White" BorderBrush="#107C41"
                                    Command="{Binding CommitRetainCommand}" Style="{StaticResource BtnSecondary}" />
                            <Button Content="{Binding [LiveWatchBtnDiscardRetain], Source={x:Static services:LocalizationService.Instance}}"
                                    Padding="10,4" FontSize="11" FontWeight="SemiBold"
                                    Background="White" Foreground="#B91C1C" BorderBrush="#B91C1C"
                                    Command="{Binding DiscardRetainCommand}" Style="{StaticResource BtnSecondary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Grounded Industrial Footer Status Strip -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="14,8" CornerRadius="0,0,2,2">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FooterSummaryText}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="SynaptiX Industrial Live Watch" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
