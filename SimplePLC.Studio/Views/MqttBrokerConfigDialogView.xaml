<Window x:Class="SimplePLC.Studio.Views.MqttBrokerConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
        xmlns:viewmodels="clr-namespace:SimplePLC.Studio.ViewModels"
        xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
        Title="{Binding [MqttBrokerDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="680"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ResizeMode="CanResizeWithGrip"
        controls:WindowChromeHelper.EnableIndependentMinimize="True"
        ShowInTaskbar="True"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{DynamicResource BgWindowBrush}"
        Icon="../Assets/app.png"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1">
        <Grid Margin="16,14">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Cards (Reusable Control) -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Action -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                        BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconIecCommunication}" 
                          Stroke="{DynamicResource PrimaryBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [MqttBrokerDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding [MqttBrokerDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 1. Content Body: Reusable MqttBrokerConfigControl -->
            <controls:MqttBrokerConfigControl Grid.Row="1" Margin="0,0,0,10" DataContext="{Binding}" />

            <!-- 2. Footer Action Buttons -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding [MqttBrokerCancelBtn], Source={x:Static services:LocalizationService.Instance}}"
                            Command="{Binding CancelCommand}"
                            Padding="18,5" FontSize="12" FontWeight="SemiBold"
                            Style="{StaticResource BtnSecondary}"
                            Margin="0,0,10,0" IsCancel="True" />

                    <Button Content="{Binding [MqttBrokerSaveBtn], Source={x:Static services:LocalizationService.Instance}}"
                            Command="{Binding SaveCommand}"
                            Padding="22,5" FontSize="12" FontWeight="SemiBold"
                            Style="{StaticResource BtnPrimary}"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
