<Window x:Class="SimplePLC.Studio.Views.WifiConfigDialogView"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:services="clr-namespace:SimplePLC.Studio.Services"

        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"

        Title="{Binding [WifiDialogTitle], Source={x:Static services:LocalizationService.Instance}}"

        Width="660" Height="610"

        MinWidth="600" MinHeight="500"

        WindowStartupLocation="CenterOwner"

        ResizeMode="CanResizeWithGrip"

        controls:WindowChromeHelper.EnableIndependentMinimize="True"

        ShowInTaskbar="True"

        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"

        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"

        Background="#F8FAFC"

        Icon="../Assets/app.png"

        FontFamily="Segoe UI"

        TextOptions.TextFormattingMode="Display"

        TextOptions.TextRenderingMode="ClearType"

        RenderOptions.ClearTypeHint="Enabled">



    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="../Styles/Colors.xaml" />

                <ResourceDictionary Source="../Styles/Controls.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

        </ResourceDictionary>

    </Window.Resources>



    <Border BorderBrush="#CBD5E1" BorderThickness="1">

        <Grid Margin="18,14">

            <Grid.RowDefinitions>

                <!-- 0. Header -->

                <RowDefinition Height="Auto" />

                <!-- 1. Content Form -->

                <RowDefinition Height="*" />

                <!-- 2. Footer Action -->

                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>



            <!-- 0. Header -->

            <Grid Grid.Row="0" Margin="0,0,0,10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <Border Grid.Column="0" Width="38" Height="38" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">

                    <TextBlock Text="📶" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />

                </Border>



                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                    <TextBlock Text="{Binding [WifiDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 

                               FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Text="{Binding [WifiDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 

                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />

                </StackPanel>

            </Grid>



            <!-- 1. Unified Content Form -->

            <StackPanel Grid.Row="1">



                <!-- CARD 1: Trạng thái kết nối hiện tại (Current Status) -->

                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">

                    <StackPanel>

                        <!-- Top status row -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>



                            <TextBlock Grid.Column="0" Text="{Binding [WifiSectionLive], Source={x:Static services:LocalizationService.Instance}}"

                                       FontSize="11.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />



                            <!-- Status Pill -->

                            <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="3" Padding="8,3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">

                                <StackPanel Orientation="Horizontal">

                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">

                                        <Ellipse.Style>

                                            <Style TargetType="Ellipse">

                                                <Setter Property="Fill" Value="#64748B" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="3">

                                                        <Setter Property="Fill" Value="#107C41" />

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="2">

                                                        <Setter Property="Fill" Value="#0284C7" />

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="1">

                                                        <Setter Property="Fill" Value="#D97706" />

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="4">

                                                        <Setter Property="Fill" Value="#DC2626" />

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="5">

                                                        <Setter Property="Fill" Value="#DC2626" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Ellipse.Style>

                                    </Ellipse>

                                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" />

                                </StackPanel>

                            </Border>



                            <!-- Connect / Disconnect Action Buttons -->

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                <Button Content="{Binding [WifiBtnConnect], Source={x:Static services:LocalizationService.Instance}}"

                                        Command="{Binding ConnectCommand}"

                                        IsEnabled="{Binding IsDeviceConnected}"

                                        Padding="12,3" FontSize="11" Margin="0,0,6,0" Style="{StaticResource BtnSecondary}" />

                                <Button Content="{Binding [WifiBtnDisconnect], Source={x:Static services:LocalizationService.Instance}}"

                                        Command="{Binding DisconnectCommand}"

                                        IsEnabled="{Binding IsDeviceConnected}"

                                        Padding="12,3" FontSize="11" Style="{StaticResource BtnSecondary}" />

                            </StackPanel>

                        </Grid>



                        <!-- Sub-row: Telemetry parameters (IP, RSSI, MAC) -->

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,6">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="1.2*" />

                                    <ColumnDefinition Width="14" />

                                    <ColumnDefinition Width="1.4*" />

                                    <ColumnDefinition Width="14" />

                                    <ColumnDefinition Width="1.3*" />

                                </Grid.ColumnDefinitions>



                                <!-- IP -->

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="{Binding [WifiCurrentIpLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,1" />

                                    <TextBlock Text="{Binding CurrentIp}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />

                                </StackPanel>



                                <!-- RSSI -->

                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="{Binding [WifiRssiLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,1" />

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <TextBlock Text="{Binding RssiDbm, StringFormat={}{0} dBm}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,6,0" />

                                        <ProgressBar Width="55" Height="7" Minimum="0" Maximum="100" Value="{Binding SignalQualityPercent}" VerticalAlignment="Center" />

                                    </StackPanel>

                                </StackPanel>



                                <!-- MAC -->

                                <StackPanel Grid.Column="4">

                                    <TextBlock Text="{Binding [WifiMacLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,1" />

                                    <TextBlock Text="{Binding MacAddress}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" />

                                </StackPanel>

                            </Grid>

                        </Border>

                    </StackPanel>

                </Border>



                <!-- CARD 2: Chọn mạng Wi-Fi & Xác thực (Network Selection & Credentials) -->

                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">

                    <StackPanel>

                        <!-- Enable and Auto-reconnect checkboxes -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="28" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Content="{Binding [WifiEnabledLabel], Source={x:Static services:LocalizationService.Instance}}"

                                      FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />

                            <CheckBox Grid.Column="2" IsChecked="{Binding AutoReconnect}" Content="{Binding [WifiAutoReconnectLabel], Source={x:Static services:LocalizationService.Instance}}"

                                      Foreground="#334155" VerticalAlignment="Center" />

                        </Grid>



                        <!-- SSID & Scan button row -->

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="8" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>



                            <StackPanel Grid.Column="0">

                                <TextBlock Text="{Binding [WifiSsidLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />

                                <TextBox Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}" 

                                         Padding="7,5" FontSize="12" BorderBrush="#CBD5E1" />

                            </StackPanel>



                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">

                                <Button Content="{Binding [WifiBtnScan], Source={x:Static services:LocalizationService.Instance}}"

                                        Command="{Binding ScanCommand}"

                                        IsEnabled="{Binding IsDeviceConnected}"

                                        Style="{StaticResource BtnSecondary}" Padding="12,5" FontSize="11.5" />

                            </StackPanel>

                        </Grid>



                        <!-- Nearby Networks Table (Compact & Clickable) -->

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Height="105" Margin="0,0,0,8">

                            <Grid>

                                <DataGrid ItemsSource="{Binding AvailableAps}"

                                          SelectedItem="{Binding SelectedAp}"

                                          AutoGenerateColumns="False"

                                          IsReadOnly="True"

                                          HeadersVisibility="Column"

                                          GridLinesVisibility="Horizontal"

                                          RowHeight="24"

                                          Background="#FFFFFF"

                                          FontSize="10.5"

                                          SelectionMode="Single"

                                          MouseDoubleClick="DataGrid_MouseDoubleClick">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="2.5*" />

                                        <DataGridTextColumn Header="RSSI" Binding="{Binding RssiDbm, StringFormat={}{0} dBm}" Width="1.2*" />

                                        <DataGridTextColumn Header="CH" Binding="{Binding Channel}" Width="0.6*" />

                                        <DataGridTextColumn Header="Security" Binding="{Binding AuthModeDisplay}" Width="1.4*" />

                                    </DataGrid.Columns>

                                </DataGrid>



                                <!-- Empty placeholder text -->

                                <TextBlock Text="{Binding [WifiScanEmptyHelp], Source={x:Static services:LocalizationService.Instance}}"

                                           FontSize="10.5" Foreground="#94A3B8" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"

                                           IsHitTestVisible="False">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding AvailableAps.Count}" Value="0">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Border>



                        <!-- Password input row with Show/Hide toggle -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="14" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>



                            <StackPanel Grid.Column="0">

                                <TextBlock Text="{Binding [WifiPasswordLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />

                                <Grid>

                                    <TextBox x:Name="PasswordTextBox" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 

                                             Padding="7,5" FontSize="12" BorderBrush="#CBD5E1"

                                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />

                                    <PasswordBox x:Name="PasswordBoxControl" PasswordChar="●"

                                                 Padding="7,5" FontSize="12" BorderBrush="#CBD5E1"

                                                 PasswordChanged="PasswordBoxControl_PasswordChanged">

                                        <PasswordBox.Style>

                                            <Style TargetType="PasswordBox">

                                                <Setter Property="Visibility" Value="Visible" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">

                                                        <Setter Property="Visibility" Value="Collapsed" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </PasswordBox.Style>

                                    </PasswordBox>

                                </Grid>

                            </StackPanel>



                            <CheckBox Grid.Column="2" IsChecked="{Binding IsPasswordVisible}" 

                                      Content="{Binding [WifiShowPassword], Source={x:Static services:LocalizationService.Instance}}"

                                      FontSize="10.5" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,6" />

                        </Grid>

                    </StackPanel>

                </Border>



                <!-- CARD 3: Cấu hình giao thức IP (IP Protocol Configuration) -->

                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10">

                    <StackPanel>

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="14" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding [WifiSectionIp], Source={x:Static services:LocalizationService.Instance}}"

                                       FontSize="11.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />

                            <CheckBox Grid.Column="2" IsChecked="{Binding IsDhcp}" 

                                      Content="{Binding [WifiDhcpHelp], Source={x:Static services:LocalizationService.Instance}}"

                                      FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />

                        </Grid>



                        <!-- Static IP Settings (when IsDhcp is false) -->

                        <StackPanel>

                            <StackPanel.Style>

                                <Style TargetType="StackPanel">

                                    <Setter Property="IsEnabled" Value="True" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsDhcp}" Value="True">

                                            <Setter Property="IsEnabled" Value="False" />

                                            <Setter Property="Opacity" Value="0.4" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </StackPanel.Style>



                            <Grid Margin="0,0,0,4">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="10" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="10" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="10" />

                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>



                                <!-- Static IP -->

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="{Binding [WifiStaticIpLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,1" />

                                    <TextBox Text="{Binding StaticIp, UpdateSourceTrigger=PropertyChanged}" 

                                             Padding="6,4" FontSize="11" BorderBrush="#CBD5E1" />

                                </StackPanel>



                                <!-- Subnet -->

                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="{Binding [WifiSubnetLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,1" />

                                    <TextBox Text="{Binding StaticSubnet, UpdateSourceTrigger=PropertyChanged}" 

                                             Padding="6,4" FontSize="11" BorderBrush="#CBD5E1" />

                                </StackPanel>



                                <!-- Gateway -->

                                <StackPanel Grid.Column="4">

                                    <TextBlock Text="{Binding [WifiGatewayLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,1" />

                                    <TextBox Text="{Binding StaticGateway, UpdateSourceTrigger=PropertyChanged}" 

                                             Padding="6,4" FontSize="11" BorderBrush="#CBD5E1" />

                                </StackPanel>



                                <!-- DNS -->

                                <StackPanel Grid.Column="6">

                                    <TextBlock Text="{Binding [WifiDnsLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,1" />

                                    <TextBox Text="{Binding StaticDns, UpdateSourceTrigger=PropertyChanged}" 

                                             Padding="6,4" FontSize="11" BorderBrush="#CBD5E1" />

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>



            <!-- 2. Footer Action -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="8" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>



                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="11.5" FontWeight="SemiBold"

                           VerticalAlignment="Center" TextWrapping="Wrap" />



                <Button Grid.Column="1" Content="{Binding [WifiBtnCancel], Source={x:Static services:LocalizationService.Instance}}" 

                        Command="{Binding CancelCommand}"

                        Padding="18,6" FontSize="12" Style="{StaticResource BtnSecondary}" />



                <Button Grid.Column="3" Content="{Binding [WifiBtnApply], Source={x:Static services:LocalizationService.Instance}}" 

                        Command="{Binding SaveCommand}"

                        Padding="18,6" FontSize="12" Style="{StaticResource BtnPrimary}" />

            </Grid>

        </Grid>

    </Border>

</Window>

