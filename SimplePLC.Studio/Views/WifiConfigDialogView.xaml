<Window x:Class="SimplePLC.Studio.Views.WifiConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
        Title="{Binding [WifiDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="660" Height="610"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        controls:WindowChromeHelper.EnableIndependentMinimize="True"
        ShowInTaskbar="True"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{DynamicResource BgWindowBrush}"
        Icon="../Assets/app.png"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1">
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Form -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Action -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" Background="{DynamicResource IndustrialBorderSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysWifi}" 
                          Stroke="{DynamicResource IndustrialPrimaryBrush}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [WifiDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding [WifiDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 1. Reusable Wi-Fi Control Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <controls:WifiConfigControl DataContext="{Binding}" />
            </ScrollViewer>

            <!-- 2. Footer Action -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" />

                <Button Grid.Column="1" Content="{Binding [WifiBtnCancel], Source={x:Static services:LocalizationService.Instance}}" 
                        Command="{Binding CancelCommand}"
                        Padding="18,6" FontSize="12" Style="{StaticResource BtnSecondary}" />

                <Button Grid.Column="3" Content="{Binding [WifiBtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                        Command="{Binding SaveCommand}"
                        Padding="18,6" FontSize="12" Style="{StaticResource BtnPrimary}" />
            </Grid>
        </Grid>
    </Border>
</Window>
