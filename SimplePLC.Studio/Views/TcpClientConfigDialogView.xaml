<Window x:Class="SimplePLC.Studio.Views.TcpClientConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [TcpClientConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="1020" Height="690"
        MinWidth="900" MinHeight="580"
        ResizeMode="CanResizeWithGrip"
        controls:WindowChromeHelper.EnableIndependentMinimize="True"
        Icon="../Assets/app.png"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Loaded="Window_Loaded"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Industrial Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Two-Column Master-Detail Body -->
            <RowDefinition Height="*" />
            <!-- Row 2: Action Footer Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER BANNER -->
        <Border Grid.Row="0" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Width="38" Height="38" Margin="0,0,14,0">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconIecTcpClient}" Stroke="{DynamicResource PrimaryBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [TcpClientConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding [TcpClientConfigDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: TWO-COLUMN MASTER-DETAIL BODY (REUSABLE INDUSTRIAL CONTROL) -->
        <controls:TcpClientConfigControl Grid.Row="1" Margin="20,16,20,12" />

        <!-- ROW 2: ACTION FOOTER BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="True">
                <Button Content="{Binding [BtnRestoreDefaults], Source={x:Static services:LocalizationService.Instance}}" 
                        ToolTip="{Binding [BtnRestoreDefaultsTip], Source={x:Static services:LocalizationService.Instance}}"
                        Command="{Binding ResetDefaultsCommand}" 
                        DockPanel.Dock="Left" 
                        Padding="14,6" Height="30" 
                        Style="{StaticResource TiaTactileBtnStyle}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding [BtnCancel], Source={x:Static services:LocalizationService.Instance}}" 
                            ToolTip="{Binding [BtnCancelTip], Source={x:Static services:LocalizationService.Instance}}"
                            Click="Cancel_Click" 
                            IsCancel="True" 
                            Padding="18,6" Height="30" Margin="0,0,10,0" 
                            Style="{StaticResource TiaTactileBtnStyle}" />

                    <Button Content="{Binding [BtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            ToolTip="{Binding [BtnApplyTip], Source={x:Static services:LocalizationService.Instance}}"
                            Click="Apply_Click" 
                            IsDefault="True" 
                            Padding="22,6" Height="30" 
                            Style="{StaticResource BtnPrimary}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
