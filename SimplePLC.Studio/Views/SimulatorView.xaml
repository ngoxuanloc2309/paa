<UserControl x:Class="SimplePLC.Studio.Views.SimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,0,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [SimTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Background="#E6F4EA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock Text="Scan Cycle: 10ms · Fidelity Engine" FontSize="11" FontWeight="SemiBold" Foreground="#107C41" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding [SimDesc], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Engine Controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ScanNumber, StringFormat='⚡ Scan #{0}'}" FontWeight="Bold" FontSize="12" Foreground="#006487" />
                    </Border>
                    <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="0,0,8,0">
                        <TextBlock Text="{Binding SimClock, StringFormat='🕒 {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding [SimBarStep], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding StepScanCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" />
                        <Button Content="{Binding [SimBarPause], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ToggleEngineCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" />
                        <Button Content="＋1s" Command="{Binding AdvanceClockCommand}" Style="{StaticResource BtnSecondary}" ToolTip="Tiến đồng hồ mô phỏng 1 giây" Margin="0,0,6,0" />
                        <Button Content="{Binding [SimBarReset], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ResetRuntimeCommand}" Style="{StaticResource BtnSecondary}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace (Left Controls, Right Logs/Trace) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: I/O Hardware Board -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <!-- Digital Inputs (DI0..7) -->
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding [SimHardwareDIHeader], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                            <WrapPanel>
                                <Button Command="{Binding ToggleDICommand}" CommandParameter="{Binding TagCatalog.AllTags[1]}" Style="{StaticResource BtnSecondary}" Margin="3" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DI0 (Máy chạy): " FontSize="12" />
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[1].Value}" Value="1">
                                                            <Setter Property="Text" Value="ON" />
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ToggleDICommand}" CommandParameter="{Binding TagCatalog.AllTags[2]}" Style="{StaticResource BtnSecondary}" Margin="3" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DI1 (Nút gọi): " FontSize="12" />
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[2].Value}" Value="1">
                                                            <Setter Property="Text" Value="ON" />
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ToggleDICommand}" CommandParameter="{Binding TagCatalog.AllTags[3]}" Style="{StaticResource BtnSecondary}" Margin="3" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DI2 (Line 1): " FontSize="12" />
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[3].Value}" Value="1">
                                                            <Setter Property="Text" Value="ON" />
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ToggleDICommand}" CommandParameter="{Binding TagCatalog.AllTags[4]}" Style="{StaticResource BtnSecondary}" Margin="3" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DI3 (Line 2): " FontSize="12" />
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[4].Value}" Value="1">
                                                            <Setter Property="Text" Value="ON" />
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ToggleDICommand}" CommandParameter="{Binding TagCatalog.AllTags[5]}" Style="{StaticResource BtnSecondary}" Margin="3" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DI4 (Dừng khẩn): " FontSize="12" />
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[5].Value}" Value="1">
                                                            <Setter Property="Text" Value="ON" />
                                                            <Setter Property="Foreground" Value="#B91C1C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- S3: DI5 — Cảm biến an toàn (AllTags[6]) -->
                                <Button Command="{Binding ToggleDICommand}" CommandParameter="{Binding TagCatalog.AllTags[6]}" Style="{StaticResource BtnSecondary}" Margin="3" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DI5 (Cảm biến AT): " FontSize="12" />
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[6].Value}" Value="1">
                                                            <Setter Property="Text" Value="ON" />
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- S3: DI6 — Cửa bảo vệ (AllTags[7]) -->
                                <Button Command="{Binding ToggleDICommand}" CommandParameter="{Binding TagCatalog.AllTags[7]}" Style="{StaticResource BtnSecondary}" Margin="3" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DI6 (Cửa bảo vệ): " FontSize="12" />
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[7].Value}" Value="1">
                                                            <Setter Property="Text" Value="ON" />
                                                            <Setter Property="Foreground" Value="#C05621" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- S3: DI7 — Nút Reset (AllTags[8]) -->
                                <Button Command="{Binding ToggleDICommand}" CommandParameter="{Binding TagCatalog.AllTags[8]}" Style="{StaticResource BtnSecondary}" Margin="3" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DI7 (Nút Reset): " FontSize="12" />
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[8].Value}" Value="1">
                                                            <Setter Property="Text" Value="ON" />
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Analog Inputs (AI0..3) -->
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding [SimHardwareAIHeader], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                            
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AI0 (Áp suất dầu):" FontSize="12" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TagCatalog.AllTags[17].Value}" TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TagCatalog.AllTags[17].Value}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AI1 (Nhiệt độ bể):" FontSize="12" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TagCatalog.AllTags[18].Value}" TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TagCatalog.AllTags[18].Value}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- S4: AI2 — Tần số cấp liệu (AllTags[19]) -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AI2 (Tần số CL):" FontSize="12" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TagCatalog.AllTags[19].Value}" TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TagCatalog.AllTags[19].Value}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- S4: AI3 — Dòng pha A (AllTags[20]) -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AI3 (Dòng pha A):" FontSize="12" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TagCatalog.AllTags[20].Value}" TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TagCatalog.AllTags[20].Value}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Digital Outputs (DO0..7) -->
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding [SimHardwareDOHeader], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                            <WrapPanel>
                                <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[9].Value}" Value="1">
                                                            <Setter Property="Background" Value="#B91C1C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="DO0: Đèn đỏ" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[10].Value}" Value="1">
                                                            <Setter Property="Background" Value="#C05621" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="DO1: Đèn vàng" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[11].Value}" Value="1">
                                                            <Setter Property="Background" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="DO2: Đèn xanh" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[12].Value}" Value="1">
                                                            <Setter Property="Background" Value="#B91C1C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="DO3: Còi báo" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>

                                <!-- S5: DO4 — Băng tải 1 (AllTags[13]) -->
                                <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[13].Value}" Value="1">
                                                            <Setter Property="Background" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="DO4: Băng tải 1" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>

                                <!-- S5: DO5 — Băng tải 2 (AllTags[14]) -->
                                <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[14].Value}" Value="1">
                                                            <Setter Property="Background" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="DO5: Băng tải 2" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>

                                <!-- S5: DO6 — Van cấp liệu (AllTags[15]) -->
                                <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[15].Value}" Value="1">
                                                            <Setter Property="Background" Value="#C05621" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="DO6: Van cấp liệu" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>

                                <!-- S5: DO7 — Relay nguồn (AllTags[16]) -->
                                <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCatalog.AllTags[16].Value}" Value="1">
                                                            <Setter Property="Background" Value="#006487" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="DO7: Relay nguồn" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Retain Counters -->
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding [SimHardwareCounterHeader], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Counter1 (Line 1)" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding TagCatalog.AllTags[85].Value}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="#006487" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10" Margin="2,0">
                                    <StackPanel>
                                        <TextBlock Text="Counter2 (Line 2)" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding TagCatalog.AllTags[86].Value}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="#006487" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#E6F4EA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [SimTotalOutput], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#107C41" />
                                        <TextBlock Text="{Binding TagCatalog.AllTags[87].Value}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="#107C41" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: Tabbed Inspection (Live Rule Status & Execution Trace) -->
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2">
                <TabControl Background="White" BorderThickness="0" Margin="8">
                    <!-- Tab 1: Live Rule Status Cards -->
                    <TabItem Header="{Binding [SimTabRuleState], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="12">
                        <DockPanel Margin="6">
                            <!-- Top Info & Filter -->
                            <Border DockPanel.Dock="Top" Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Trực quan hóa trạng thái MCU Rule Engine theo chu kỳ quét hiện tại." FontSize="11.5" Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RuleStatusList.Count, StringFormat='Tổng {0} rules'}" FontWeight="Bold" FontSize="11.5" Foreground="#006487" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Rule Cards List (Virtualized) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                <ItemsControl ItemsSource="{Binding RuleStatusList}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="0" Background="#DFE3E8" CornerRadius="2" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11" Foreground="#006487" />
                                                    </Border>

                                                    <!-- Rule Details -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding RuleIndex, StringFormat='Rule #{0}: '}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
                                                            <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TriggerSummary}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding GuardSummary, StringFormat='Guard: {0}'}" FontSize="11" Foreground="#94A3B8" />
                                                    </StackPanel>

                                                    <!-- Action Delta Output -->
                                                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ActionDelta.FormattedDelta, FallbackValue='—', TargetNullValue='—'}" FontWeight="Bold" FontFamily="Consolas" FontSize="12" Foreground="#107C41" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Tab 2: Execution Trace Log -->
                    <TabItem Header="{Binding [SimTabTrace], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="12">
                        <DockPanel Margin="6">
                            <Border DockPanel.Dock="Top" Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                                <DockPanel>
                                    <CheckBox Content="{Binding [SimTraceFilterTip], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding FilterActiveOnly}" VerticalAlignment="Center" FontWeight="Medium" FontSize="11.5" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding [SimTraceOrderTip], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <ListBox ItemsSource="{Binding ExecutionTraceFeed}" Background="#0F172A" Foreground="#38BDF8" BorderThickness="0"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5" Padding="10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </TabItem>

                    <!-- Tab 3: System Event Log -->
                    <TabItem Header="{Binding [SimTabEvents], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="12">
                        <ListBox ItemsSource="{Binding EventStream}" Background="#FFFFFF" BorderThickness="0"
                                 Foreground="#0F172A" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5"
                                 Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
