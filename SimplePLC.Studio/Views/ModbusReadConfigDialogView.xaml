<Window x:Class="SimplePLC.Studio.Views.ModbusReadConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [ModbusDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="1040" Height="660"
        ResizeMode="NoResize"
        Icon="../Assets/app.png"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Two-Column Body -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Margin="0,0,12,0">
                    <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ModbusDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding [ModbusDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- 1. Two-Column Body (Left: Wide Parameters & Pins, Right: Live Hex Simulation) -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <!-- Left: Parameters & Pins (Wide Column: ~570px) -->
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="14" />
                    <!-- Right: Live Hex Test (~370px) -->
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: MODBUS PARAMETERS & PINS -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Section Title -->
                        <TextBlock Grid.Row="0" Text="{Binding [ModbusCommSection], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="#1E293B" FontSize="11" Margin="0,0,0,8" />

                        <!-- Form Parameters Grid (Clean, Aligned, Label-on-Top Design - No Double Box!) -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Port (1.2*) | Slave ID (80px) | Read Mode (1.5*) -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <!-- Port Selector -->
                                <StackPanel Grid.Column="0" ToolTip="{Binding PortSelectorTooltip}">
                                    <TextBlock Text="{Binding [ModbusPortSelectorLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}" 
                                                  SelectedValue="{Binding PortIndex}" SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                                                  ToolTip="{Binding PortSelectorTooltip}" 
                                                  Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                                        <Button Grid.Column="1" Command="{Binding OpenDevicePortSettingsCommand}"
                                                Margin="4,0,0,0" Width="28" Height="28" Padding="0" Cursor="Hand"
                                                ToolTip="{Binding [BtnOpenDevicePortSettings], Source={x:Static services:LocalizationService.Instance}}"
                                                Style="{StaticResource TiaTactileBtnStyle}">
                                            <TextBlock Text="⚙️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Slave ID -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [ModbusColSlaveId], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" 
                                              ToolTip="{Binding [ModbusReadColSlaveTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                              Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                              Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Read Mode -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{Binding [ModbusReadModeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableReadModes}" 
                                              SelectedValue="{Binding ReadMode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                              ToolTip="{Binding [ModbusReadColModeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                              Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Function Code (2*) | Start Address (100px) | RegCount (100px) -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <!-- Function Code -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [ModbusColFunctionCode], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableFunctionCodes}" 
                                              SelectedValue="{Binding FunctionCode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                              ToolTip="{Binding [ModbusReadColFcTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                              Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                                </StackPanel>

                                <!-- Start Address -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [ModbusColStartAddr], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="{Binding [ModbusReadColStartAddrTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Quantity of Registers (RegCount) -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{Binding [ModbusColRegCount], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding RegCount, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="{Binding [ModbusReadColQuantityTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: Timeout (120px) | Poll Interval (Visible if Cyclic, 140px) -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Timeout -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [ModbusColTimeout], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="{Binding [ModbusReadColTimeoutTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Poll Interval (Visible only in Cyclic Mode) -->
                                <StackPanel Grid.Column="2"
                                            Visibility="{Binding IsCyclicMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [ModbusColPollInterval], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="{Binding [ModbusReadColPollIntervalTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Clean Divider Line -->
                        <Rectangle Grid.Row="2" Height="1" Fill="#E2E8F0" Margin="0,0,0,12" />

                        <!-- Pins Grid Header & List Container Border -->
                        <Border Grid.Row="3" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Background="#FFFFFF">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Column Header Row (Pixel-Matched to Data Columns) -->
                                <Grid Grid.Row="0" Background="#F1F5F9" Height="28" Margin="4,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="110" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [ModbusColPinName], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusReadPinNameTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding [ModbusColOffset], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusReadPinOffsetTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" TextAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding [MqttSubColType], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusReadPinTypeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                    <TextBlock Grid.Column="6" Text="{Binding [ModbusColEndian], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusReadPinEndianTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                    <TextBlock Grid.Column="8" Text="{Binding [ModbusColScale], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusReadPinScaleTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" TextAlignment="Center" />
                                </Grid>

                                <!-- Empty State Prompt -->
                                <StackPanel Grid.Row="1" Visibility="{Binding HasNoPins, Converter={StaticResource BoolToVis}}" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,35">
                                    <TextBlock Text="📋" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0.4" />
                                    <TextBlock Text="{Binding [ModbusPinsEmptyTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding [ModbusPinsEmptyHint], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Scrollable Rows (When Pins Exist) -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasPins, Converter={StaticResource BoolToVis}}"
                                              Padding="0">
                                    <ItemsControl ItemsSource="{Binding Node.Pins}" Margin="4,2,4,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="110" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="125" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="135" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="28" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Pin Name -->
                                                        <TextBox Grid.Column="0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" 
                                                                 ToolTip="{Binding [ModbusReadPinNameTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                                 Height="25" Padding="6,2" FontSize="11" FontFamily="Consolas" VerticalContentAlignment="Center" 
                                                                 Background="#FFFFFF" BorderBrush="#E2E8F0" />

                                                        <!-- Reg Offset -->
                                                        <TextBox Grid.Column="2" Text="{Binding RegOffset, UpdateSourceTrigger=PropertyChanged}" 
                                                                 ToolTip="{Binding [ModbusReadPinOffsetTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                                 Height="25" Padding="2,2" FontSize="11" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" 
                                                                 Background="#FFFFFF" BorderBrush="#E2E8F0" />

                                                        <!-- Data Type (120px Width - Fits INT16 / REAL / BOOL Comfortably) -->
                                                        <ComboBox Grid.Column="4" 
                                                                  ToolTip="{Binding [ModbusReadPinTypeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                                  ItemsSource="{Binding DataContext.AvailableDataTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedValue="{Binding DataType}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="DisplayName"
                                                                  Height="25" Padding="4,2" FontSize="10.5" VerticalContentAlignment="Center" />

                                                        <!-- Endianness (135px Width - Fits Big-Endian ABCD Without Truncation) -->
                                                        <ComboBox Grid.Column="6" 
                                                                  ToolTip="{Binding [ModbusReadPinEndianTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                                  ItemsSource="{Binding DataContext.AvailableEndianness, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedValue="{Binding Endianness}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="DisplayName"
                                                                  Height="25" Padding="4,2" FontSize="10.5" VerticalContentAlignment="Center" />

                                                        <!-- Scale/Multiplier -->
                                                        <TextBox Grid.Column="8" Text="{Binding Multiplier, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Height="25" Padding="2,2" FontSize="11" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" 
                                                                 Background="#FFFFFF" BorderBrush="{Binding MultiplierBorderBrush}"
                                                                 ToolTip="{Binding MultiplierWarningText}" />

                                                        <!-- Delete Button -->
                                                        <Button Grid.Column="10"
                                                                Style="{StaticResource TableRowDeleteBtnStyle}"
                                                                ToolTip="{Binding [ModbusReadPinDeleteTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                                Command="{Binding DataContext.RemovePinCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Add Pin Button -->
                        <Button Grid.Row="4" Content="{Binding [ModbusBtnAddPin], Source={x:Static services:LocalizationService.Instance}}" 
                                ToolTip="{Binding [ModbusReadBtnAddPinTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                Command="{Binding AddPinCommand}" 
                                Style="{StaticResource TiaTactileBtnStyle}"
                                Margin="0,8,0,0" Padding="14,5" FontSize="11" HorizontalAlignment="Left" />
                    </Grid>
                </Border>

                <!-- RIGHT PANE: LIVE HEX SIMULATION -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Section Header with Sample Button -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="{Binding [ModbusBtnSampleFrame], Source={x:Static services:LocalizationService.Instance}}" 
                                    ToolTip="{Binding [ModbusReadBtnSampleFrameTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                    Command="{Binding ResetSampleHexCommand}"
                                    Style="{StaticResource TiaTactileBtnStyle}"
                                    Padding="8,2" FontSize="10.5" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [ModbusTestSection], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Hex Input Box with Placeholder Hint -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <TextBox x:Name="HexInputBox" Text="{Binding SimulationHexInput, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding [ModbusReadHexInputTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                     AcceptsReturn="True" Height="58"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                     FontFamily="Consolas" FontSize="11" Foreground="#0F172A" Background="#F8FAFC" 
                                     BorderBrush="#CBD5E1" BorderThickness="1" Padding="6" />
                            <TextBlock Text="{Binding [ModbusHexPlaceholder], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="#94A3B8" FontStyle="Italic" 
                                       Margin="8,7,0,0" IsHitTestVisible="False" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=HexInputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Test Action & Decoded Results -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Run Frame Test Button -->
                            <Button Grid.Row="0" Content="{Binding [ModbusBtnRunTest], Source={x:Static services:LocalizationService.Instance}}" 
                                    ToolTip="{Binding [ModbusReadBtnRunTestTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                    Command="{Binding RunSimulationTestCommand}"
                                    Style="{StaticResource TiaTactileBtnStyle}"
                                    Height="28" Padding="12,4" FontSize="11" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                            <!-- Results Container (Neutral Slate with Crisp Typography & Symmetric Scroll) -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                    <StackPanel Margin="4,0,4,0">
                                        <!-- Initial Prompt (When Not Run) -->
                                        <TextBlock Text="{Binding SimulationStatusMessage}" 
                                                   FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="2,2,2,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRunSimulation}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Status Banner (ISA-101 / TIA Portal Diagnostic Box) -->
                                        <Border Visibility="{Binding HasRunSimulation, Converter={StaticResource BoolToVis}}" 
                                                BorderThickness="1" CornerRadius="2" Padding="7,5" Margin="0,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSimulationSuccess}" Value="False">
                                                            <Setter Property="Background" Value="#FEF2F2" />
                                                            <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel LastChildFill="True">
                                                <Border Width="3" CornerRadius="1" Margin="0,0,7,0" DockPanel.Dock="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#107C41" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSimulationSuccess}" Value="False">
                                                                    <Setter Property="Background" Value="#B91C1C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding SimulationStatusMessage}" FontWeight="SemiBold" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0F172A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSimulationSuccess}" Value="False">
                                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>

                                        <!-- Decoded Pins List -->
                                        <StackPanel Visibility="{Binding HasRunSimulation, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding [ModbusResultsPreview], Source={x:Static services:LocalizationService.Instance}}" 
                                                       ToolTip="{Binding [ModbusReadResultsPreviewTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,4" />

                                            <ItemsControl ItemsSource="{Binding Node.Pins}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,3">
                                                            <DockPanel LastChildFill="True">
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="• " FontSize="11" Foreground="#64748B" />
                                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" />
                                                                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                                                            CornerRadius="2" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DataType}" FontFamily="Consolas" FontSize="9.5" Foreground="#334155" />
                                                                    </Border>
                                                                    <TextBlock Text=" ➔" FontSize="11" Foreground="#64748B" Margin="4,0,2,0" />
                                                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                                            CornerRadius="2" Padding="4,1" Margin="2,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding TargetTag.Name, FallbackValue='(None)'}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="#0284C7" ToolTip="{Binding TargetTag.Alias}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding CurrentValue, StringFormat={}{0:0.##}}" 
                                                                           FontFamily="Consolas" FontWeight="Bold" FontSize="11.5" Foreground="#006487" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Footer Action -->
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [ModbusTargetMaster], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="#64748B" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SummaryBadgeText}" 
                                   FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" />
                    </StackPanel>

                    <Button Content="{Binding [ModbusBtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            ToolTip="{Binding [ModbusReadBtnApplyTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            DockPanel.Dock="Right" Click="Apply_Click"
                            Style="{StaticResource BtnPrimary}"
                            FontSize="11.5" Height="28" Padding="20,4" Margin="8,0,0,0" />
                    <Button Content="{Binding [BtnCancel], Source={x:Static services:LocalizationService.Instance}}" 
                            ToolTip="{Binding [ModbusReadBtnCancelTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            DockPanel.Dock="Right" Click="Cancel_Click"
                            Style="{StaticResource TiaTactileBtnStyle}"
                            FontSize="11.5" Height="28" Padding="16,4" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
