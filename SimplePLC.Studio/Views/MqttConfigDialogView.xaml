<Window x:Class="SimplePLC.Studio.Views.MqttConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [MqttConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="830" Height="520"
        MinWidth="780" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Two-Column Body -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header (Industrial Slate & Ocean Blue) -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,12,0">
                    <TextBlock Text="📡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [MqttConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="14" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding [MqttConfigDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- 1. Two-Column Body -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <!-- Left: Payload Definition (Fields or Custom Template) -->
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <!-- Right: Live Payload Preview -->
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: PAYLOAD CONFIGURATION -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 0. Section Title -->
                            <RowDefinition Height="Auto" />
                            <!-- 1. Mode Selector (Separate line to prevent overlap) -->
                            <RowDefinition Height="Auto" />
                            <!-- 2. Dynamic Content per Mode -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Section Title -->
                        <TextBlock Grid.Row="0" Text="{Binding [MqttConfigFieldSection], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="#1E293B" FontSize="11.5" Margin="0,0,0,8" />

                        <!-- Row 1: Payload Mode Selector (Distinct Row - Never Overlaps!) -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [InspectorMqttFormatLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1" SelectedValue="{Binding Node.PayloadMode, Mode=TwoWay}" SelectedValuePath="Tag" 
                                      Padding="6,4" FontSize="11">
                                <ComboBoxItem Content="{Binding [MqttPayloadModeFields], Source={x:Static services:LocalizationService.Instance}}" Tag="JSON" />
                                <ComboBoxItem Content="{Binding [MqttPayloadModeCustom], Source={x:Static services:LocalizationService.Instance}}" Tag="Custom" />
                            </ComboBox>
                        </Grid>

                        <!-- Row 2: Dynamic Content per Mode -->
                        <!-- MODE 1: VISUAL FIELD BUILDER (Standard IIoT Envelope: device, ts, values) -->
                        <Grid Grid.Row="2" Visibility="{Binding Node.IsJsonMode, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Subtitle Description -->
                            <TextBlock Grid.Row="0" Text="{Binding [InspectorMqttFieldBuilderDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Fields Table Container -->
                            <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Background="#FFFFFF">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Column Header -->
                                    <Grid Grid.Row="0" Background="#F1F5F9" Height="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="85" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [InspectorMqttColKey], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="6,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding [InspectorMqttColTag], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding [ColTagDataType], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>

                                    <!-- Scrollable Rows -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6">
                                        <ItemsControl ItemsSource="{Binding Node.Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="85" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="135" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="28" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Field Key (JSON property name) -->
                                                        <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Padding="6,4" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                                        <!-- Source Tag Selection -->
                                                        <ComboBox Grid.Column="2" 
                                                                  ItemsSource="{Binding DataContext.TagCatalog.AllTags, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  SelectedItem="{Binding Tag, Mode=TwoWay}" 
                                                                  DisplayMemberPath="DisplayName" 
                                                                  Padding="6,4" FontSize="11" VerticalAlignment="Center" />
                                                        <!-- Auto Data Type Badge (IEC 61131-3: BOOL / DINT / REAL) -->
                                                        <Border Grid.Column="4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="4,3" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding DataTypeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" TextAlignment="Center" />
                                                        </Border>
                                                        <!-- Delete Field Button -->
                                                        <Button Grid.Column="6" Content="✕" 
                                                                Command="{Binding DataContext.Node.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"
                                                                Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" 
                                                                FontWeight="Bold" FontSize="11" Width="24" Height="24"
                                                                Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Add Field Button (Directly below table) -->
                            <Button Grid.Row="2" Content="{Binding [InspectorMqttBtnAddField], Source={x:Static services:LocalizationService.Instance}}" 
                                    Command="{Binding Node.AddFieldCommand}" 
                                    Style="{StaticResource TiaTactileBtnStyle}"
                                    Margin="0,8,0,0" Padding="12,5" FontSize="11" HorizontalAlignment="Left" />
                        </Grid>

                        <!-- MODE 2: CUSTOM JSON TEMPLATE (User Freeform Payload) -->
                        <Grid Grid.Row="2" Visibility="{Binding Node.IsCustomTemplateVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Description & Length Counter -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding [MqttConfigCustomTemplateDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Node.CustomTemplateCounterText}" 
                                           FontSize="10" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Right" />
                            </DockPanel>

                            <!-- Code Editor TextBox (Expands to fill vertical space) -->
                            <TextBox Grid.Row="1" Text="{Binding Node.CustomTemplate, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                     FontFamily="Consolas" FontSize="11" Foreground="#0F172A" Background="#F8FAFC" 
                                     BorderBrush="#CBD5E1" BorderThickness="1" Padding="8" />

                            <!-- Variable Hint Card (100% Localized) -->
                            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [MqttConfigCustomHintTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding [MqttConfigCustomHintVars], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="9.5" FontFamily="Consolas" Foreground="#475569" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding [MqttConfigCustomHintTags], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Validation Error Banner -->
                            <Border Grid.Row="3" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,6,0,0"
                                    Visibility="{Binding Node.HasCustomTemplateError, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠ " Foreground="#DC2626" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Node.CustomTemplateValidationError}" Foreground="#DC2626" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT PANE: LIVE PAYLOAD PREVIEW ONLY -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 0. Preview Header -->
                            <RowDefinition Height="Auto" />
                            <!-- 1. Preview Box -->
                            <RowDefinition Height="*" />
                            <!-- 2. Ready Status Banner -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Live Payload Preview Header -->
                        <TextBlock Grid.Row="0" Text="{Binding [MqttConfigPayloadSection], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="#1E293B" FontSize="11.5" Margin="0,0,0,8" />

                        <!-- Live Payload Preview Box (Expanded with No Empty Waste) -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                            <TextBox Text="{Binding Node.PreviewPayloadText, Mode=OneWay}" 
                                     IsReadOnly="True" Background="#F8FAFC" BorderThickness="0" 
                                     FontFamily="Consolas" FontSize="11" Foreground="#0F172A" 
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                     TextWrapping="NoWrap" Padding="8" />
                        </Border>

                        <!-- Ready Status Banner (100% Localized) -->
                        <Border Grid.Row="2" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="3" Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding [MqttConfigReadyTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontWeight="SemiBold" FontSize="10.5" Foreground="#15803D" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding [MqttConfigReadyDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10" Foreground="#166534" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Footer Action -->
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [MqttConfigTargetTopic], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="#64748B" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Node.Topic}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" />
                    </StackPanel>

                    <Button Content="{Binding [MqttConfigBtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            DockPanel.Dock="Right" Click="ApplyButton_Click"
                            Style="{StaticResource BtnPrimary}"
                            FontSize="11" Padding="20,5" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
