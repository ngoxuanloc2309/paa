<Window x:Class="SimplePLC.Studio.Views.MqttConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [MqttConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="1040" Height="660"
        ResizeMode="CanResizeWithGrip"
        controls:WindowChromeHelper.EnableIndependentMinimize="True"
        Icon="../Assets/app.png"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MinWidth="980"
        MinHeight="600">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Two-Column Body (Reusable Control) -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header (Industrial Slate & Ocean Blue) -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0"
                        ToolTip="{Binding [MqttHeaderTooltip], Source={x:Static services:LocalizationService.Instance}}">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconIecMqttPublish}" 
                          Width="20" Height="20" Stroke="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenDeviceBrokerSettingsCommand}"
                                Style="{StaticResource TiaTactileBtnStyle}" Padding="10,4" VerticalAlignment="Center"
                                ToolTip="{Binding [BtnOpenDeviceBrokerSettings], Source={x:Static services:LocalizationService.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysSettings}" 
                                      Width="12" Height="12" Stroke="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [BtnOpenDeviceBrokerSettings], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel>
                            <TextBlock Text="{Binding [MqttConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding [MqttConfigDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- 1. Two-Column Body: Reusable MqttTelemetryPublishControl -->
            <controls:MqttTelemetryPublishControl Grid.Row="1" Margin="0,0,0,12" DataContext="{Binding}" />

            <!-- 2. Footer Action -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"
                                ToolTip="{Binding [MqttFooterTopicTooltip], Source={x:Static services:LocalizationService.Instance}}">
                        <TextBlock Text="{Binding [MqttConfigTargetTopic], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Node.Topic}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                        <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="2" Padding="6,2">
                            <TextBlock Text="{Binding Node.PublishModeSummaryText}" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <Button Content="{Binding [MqttConfigBtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            DockPanel.Dock="Right" Click="ApplyButton_Click"
                            ToolTip="{Binding [MqttBtnApplyTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            Style="{StaticResource BtnPrimary}"
                            FontSize="11" Padding="24,6" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
