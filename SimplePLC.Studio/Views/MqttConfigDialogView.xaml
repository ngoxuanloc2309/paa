<Window x:Class="SimplePLC.Studio.Views.MqttConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [MqttConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="920" Height="660"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Two-Column Body -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header (Industrial Slate & Ocean Blue) -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,14,0">
                    <TextBlock Text="📡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [MqttConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding [MqttConfigDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- 1. Two-Column Body -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <!-- Left: Field Builder -->
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="14" />
                    <!-- Right: Payload Format & Live Preview -->
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: VISUAL FIELD BUILDER -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Section Title -->
                        <TextBlock Grid.Row="0" Text="{Binding [MqttConfigFieldSection], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="#334155" FontSize="11" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="{Binding [InspectorMqttFieldBuilderDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <!-- Envelope Options -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding Node.IncludeDevice}" 
                                      Content="{Binding [InspectorMqttIncludeDevice], Source={x:Static services:LocalizationService.Instance}}" 
                                      FontSize="11" Margin="0,0,14,0" FontWeight="Medium" />
                            <CheckBox IsChecked="{Binding Node.IncludeTimestamp}" 
                                      Content="{Binding [InspectorMqttIncludeTimestamp], Source={x:Static services:LocalizationService.Instance}}" 
                                      FontSize="11" FontWeight="Medium" />
                        </StackPanel>

                        <!-- Fields Grid / List -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Column Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,4" Background="#F8FAFC" Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="3.2*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [InspectorMqttColKey], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                <TextBlock Grid.Column="2" Text="{Binding [InspectorMqttColTag], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                <TextBlock Grid.Column="4" Text="{Binding [InspectorMqttColUnit], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                            </Grid>

                            <!-- Scrollable rows -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Node.Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="3.2*" />
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                         Padding="6,4" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="2" 
                                                          ItemsSource="{Binding DataContext.TagCatalog.AllTags, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                          SelectedItem="{Binding Tag, Mode=TwoWay}" 
                                                          DisplayMemberPath="DisplayName" 
                                                          Padding="6,4" FontSize="11" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="4" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" 
                                                         Padding="6,4" FontSize="11" VerticalAlignment="Center" />
                                                <Button Grid.Column="6" Content="✕" 
                                                        Command="{Binding DataContext.Node.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}"
                                                        Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" 
                                                        FontWeight="Bold" FontSize="11" Width="24" Height="24"
                                                        Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Add Field Button -->
                        <Button Grid.Row="4" Content="{Binding [InspectorMqttBtnAddField], Source={x:Static services:LocalizationService.Instance}}" 
                                Command="{Binding Node.AddFieldCommand}" 
                                Style="{StaticResource TiaTactileBtnStyle}"
                                Margin="0,8,0,0" Padding="12,6" FontSize="11" />
                    </Grid>
                </Border>

                <!-- RIGHT PANE: PAYLOAD & PREVIEW -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 0. Title -->
                            <RowDefinition Height="Auto" />
                            <!-- 1. Format & Transport Controls -->
                            <RowDefinition Height="Auto" />
                            <!-- 2. Custom JSON Template (Visible when Custom Mode) -->
                            <RowDefinition Height="Auto" />
                            <!-- 3. Preview Header -->
                            <RowDefinition Height="Auto" />
                            <!-- 4. Preview Box -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Section Title -->
                        <TextBlock Grid.Row="0" Text="{Binding [MqttConfigPayloadSection], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="#334155" FontSize="11" Margin="0,0,0,8" />

                        <!-- Payload Format & Publish Triggers -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="{Binding [InspectorMqttPayloadMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#475569" Margin="0,0,0,3" />
                            <ComboBox SelectedValue="{Binding Node.PayloadMode, Mode=TwoWay}" SelectedValuePath="Tag" Padding="6,4" Margin="0,0,0,8">
                                <ComboBoxItem Content="{Binding [MqttPayloadModeJson], Source={x:Static services:LocalizationService.Instance}}" Tag="JSON" />
                                <ComboBoxItem Content="{Binding [MqttPayloadModeRaw], Source={x:Static services:LocalizationService.Instance}}" Tag="Raw" />
                                <ComboBoxItem Content="{Binding [MqttPayloadModeCustom], Source={x:Static services:LocalizationService.Instance}}" Tag="Custom" />
                            </ComboBox>

                            <!-- Publish Mode & Deadband -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="95" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [InspectorMqttPublishMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#475569" Margin="0,0,0,3" />
                                    <ComboBox SelectedValue="{Binding Node.PublishMode, Mode=TwoWay}" SelectedValuePath="Tag" Padding="6,4">
                                        <ComboBoxItem Content="{Binding [MqttPublishModeEvent], Source={x:Static services:LocalizationService.Instance}}" Tag="Event" />
                                        <ComboBoxItem Content="{Binding [MqttPublishModeCov], Source={x:Static services:LocalizationService.Instance}}" Tag="COV" />
                                        <ComboBoxItem Content="{Binding [MqttPublishModeCyclic], Source={x:Static services:LocalizationService.Instance}}" Tag="Cyclic" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding Node.IsCovMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [InspectorMqttDeadband], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#475569" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Node.Deadband, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding Node.IsPeriodicMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Interval (ms)" FontSize="10.5" Foreground="#475569" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Node.IntervalMs, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Custom JSON Template Box (Expanded Code Editor Style) -->
                        <Border Grid.Row="2" Visibility="{Binding Node.IsCustomTemplateVisible, Converter={StaticResource BoolToVis}}"
                                Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding [InspectorMqttCustomTemplate], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [InspectorMqttCustomTemplateVarsHint], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox Text="{Binding Node.CustomTemplate, UpdateSourceTrigger=PropertyChanged}" 
                                         AcceptsReturn="True" AcceptsTab="True" Height="150" MaxLength="128"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                         FontFamily="Consolas" FontSize="11" Foreground="#0F172A" Background="#FFFFFF"
                                         BorderBrush="#CBD5E1" BorderThickness="1" Padding="8" />
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="Bộ nhớ thiết bị: Tối đa 128 ký tự" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Node.CustomTemplateCounterText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live Payload Preview Header (No Neon Badge) -->
                        <TextBlock Grid.Row="3" Text="{Binding [InspectorMqttPreviewPayload], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="#334155" FontSize="11" Margin="0,4,0,6" />

                        <!-- Live Payload Preview Box (Expanded) -->
                        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2">
                            <TextBox Text="{Binding Node.PreviewPayloadText, Mode=OneWay}" 
                                     IsReadOnly="True" Background="#F8FAFC" BorderThickness="0" 
                                     FontFamily="Consolas" FontSize="11" Foreground="#0F172A" 
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                     TextWrapping="NoWrap" Padding="8" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Footer Action -->
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [MqttConfigTargetTopic], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="#64748B" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Node.Topic}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" />
                    </StackPanel>

                    <Button Content="{Binding [MqttConfigBtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            DockPanel.Dock="Right" Click="ApplyButton_Click"
                            Style="{StaticResource BtnPrimary}"
                            FontSize="11.5" Padding="20,6" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
