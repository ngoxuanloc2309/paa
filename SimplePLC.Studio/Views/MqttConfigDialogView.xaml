<Window x:Class="SimplePLC.Studio.Views.MqttConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [MqttConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="1040" Height="660"
        ResizeMode="NoResize"
        Icon="../Assets/app.png"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Two-Column Body -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header (Industrial Slate & Ocean Blue) -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,12,0"
                        ToolTip="{Binding [MqttHeaderTooltip], Source={x:Static services:LocalizationService.Instance}}">
                    <TextBlock Text="📡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenDeviceBrokerSettingsCommand}"
                                Style="{StaticResource TiaTactileBtnStyle}" Padding="10,4" VerticalAlignment="Center"
                                ToolTip="{Binding [BtnOpenDeviceBrokerSettings], Source={x:Static services:LocalizationService.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding [BtnOpenDeviceBrokerSettings], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{Binding [MqttConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="{Binding [MqttConfigDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- 1. Two-Column Body -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <!-- Left: Communication & Payload Parameters (Wide: 1.4*) -->
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="14" />
                    <!-- Right: Live Payload Preview (1*) -->
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: COMMUNICATION & PAYLOAD CONFIGURATION -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 0. Section 1 Title: Communication & Triggering -->
                            <RowDefinition Height="Auto" />
                            <!-- 1. Communication & Trigger Controls -->
                            <RowDefinition Height="Auto" />
                            <!-- 2. Divider -->
                            <RowDefinition Height="12" />
                            <!-- 3. Section 2 Title: Payload Format -->
                            <RowDefinition Height="Auto" />
                            <!-- 4. Payload Mode Selector -->
                            <RowDefinition Height="Auto" />
                            <!-- 5. Dynamic Payload Content (Fields Table or Custom Template) -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Section 1 Title -->
                        <TextBlock Grid.Row="0" Text="THÔNG SỐ GIAO TIẾP &amp; KÍCH HOẠT (MQTT COMMUNICATION)" 
                                   FontWeight="Bold" Foreground="#1E293B" FontSize="11" Margin="0,0,0,8" />

                        <!-- Row 1: Communication Controls Grid -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <!-- Topic -->
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <!-- Trigger Mode, Interval/Deadband, QoS, Retain -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Topic Row -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [InspectorMqttTopic], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Text="{Binding Node.Topic, UpdateSourceTrigger=PropertyChanged}" 
                                         ToolTip="{Binding [InspectorMqttTopicTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                         Padding="6,4" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Command="{Binding Node.SanitizeTopicCommand}" 
                                        ToolTip="{Binding [InspectorMqttTopicSanitizeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                        Content="🧹" Style="{StaticResource TiaTactileBtnStyle}" Padding="8,4" Margin="6,0,0,0" />
                            </Grid>

                            <!-- Topic Validation Error Warning -->
                            <Border Grid.Row="1" Visibility="{Binding Node.HasTopicError, Converter={StaticResource BoolToVis}}"
                                    Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,2,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3" Background="#DC2626" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Node.TopicValidationError}" Foreground="#DC2626" FontSize="10.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Trigger Mode, Interval/Deadband, QoS, Retain Grid -->
                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <!-- Mode -->
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="10" />
                                    <!-- Interval / Deadband -->
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <!-- QoS -->
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="10" />
                                    <!-- Retain -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Publish Mode -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [InspectorMqttPublishMode], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                    <ComboBox SelectedValue="{Binding Node.PublishMode, Mode=TwoWay}" SelectedValuePath="Tag" 
                                              ToolTip="{Binding [InspectorMqttPublishModeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                              Padding="6,4" FontSize="11" Height="28">
                                        <ComboBoxItem Content="{Binding [MqttPublishModeEvent], Source={x:Static services:LocalizationService.Instance}}" Tag="Event" />
                                        <ComboBoxItem Content="{Binding [MqttPublishModeCyclic], Source={x:Static services:LocalizationService.Instance}}" Tag="Cyclic" />
                                        <ComboBoxItem Content="{Binding [MqttPublishModeCov], Source={x:Static services:LocalizationService.Instance}}" Tag="COV" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Interval or Deadband -->
                                <StackPanel Grid.Column="2">
                                    <!-- When Cyclic: Interval -->
                                    <StackPanel Visibility="{Binding Node.IsPeriodicMode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding [InspectorIntervalMs], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding Node.IntervalMs, UpdateSourceTrigger=PropertyChanged}" 
                                                 ToolTip="{Binding [InspectorMqttIntervalTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                 Padding="6,4" FontSize="11" FontFamily="Consolas" Height="28" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <!-- When COV: Deadband -->
                                    <StackPanel Visibility="{Binding Node.IsCovMode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding [InspectorMqttDeadband], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding Node.DeadbandText, UpdateSourceTrigger=PropertyChanged}" 
                                                 ToolTip="{Binding [InspectorMqttDeadbandTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                 Padding="6,4" FontSize="11" FontFamily="Consolas" Height="28" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <!-- When Event: Placeholder -->
                                    <StackPanel Visibility="{Binding Node.IsEventMode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Kích hoạt" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <Border Height="28" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2">
                                            <TextBlock Text="Chân Trig (FBD)" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- QoS Selector Buttons -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="QoS" 
                                               ToolTip="{Binding [InspectorMqttQosTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                    <Grid Height="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="0" Command="{Binding Node.SetQos0Command}" 
                                                ToolTip="{Binding [InspectorMqttQos0Tooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                Margin="0,0,2,0" FontSize="10.5" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                    <Setter Property="Foreground" Value="#475569" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Node.IsQos0}" Value="True">
                                                            <Setter Property="Background" Value="#E0F2FE" />
                                                            <Setter Property="Foreground" Value="#006487" />
                                                            <Setter Property="BorderBrush" Value="#006487" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="1" Content="1" Command="{Binding Node.SetQos1Command}" 
                                                ToolTip="{Binding [InspectorMqttQos1Tooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                Margin="1,0,1,0" FontSize="10.5" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                    <Setter Property="Foreground" Value="#475569" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Node.IsQos1}" Value="True">
                                                            <Setter Property="Background" Value="#E0F2FE" />
                                                            <Setter Property="Foreground" Value="#006487" />
                                                            <Setter Property="BorderBrush" Value="#006487" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="2" Content="2" Command="{Binding Node.SetQos2Command}" 
                                                ToolTip="{Binding [InspectorMqttQos2Tooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                Margin="2,0,0,0" FontSize="10.5" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                    <Setter Property="Foreground" Value="#475569" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Node.IsQos2}" Value="True">
                                                            <Setter Property="Background" Value="#E0F2FE" />
                                                            <Setter Property="Foreground" Value="#006487" />
                                                            <Setter Property="BorderBrush" Value="#006487" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Retain CheckBox -->
                                <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Margin="4,0,0,4">
                                    <CheckBox IsChecked="{Binding Node.Retain}" 
                                              ToolTip="{Binding [InspectorMqttRetainTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                              Content="Retain" 
                                              FontWeight="SemiBold" FontSize="11" Foreground="#334155" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Row 3: Section 2 Title: Payload Format -->
                        <TextBlock Grid.Row="3" Text="{Binding [MqttConfigFieldSection], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="#1E293B" FontSize="11" Margin="0,0,0,8" />

                        <!-- Row 4: Payload Mode Selector -->
                        <Grid Grid.Row="4" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [InspectorMqttFormatLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1" SelectedValue="{Binding Node.PayloadMode, Mode=TwoWay}" SelectedValuePath="Tag" 
                                      ToolTip="{Binding [MqttPayloadModeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                      Padding="6,4" FontSize="11">
                                <ComboBoxItem Content="{Binding [MqttPayloadModeFields], Source={x:Static services:LocalizationService.Instance}}" Tag="JSON" />
                                <ComboBoxItem Content="{Binding [MqttPayloadModeCustom], Source={x:Static services:LocalizationService.Instance}}" Tag="Custom" />
                            </ComboBox>
                        </Grid>

                        <!-- Row 5: Dynamic Payload Content -->
                        <!-- MODE 1: VISUAL FIELD BUILDER (Standard IIoT Envelope: device, ts, values) -->
                        <Grid Grid.Row="5" Visibility="{Binding Node.IsJsonMode, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Subtitle Description -->
                            <TextBlock Grid.Row="0" Text="{Binding [InspectorMqttFieldBuilderDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Fields Table Container -->
                            <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Background="#FFFFFF">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Column Header -->
                                    <Grid Grid.Row="0" Background="#F1F5F9" Height="26" Margin="4,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="85" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [InspectorMqttColKey], Source={x:Static services:LocalizationService.Instance}}" 
                                                   ToolTip="{Binding [InspectorMqttColKeyTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="6,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding [InspectorMqttColTag], Source={x:Static services:LocalizationService.Instance}}" 
                                                   ToolTip="{Binding [InspectorMqttColTagTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding [ColTagDataType], Source={x:Static services:LocalizationService.Instance}}" 
                                                   ToolTip="{Binding [InspectorMqttColDataTypeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>

                                    <!-- Scrollable Rows (Symmetric ScrollViewer Pattern) -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                        <ItemsControl ItemsSource="{Binding Node.Fields}" Margin="4,2,4,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="85" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="28" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Field Key (JSON property name) -->
                                                        <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                                 ToolTip="{Binding [MqttFieldKeyTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                                 Height="25" Padding="6,2" FontSize="11" FontFamily="Consolas" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#E2E8F0" />
                                                        <!-- Source Tag Selection -->
                                                        <ComboBox Grid.Column="2" 
                                                                  ItemsSource="{Binding DataContext.TagCatalog.AllTags, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  SelectedItem="{Binding Tag, Mode=TwoWay}" 
                                                                  DisplayMemberPath="DisplayName" 
                                                                  ToolTip="{Binding [MqttFieldTagTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                                  Height="25" Padding="4,2" FontSize="10.5" VerticalContentAlignment="Center" BorderBrush="#E2E8F0" />
                                                        <!-- Auto Data Type Badge (IEC 61131-3: BOOL / DINT / REAL) -->
                                                        <Border Grid.Column="4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Height="25" Padding="4,2" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                                ToolTip="{Binding [MqttFieldDataTypeTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                                            <TextBlock Text="{Binding DataTypeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                                        </Border>
                                                        <!-- Delete Field Button -->
                                                        <Button Grid.Column="6"
                                                                Style="{StaticResource TableRowDeleteBtnStyle}"
                                                                Command="{Binding DataContext.Node.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding [MqttFieldDeleteTooltip], Source={x:Static services:LocalizationService.Instance}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Add Field Button (Directly below table) -->
                            <Button Grid.Row="2" Content="{Binding [InspectorMqttBtnAddField], Source={x:Static services:LocalizationService.Instance}}" 
                                    Command="{Binding Node.AddFieldCommand}" 
                                    ToolTip="{Binding [MqttAddFieldTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                    Style="{StaticResource TiaTactileBtnStyle}"
                                    Margin="0,8,0,0" Padding="12,5" FontSize="11" HorizontalAlignment="Left" />
                        </Grid>

                        <!-- MODE 2: CUSTOM JSON TEMPLATE (User Freeform Payload) -->
                        <Grid Grid.Row="5" Visibility="{Binding Node.IsCustomTemplateVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Description & Length Counter -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding [MqttConfigCustomTemplateDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Node.CustomTemplateCounterText}" 
                                           ToolTip="{Binding [MqttCustomTemplateCounterTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="10" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Right" />
                            </DockPanel>

                            <!-- Code Editor TextBox (Expands to fill vertical space) -->
                            <TextBox Grid.Row="1" Text="{Binding Node.CustomTemplate, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" AcceptsTab="True"
                                     ToolTip="{Binding [MqttCustomTemplateTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                     FontFamily="Consolas" FontSize="11" Foreground="#0F172A" Background="#F8FAFC" 
                                     BorderBrush="#CBD5E1" BorderThickness="1" Padding="8" />

                            <!-- Variable Hint Card (100% Localized) -->
                            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,0"
                                    ToolTip="{Binding [MqttCustomTemplateHintTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [MqttConfigCustomHintTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding [MqttConfigCustomHintVars], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="9.5" FontFamily="Consolas" Foreground="#475569" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding [MqttConfigCustomHintTags], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Validation Error Banner -->
                            <Border Grid.Row="3" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,6,0,0"
                                    Visibility="{Binding Node.HasCustomTemplateError, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3" Background="#DC2626" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Node.CustomTemplateValidationError}" Foreground="#DC2626" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT PANE: LIVE PAYLOAD PREVIEW ONLY -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 0. Preview Header -->
                            <RowDefinition Height="Auto" />
                            <!-- 1. Preview Box -->
                            <RowDefinition Height="*" />
                            <!-- 2. Ready Status Banner -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Live Payload Preview Header -->
                        <TextBlock Grid.Row="0" Text="{Binding [MqttConfigPayloadSection], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="#1E293B" FontSize="11.5" Margin="0,0,0,8" />

                        <!-- Live Payload Preview Box (Expanded with No Empty Waste) -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8"
                                ToolTip="{Binding [MqttPreviewPayloadTooltip], Source={x:Static services:LocalizationService.Instance}}">
                            <TextBox Text="{Binding Node.PreviewPayloadText, Mode=OneWay}" 
                                     IsReadOnly="True" Background="#F8FAFC" BorderThickness="0" 
                                     FontFamily="Consolas" FontSize="11" Foreground="#0F172A" 
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                     TextWrapping="NoWrap" Padding="8" />
                        </Border>

                        <!-- Ready Status Banner (ISA-101 / TIA Portal Diagnostic Box - Option 1 Compliance) -->
                        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="8,6"
                                ToolTip="{Binding [MqttReadyStatusTooltip], Source={x:Static services:LocalizationService.Instance}}">
                            <DockPanel LastChildFill="True">
                                <Border Width="3" Background="#107C41" CornerRadius="1" Margin="0,0,8,0" DockPanel.Dock="Left" />
                                <StackPanel>
                                    <TextBlock Text="{Binding [MqttConfigReadyTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontWeight="SemiBold" FontSize="10.5" Foreground="#0F172A" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding [MqttConfigReadyDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10" Foreground="#475569" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Footer Action -->
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"
                                ToolTip="{Binding [MqttFooterTopicTooltip], Source={x:Static services:LocalizationService.Instance}}">
                        <TextBlock Text="{Binding [MqttConfigTargetTopic], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="#64748B" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Node.Topic}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" Margin="0,0,10,0" />
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="6,2">
                            <TextBlock Text="{Binding Node.PublishModeSummaryText}" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" Foreground="#475569" />
                        </Border>
                    </StackPanel>

                    <Button Content="{Binding [MqttConfigBtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            DockPanel.Dock="Right" Click="ApplyButton_Click"
                            ToolTip="{Binding [MqttBtnApplyTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            Style="{StaticResource BtnPrimary}"
                            FontSize="11" Padding="24,6" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
