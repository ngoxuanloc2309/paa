<Window x:Class="SimplePLC.Studio.Views.ModbusPortConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
        xmlns:viewmodels="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [ModbusPortDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="1020" Height="680"
        MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        controls:WindowChromeHelper.EnableIndependentMinimize="True"
        ShowInTaskbar="True"
        Background="{DynamicResource BgWindowBrush}"
        Icon="../Assets/app.png"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1">
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Body -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Action -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconModbusMaster}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource IndustrialPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ModbusPortDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding [ModbusPortDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 1. Content Body: Reusable ModbusPortConfigControl -->
            <controls:ModbusPortConfigControl Grid.Row="1" Margin="0,0,0,10" DataContext="{Binding}" />

            <!-- 2. Footer Action -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding [ModbusPortFooterHint], Source={x:Static services:LocalizationService.Instance}}" 
                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />

                <Button Grid.Column="1" Content="{Binding [ModbusPortCloseBtn], Source={x:Static services:LocalizationService.Instance}}" 
                        Command="{Binding CancelCommand}" Style="{StaticResource BtnSecondary}" 
                        Padding="20,6" FontSize="12" FontWeight="SemiBold" IsCancel="True" />

                <Button Grid.Column="3" Content="{Binding [ModbusPortApplyBtn], Source={x:Static services:LocalizationService.Instance}}" 
                        Command="{Binding ApplyCommand}" Style="{StaticResource BtnPrimary}" 
                        Padding="22,6" FontSize="12" FontWeight="SemiBold" IsDefault="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
