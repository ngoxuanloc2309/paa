<Window x:Class="SimplePLC.Studio.Views.ModbusPortConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
        xmlns:viewmodels="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [ModbusPortDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="860" Height="570"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        Icon="../Assets/app.png"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Body -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Action -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ModbusPortDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding [ModbusPortDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 1. Content Body: Left Port Selector & Right Settings Editor -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Port List -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding [ModbusPortSelectorLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11.5" FontWeight="Bold" Foreground="#334155" Margin="4,4,4,8" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding [ModbusNoPhysicalPortsMessage], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="#94A3B8" FontStyle="Italic" Margin="8,12,8,8" TextWrapping="Wrap"
                                   Visibility="{Binding HasPhysicalPorts, Converter={StaticResource InverseBoolToVis}}" />
                        <ListBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" 
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CBD5E1" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B82F6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" />
                                            <Border Grid.Column="1" Background="{Binding StatusPillColor}" CornerRadius="2" Padding="5,1">
                                                <TextBlock Text="{Binding StatusPill}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding SummaryBadge}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right Column: Port Details Editor -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                    <Grid DataContext="{Binding SelectedPort}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Details: DisplayName on Left, Reset Button & Enable CheckBox on Right -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding DataContext.ResetDefaultsCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        ToolTip="{Binding [ModbusPortResetBtnTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                        IsEnabled="{Binding Enabled}"
                                        Style="{StaticResource BtnSecondary}" 
                                        Height="26" Padding="10,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↺" FontSize="11.5" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [ModbusPortResetBtn], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <CheckBox Content="{Binding [ModbusPortEnabledLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                          IsChecked="{Binding Enabled}" FontWeight="SemiBold" VerticalAlignment="Center"
                                          ToolTip="{Binding [ModbusPortEnabledTooltip], Source={x:Static services:LocalizationService.Instance}}" />
                            </StackPanel>
                        </Grid>

                        <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,14" />

                        <!-- Form Parameters (Dimmed when Disabled) -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding Enabled}">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Grid Margin="0,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Port Name & Baud Rate -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding [ModbusPortNameLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusPortNameTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="{Binding [ModbusPortNameTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                             MaxLength="12" Height="28" Padding="6,4" FontSize="11.5" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding [ModbusPortBaudRateLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusPortBaudRateTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableBaudRates, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding BaudRate}" Height="28" Padding="6,4" FontSize="11.5" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                                              ToolTip="{Binding [ModbusPortBaudRateTooltip], Source={x:Static services:LocalizationService.Instance}}" />
                                </StackPanel>

                                <!-- Row 1: Parity & Stop Bits -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding [ModbusPortParityLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusPortParityTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableParities, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Parity}" Height="28" Padding="6,4" FontSize="11.5" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                                              ToolTip="{Binding [ModbusPortParityTooltip], Source={x:Static services:LocalizationService.Instance}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding [ModbusPortStopBitsLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusPortStopBitsTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableStopBits, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding StopBits}" Height="28" Padding="6,4" FontSize="11.5" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                                              ToolTip="{Binding [ModbusPortStopBitsTooltip], Source={x:Static services:LocalizationService.Instance}}" />
                                </StackPanel>

                                <!-- Row 2: Data Bits & Retry Count -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding [ModbusPortDataBitsLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusPortDataBitsTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableDataBits, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DataBits}" Height="28" Padding="6,4" FontSize="11.5" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                                              ToolTip="{Binding [ModbusPortDataBitsTooltip], Source={x:Static services:LocalizationService.Instance}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding [ModbusPortRetriesLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusPortRetriesTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" FontSize="11.5" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                                             ToolTip="{Binding [ModbusPortRetriesTooltip], Source={x:Static services:LocalizationService.Instance}}" />
                                </StackPanel>

                                <!-- Row 3: Timeout & Inter-Frame Delay -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding [ModbusPortTimeoutLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusPortTimeoutTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ResponseTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" FontSize="11.5" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                                             ToolTip="{Binding [ModbusPortTimeoutTooltip], Source={x:Static services:LocalizationService.Instance}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding [ModbusPortDelayLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               ToolTip="{Binding [ModbusPortDelayTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding InterFrameDelayMs, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" FontSize="11.5" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                                             ToolTip="{Binding [ModbusPortDelayTooltip], Source={x:Static services:LocalizationService.Instance}}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Footer Action (Aligned to Wifi & Mqtt Standard: Close/Cancel on left, Apply/Save on right) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding [ModbusPortFooterHint], Source={x:Static services:LocalizationService.Instance}}" 
                           FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />

                <Button Grid.Column="1" Content="{Binding [ModbusPortCloseBtn], Source={x:Static services:LocalizationService.Instance}}" 
                        Command="{Binding CancelCommand}" Style="{StaticResource BtnSecondary}" 
                        Padding="20,6" FontSize="12" FontWeight="SemiBold" IsCancel="True" />

                <Button Grid.Column="3" Content="{Binding [ModbusPortApplyBtn], Source={x:Static services:LocalizationService.Instance}}" 
                        Command="{Binding ApplyCommand}" Style="{StaticResource BtnPrimary}" 
                        Padding="22,6" FontSize="12" FontWeight="SemiBold" IsDefault="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
