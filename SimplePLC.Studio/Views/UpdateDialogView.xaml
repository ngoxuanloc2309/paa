<Window x:Class="SimplePLC.Studio.Views.UpdateDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        Title="{Binding [UpdateTitleNewRelease], Source={x:Static services:LocalizationService.Instance}}"
        Width="620" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#ECEFF1"
        Icon="../Assets/app.png"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Mechanical Solid Primary Action Button (Industrial Slate / Charcoal Gray) -->
            <Style x:Key="BtnIndustrialPrimary" TargetType="Button">
                <Setter Property="Background" Value="#334155" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="18,6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#1E293B" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Setter Property="BorderBrush" Value="#0F172A" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#0F172A" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#E2E8F0" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnIndustrialSecondary" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#1E293B" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SecBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="BorderBrush" Value="#94A3B8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#E2E8F0" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Setter TargetName="SecBorder" Property="Opacity" Value="0.5" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#94A3B8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Industrial DIN-Rail Header Ribbon (Docked Top) -->
                <RowDefinition Height="Auto" />
                <!-- 1. Technical Body Content -->
                <RowDefinition Height="*" />
                <!-- 2. Mechanical Footer Toolbar (Docked Bottom) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Industrial Header Ribbon (Docked edge-to-edge, Slate Ribbon) -->
            <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Margin="0,0,10,0">
                        <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [UpdateTitleNewRelease], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="{Binding [UpdateDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="#475569" Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Official Technical Chip -->
                    <Border Grid.Column="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [UpdateDialogBadgeRelease], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="10" FontWeight="SemiBold" Foreground="#334155" />
                    </Border>
                </Grid>
            </Border>

            <!-- 1. Technical Body Content (Compact & Density Focused) -->
            <Grid Grid.Row="1" Margin="12,10,12,10">
                <Grid.RowDefinitions>
                    <!-- Row 0: Version & Package Specs Strip -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Changelog Card -->
                    <RowDefinition Height="*" />
                    <!-- Row 2: Progress (if downloading) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Version & Package Specs Bar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="12,7" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Current -> Target Version -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [UpdateDialogCurrentVersion], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCurrentVersion" Text="v2.2.1" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" />
                            </Border>

                            <TextBlock Text="➔" FontSize="11" Foreground="#94A3B8" Margin="8,0,8,0" VerticalAlignment="Center" />

                            <TextBlock Text="{Binding [UpdateDialogLatestVersion], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Border Background="#F1F5F9" BorderBrush="#475569" BorderThickness="1" CornerRadius="2" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLatestVersion" Text="v2.3.0" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" />
                            </Border>
                        </StackPanel>

                        <!-- Right: Package Size & Architecture -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [UpdateDialogPackageSize], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtAssetSize" Text="42.5 MB" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="win-x64 setup" FontSize="10" Foreground="#475569" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: Changelog Card -->
                <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="12,8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding [UpdateDialogChangelogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="Bold" Foreground="#1E293B" />
                                <TextBlock DockPanel.Dock="Right" Text="SPLC-SPEC-CHG" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ChangelogContentPanel" Margin="0,0,2,0">
                                <!-- Dynamic Changelog Content -->
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Row 2: Download Progress (Collapsed by default) -->
                <Border x:Name="ProgressPanel" Grid.Row="2" Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="TxtProgressStatus" DockPanel.Dock="Left" Text="{Binding [UpdateDialogDownloading], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                            <TextBlock x:Name="TxtProgressPercent" DockPanel.Dock="Right" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" />
                        </DockPanel>
                        <ProgressBar x:Name="PrgDownload" Height="5" Minimum="0" Maximum="100" Value="0" 
                                     Foreground="#334155" Background="#E2E8F0" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Mechanical Footer Toolbar (Docked edge-to-edge, Industrial Strip) -->
            <Border Grid.Row="2" Background="#DFE3E8" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="TxtStatusMessage" Text="" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DangerBrush}" FontWeight="Medium" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="{Binding [UpdateDialogBtnLater], Source={x:Static services:LocalizationService.Instance}}" 
                                Click="BtnCancel_Click"
                                Style="{StaticResource BtnIndustrialSecondary}" IsCancel="True" Margin="0,0,8,0" />

                        <Button x:Name="BtnUpdateNow" Content="{Binding [UpdateDialogBtnUpdate], Source={x:Static services:LocalizationService.Instance}}" 
                                Click="BtnUpdateNow_Click"
                                Style="{StaticResource BtnIndustrialPrimary}" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
