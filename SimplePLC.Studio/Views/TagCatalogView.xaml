<UserControl x:Class="SimplePLC.Studio.Views.TagCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SimplePLC.Studio.Models"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Crisp Flat DataGrid Column Header Styles -->
        <Style x:Key="TagColHeaderLeft" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagColHeaderCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TagColHeaderLeft}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,8" />
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding TitleText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding [TagCatalogDesc], Source={x:Static services:LocalizationService.Instance}}" 
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Filter Bar & Toolbar -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <!-- Group Filter Buttons (Dynamic with Active State) -->
                <ItemsControl ItemsSource="{Binding GroupButtons}" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" 
                                    Command="{Binding DataContext.FilterByGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding Key}" 
                                    Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F3F4F6" />
                                        <Setter Property="Foreground" Value="#475569" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                                        <Setter Property="Padding" Value="12,6" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="2"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#DFE3E8" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#E0F2FE" />
                                                <Setter Property="Foreground" Value="{StaticResource IndustrialPrimaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource IndustrialPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Right-side Actions & Search -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Reset Defaults Button -->
                    <Button Command="{Binding ResetDefaultAliasesCommand}"
                            Content="{Binding [TagBtnReset], Source={x:Static services:LocalizationService.Instance}}"
                            Style="{StaticResource TiaTactileBtnStyle}"
                            Padding="10,6" Margin="0,0,8,0" FontSize="12" />

                    <!-- Export CSV Button -->
                    <Button Command="{Binding ExportCsvCommand}"
                            Content="{Binding [TagBtnExportCsv], Source={x:Static services:LocalizationService.Instance}}"
                            Background="#F3F4F6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                            Padding="10,6" Margin="0,0,12,0" FontSize="12" FontWeight="SemiBold" Foreground="#107C41" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E6F4EA" />
                                        <Setter Property="BorderBrush" Value="#107C41" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Enhanced Search Bar -->
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Width="260" Height="32" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <Grid Grid.Column="1">
                                <TextBlock Text="{Binding [TagSearchPlaceholder], Source={x:Static services:LocalizationService.Instance}}"
                                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchFilter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchFilter}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="11"
                                         Foreground="#0F172A" VerticalContentAlignment="Center" Padding="0" />
                            </Grid>

                            <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Cursor="Hand"
                                    FontWeight="Bold" FontSize="11" Content="✕" Width="18" Height="18" Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchFilter}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchFilter}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#B91C1C" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tag Group Explanation Card -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <!-- Card Header -->
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentGroupInfo.Icon}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentGroupInfo.GroupName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Hardware Spec Badge -->
                        <Border Background="#F3F4F6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentGroupInfo.HardwareSpec}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                        </Border>

                        <!-- Toggle Banner Button -->
                        <Button Command="{Binding ToggleBannerCommand}"
                                ToolTip="{Binding BannerToggleText}"
                                Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                Padding="8,3" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding BannerToggleIcon}" FontSize="9" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding BannerToggleText}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#ECEFF1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Details Section (Collapsible) -->
                <StackPanel Visibility="{Binding IsBannerExpanded, Converter={StaticResource BoolToVis}}">
                    <Separator Background="{StaticResource BorderLightBrush}" Margin="0,10,0,10" />

                    <!-- Details 2-Column Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Field Device Meaning -->
                        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{Binding [TagBannerSecMeaning], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding CurrentGroupInfo.Description}" FontSize="12" Foreground="#1E293B" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- Column 2: Role in PLC Rules -->
                        <Border Grid.Column="2" Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{Binding [TagBannerSecRole], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding CurrentGroupInfo.RoleInPLC}" FontSize="12" Foreground="#1E293B" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tag Table -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="6">
            <DataGrid ItemsSource="{Binding FilteredTags}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column"
                      ColumnHeaderStyle="{StaticResource TagColHeaderLeft}"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Background="White" BorderThickness="0" RowHeight="38" AlternatingRowBackground="#FAFAFA"
                      SelectionMode="Single"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextRenderingMode="ClearType"
                      RenderOptions.ClearTypeHint="Enabled">

                <DataGrid.Columns>
                    <!-- Index (Centered Header & Cell) -->
                    <DataGridTextColumn Header="{Binding [ColTagIndex], Source={x:Static services:LocalizationService.Instance}}" 
                                        HeaderStyle="{StaticResource TagColHeaderCenter}"
                                        Width="55" Binding="{Binding Index}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Tag Code (Left Aligned, 12px indent) -->
                    <DataGridTextColumn Header="{Binding [ColTagName], Source={x:Static services:LocalizationService.Instance}}" 
                                        Width="130" MinWidth="110" Binding="{Binding Name}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#1E293B" />
                                <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="12,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Modbus Address (Left Aligned, 12px indent) -->
                    <DataGridTemplateColumn Header="{Binding [ColTagModbus], Source={x:Static services:LocalizationService.Instance}}" Width="165" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding ModbusAddressText}" FontFamily="Consolas, Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Data Type (Centered Header & Cell) -->
                    <DataGridTemplateColumn Header="{Binding [ColTagDataType], Source={x:Static services:LocalizationService.Instance}}" 
                                            HeaderStyle="{StaticResource TagColHeaderCenter}"
                                            Width="105" MinWidth="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" CornerRadius="3" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DataTypeText}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Group Chip (Centered Header & Cell) -->
                    <DataGridTemplateColumn Header="{Binding [ColTagGroup], Source={x:Static services:LocalizationService.Instance}}" 
                                            HeaderStyle="{StaticResource TagColHeaderCenter}"
                                            Width="100" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E2E8F0" CornerRadius="3" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Group}" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Alias (Left Aligned, Editable) -->
                    <DataGridTemplateColumn Header="{Binding [ColTagAlias], Source={x:Static services:LocalizationService.Instance}}" Width="*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="6,2">
                                    <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" 
                                             BorderThickness="1" BorderBrush="Transparent"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             Padding="6,4"
                                             Foreground="#0F172A" FontSize="12">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                        <Setter Property="Background" Value="#F8FAFC" />
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource IndustrialPrimaryBrush}" />
                                                        <Setter Property="Background" Value="#FFFFFF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <!-- Placeholder khi chưa có Alias -->
                                    <TextBlock Text="{Binding [TagAliasPlaceholder], Source={x:Static services:LocalizationService.Instance}}"
                                               Foreground="#94A3B8" FontSize="11.5" FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Alias}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Alias}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Live Value & Quick Toggle (Left Aligned, 12px indent) -->
                    <DataGridTemplateColumn Header="{Binding [ColTagValue], Source={x:Static services:LocalizationService.Instance}}" Width="160" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                    <!-- LED Indicator Dot -->
                                    <Border Width="9" Height="9" CornerRadius="4.5" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#94A3B8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Value}" Value="1">
                                                        <Setter Property="Background" Value="#107C41" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Value Text -->
                                    <TextBlock Text="{Binding Value}" FontWeight="Bold" FontFamily="Consolas, Segoe UI" FontSize="13" Foreground="#0F172A" MinWidth="36" VerticalAlignment="Center" />

                                    <!-- Quick Toggle Button for Digital Tags -->
                                    <Button Command="{Binding DataContext.ToggleTagValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            ToolTip="{Binding [TagToggleTip], Source={x:Static services:LocalizationService.Instance}}"
                                            Visibility="{Binding IsDigital, Converter={StaticResource BoolToVis}}"
                                            Margin="8,0,0,0" Padding="6,3" Cursor="Hand" Background="#F1F5F9" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="⚡ 0↔1" FontSize="10" FontWeight="Bold" Foreground="#334155" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DFE3E8" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

