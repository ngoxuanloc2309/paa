<UserControl x:Class="SimplePLC.Studio.Views.VirtualIoBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LogicEditorViewModel}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="TactileToolbarBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#0284C7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#0369A1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="DragTransform" />
    </UserControl.RenderTransform>
    <Border x:Name="RootBorder" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="4"
            MaxWidth="360" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Quick Actions Footer -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER (Draggable) -->
            <Border x:Name="HeaderBorder" Grid.Row="0" Background="#0F172A" CornerRadius="3,3,0,0" Padding="10,6"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    ToolTip="Kéo để di chuyển vị trí">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="🎛️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [VirtualIoBoardTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" FontFamily="Segoe UI" VerticalAlignment="Center" />
                        <Border Background="#107C41" CornerRadius="2" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [VirtualIoBadge], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas" />
                        </Border>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Command="{Binding ToggleVirtualIoBoardCommand}" DockPanel.Dock="Right"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            FontSize="11" FontWeight="Bold" Cursor="Hand" Padding="4,1" VerticalAlignment="Center"
                            ToolTip="{Binding [VirtualIoToggleTip], Source={x:Static services:LocalizationService.Instance}}">
                        <TextBlock Text="✕" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- 2. SCROLLABLE CONTENT BODY -->
            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="450" Padding="8,6">
                <StackPanel>
                    <!-- SECTION 1: DIGITAL INPUTS (DI0..DI7) -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [VirtualIoInputsTitle], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="10" FontWeight="Bold" Foreground="#1E3A8A" FontFamily="Segoe UI" VerticalAlignment="Center" />
                                <TextBlock Text="TACTILE SWITCH" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Consolas"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding VirtualDiTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleVirtualDiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="2" Padding="6,4" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="BtnBdr" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                    <DockPanel LastChildFill="True">
                                                                        <!-- Status Indicator Pill -->
                                                                        <Border x:Name="StatusPill" DockPanel.Dock="Right" CornerRadius="2" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#E2E8F0" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Value}" Value="1">
                                                                                            <Setter Property="Background" Value="#107C41" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock x:Name="StatusText" FontSize="9" FontWeight="Bold" FontFamily="Consolas">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="0" />
                                                                                        <Setter Property="Foreground" Value="#64748B" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Value}" Value="1">
                                                                                                <Setter Property="Text" Value="1" />
                                                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Border>

                                                                        <!-- Tag Name & Alias -->
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" />
                                                                            <TextBlock Text="{Binding Alias}" FontSize="9" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="BtnBdr" Property="BorderBrush" Value="#0284C7" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value}" Value="1">
                                                            <Setter Property="Background" Value="#ECFDF5" />
                                                            <Setter Property="BorderBrush" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: DIGITAL OUTPUTS (DO0..DO7) -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [VirtualIoOutputsTitle], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="10" FontWeight="Bold" Foreground="#0F766E" FontFamily="Segoe UI" VerticalAlignment="Center" />
                                <TextBlock Text="INDICATOR LED" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Consolas"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding VirtualDoTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2" Padding="6,4" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value}" Value="1">
                                                            <Setter Property="Background" Value="#F0FDF4" />
                                                            <Setter Property="BorderBrush" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel LastChildFill="True">
                                                <!-- Glowing LED -->
                                                <Border DockPanel.Dock="Right" Width="14" Height="14" CornerRadius="7" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#CBD5E1" />
                                                            <Setter Property="BorderBrush" Value="#94A3B8" />
                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Value}" Value="1">
                                                                    <Setter Property="Background" Value="#107C41" />
                                                                    <Setter Property="BorderBrush" Value="#0E6B37" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Tag info -->
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding Alias}" FontSize="9" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 3: ANALOG INPUTS (AI0..AI3) -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,6">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [VirtualIoAnalogTitle], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="10" FontWeight="Bold" Foreground="#006487" FontFamily="Segoe UI" VerticalAlignment="Center" />
                                <TextBlock Text="0 - 10000 mV" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Consolas"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding VirtualAiTags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" Margin="0,2,0,4">
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A"
                                                       Width="32" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding Value, StringFormat='{}{0} mV'}" FontSize="9.5" FontWeight="SemiBold" FontFamily="Consolas"
                                                       Foreground="#006487" Width="55" TextAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" />
                                            <Slider Value="{Binding Value, Mode=TwoWay}" Minimum="0" Maximum="10000" SmallChange="100" LargeChange="1000"
                                                    VerticalAlignment="Center" Margin="6,0" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. QUICK ACTIONS FOOTER -->
            <Border x:Name="FooterBorder" Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,6" CornerRadius="0,0,3,3">
                <DockPanel LastChildFill="False">
                    <Button Command="{Binding SetAllVirtualDiCommand}" CommandParameter="0"
                            Style="{StaticResource TactileToolbarBtnStyle}"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#475569"
                            FontSize="10" FontWeight="Medium" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏹" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [VirtualIoAllDiOff], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ResetAllVirtualIoCommand}"
                            Style="{StaticResource TactileToolbarBtnStyle}"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#B91C1C"
                            FontSize="10" FontWeight="Medium" Padding="8,3" Cursor="Hand" DockPanel.Dock="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [VirtualIoResetAll], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
