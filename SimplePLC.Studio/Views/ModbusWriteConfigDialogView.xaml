<Window x:Class="SimplePLC.Studio.Views.ModbusWriteConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [ModbusWriteDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="1020" Height="650"
        MinWidth="960" MinHeight="580"
        Icon="../Assets/app.png"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Two-Column Body -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Margin="0,0,12,0">
                    <TextBlock Text="📤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ModbusWriteDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding [ModbusWriteDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- 1. Two-Column Body (Left: Wide Parameters & Mapping/Pins, Right: Live Hex Test) -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <!-- Left: Parameters & Mapping / Pins (~60%) -->
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="14" />
                    <!-- Right: Live Hex Test (~40%) -->
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: MODBUS WRITE CONFIGURATION -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Section Title -->
                        <TextBlock Grid.Row="0" Text="{Binding [ModbusWriteCommSection], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="#1E293B" FontSize="11" Margin="0,0,0,8" />

                        <!-- Form Parameters Grid (3 Clean Rows with plenty of width) -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <!-- Row 0: Slave ID | Write Mode | Trigger Mode -->
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <!-- Row 2: Mode-Specific Settings -->
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <!-- Row 4: Timing & Options -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Port (1.2*) | Slave ID (80px) | Mode (1.8*) -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>

                                <!-- Port Selector -->
                                <StackPanel Grid.Column="0" ToolTip="{Binding PortSelectorTooltip}">
                                    <TextBlock Text="{Binding [ModbusPortSelectorLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailablePorts}" 
                                              SelectedValue="{Binding PortIndex}" SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                                              ToolTip="{Binding PortSelectorTooltip}" 
                                              Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                                </StackPanel>

                                <!-- Slave ID -->
                                <StackPanel Grid.Column="2" ToolTip="{Binding [ModbusWriteColSlaveIdTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColSlaveId], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" 
                                              Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                              Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Write Mode -->
                                <StackPanel Grid.Column="4" ToolTip="{Binding [ModbusWriteColModeTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColMode], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableWriteModes}" 
                                              SelectedValue="{Binding WriteMode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                              Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Mode-Specific Parameters -->
                            <!-- Case A: Channel-Indexed Mode -->
                            <Grid Grid.Row="2" Visibility="{Binding IsChannelIndexedMode, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Trigger Mode -->
                                <StackPanel Grid.Column="0" ToolTip="{Binding [ModbusWriteColTrigModeTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColTrigMode], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableTriggerModes}" 
                                              SelectedValue="{Binding TriggerMode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                              Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                                </StackPanel>

                                <!-- Channel Count -->
                                <StackPanel Grid.Column="2" ToolTip="{Binding [ModbusWriteColChCountTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColChCount], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ChannelCount, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Base Address Command -->
                                <StackPanel Grid.Column="4" ToolTip="{Binding [ModbusWriteColBaseCmdTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColBaseCmd], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding BaseAddressCommand, StringFormat={}{0:X4}, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Base Address Param -->
                                <StackPanel Grid.Column="6" ToolTip="{Binding [ModbusWriteColBaseParamTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColBaseParam], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding BaseAddressParam, StringFormat={}{0:X4}, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Case B: Direct Registers Mode -->
                            <Grid Grid.Row="2" Visibility="{Binding IsDirectRegistersMode, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <!-- Trigger Mode -->
                                <StackPanel Grid.Column="0" ToolTip="{Binding [ModbusWriteColTrigModeTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColTrigMode], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableTriggerModes}" 
                                              SelectedValue="{Binding TriggerMode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                              Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                                </StackPanel>

                                <!-- Function Code -->
                                <StackPanel Grid.Column="2" ToolTip="{Binding [ModbusWriteColFunctionCodeTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColFunctionCode], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableFunctionCodes}" 
                                              SelectedValue="{Binding FunctionCode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                              Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                                </StackPanel>

                                <!-- Start Address -->
                                <StackPanel Grid.Column="4" ToolTip="{Binding [ModbusWriteColStartAddrTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColStartAddr], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Point Count -->
                                <StackPanel Grid.Column="6" ToolTip="{Binding [ModbusWriteColPointCountTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColPointCount], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding PointCount, UpdateSourceTrigger=PropertyChanged}" 
                                             IsEnabled="{Binding IsMultipleMode}"
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: Timing & Mode-Specific Option -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Timeout (Universal RS-485 Parameter) -->
                                <StackPanel Grid.Column="0" ToolTip="{Binding [ModbusWriteColTimeoutTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <TextBlock Text="{Binding [ModbusWriteColTimeout], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Column 2: Dynamic Trigger Parameter (Interval or Deadband) -->
                                <Grid Grid.Column="2" Visibility="{Binding HasTriggerParameter, Converter={StaticResource BoolToVis}}">
                                    <!-- Case 1: Cyclic Interval -->
                                    <StackPanel Visibility="{Binding IsCyclicMode, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding [ModbusWriteColCyclicTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                        <TextBlock Text="{Binding [ModbusWriteColCyclic], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding CyclicIntervalMs, UpdateSourceTrigger=PropertyChanged}" 
                                                 Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                                 Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                    </StackPanel>

                                    <!-- Case 2: OnDataChange Deadband -->
                                    <StackPanel Visibility="{Binding IsOnDataChangeMode, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding [ModbusWriteColDeadbandTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                        <TextBlock Text="{Binding [ModbusWriteColDeadbandLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Deadband, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" 
                                                 Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                                 Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Column 4: Exclusive Checkbox (ChannelIndexed) or Status Badge (Direct) -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                    <!-- Exclusive CheckBox -->
                                    <CheckBox IsChecked="{Binding IsExclusiveChannel}" 
                                              Visibility="{Binding IsChannelIndexedMode, Converter={StaticResource BoolToVis}}"
                                              VerticalContentAlignment="Center"
                                              ToolTip="{Binding [ModbusWriteExclusiveCheckTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                        <TextBlock Text="{Binding [ModbusWriteExclusiveCheck], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" Foreground="#334155" FontWeight="SemiBold" Margin="4,0,0,0" TextWrapping="Wrap" />
                                    </CheckBox>

                                    <!-- Direct Mode Summary Badge -->
                                    <Border Visibility="{Binding IsDirectRegistersMode, Converter={StaticResource BoolToVis}}"
                                            Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SummaryBadgeText}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#475569" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Clean Divider Line -->
                        <Rectangle Grid.Row="2" Height="1" Fill="#E2E8F0" Margin="0,0,0,12" />

                        <!-- Bottom Section: Dynamic Mapping Table or Pins Table -->
                        <!-- A. Channel Mapping Table (Channel-Indexed Mode) -->
                        <Grid Grid.Row="3" Visibility="{Binding IsChannelIndexedMode, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding [ModbusWriteSectionMapping], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" Foreground="#1E293B" FontSize="11" Margin="0,0,0,6" />

                            <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Background="#FFFFFF">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Table Header -->
                                    <Grid Grid.Row="0" Background="#F1F5F9" Height="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [ModbusWriteColChannel], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding [ModbusWriteColCmdAddr], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding [ModbusWriteColParamAddr], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="6" Text="{Binding [ModbusWriteColDescription], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="6,0" />
                                    </Grid>

                                    <!-- Scrollable Rows -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4,2">
                                        <ItemsControl ItemsSource="{Binding ChannelMappings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="65" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Channel Tag -->
                                                            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="4,2" Margin="4,0">
                                                                <TextBlock Text="{Binding ChannelDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" />
                                                            </Border>

                                                            <!-- Command Reg -->
                                                            <TextBlock Grid.Column="2" Text="{Binding CommandRegHex}" 
                                                                       FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#006487" VerticalAlignment="Center" Margin="4,0" />

                                                            <!-- Param Reg -->
                                                            <TextBlock Grid.Column="4" Text="{Binding ParamRegHex}" 
                                                                       FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />

                                                            <!-- Description -->
                                                            <TextBlock Grid.Column="6" Text="{Binding Description}" 
                                                                       FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- B. Direct Registers Pins Table (Direct Mode) -->
                        <Grid Grid.Row="3" Visibility="{Binding IsDirectRegistersMode, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding [ModbusWriteSectionPins], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" Foreground="#1E293B" FontSize="11" Margin="0,0,0,6" />

                            <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Background="#FFFFFF">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Table Header -->
                                    <Grid Grid.Row="0" Background="#F1F5F9" Height="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="95" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [ModbusColPinName], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding [ModbusColOffset], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding [MqttSubColType], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="6" Text="{Binding [ModbusColEndian], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="8" Text="{Binding [ModbusColScale], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" TextAlignment="Center" />
                                    </Grid>

                                    <!-- Empty Prompt -->
                                    <StackPanel Grid.Row="1" Visibility="{Binding HasNoPins, Converter={StaticResource BoolToVis}}" 
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                                        <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.4" />
                                        <TextBlock Text="{Binding [ModbusPinsEmptyTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontWeight="SemiBold" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Rows -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                                  Visibility="{Binding HasPins, Converter={StaticResource BoolToVis}}"
                                                  Padding="4,2">
                                        <ItemsControl ItemsSource="{Binding Node.Pins}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="95" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="48" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="135" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="48" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="28" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Height="25" Padding="6,2" FontSize="11" FontFamily="Consolas" VerticalContentAlignment="Center" 
                                                                     Background="#FFFFFF" BorderBrush="#E2E8F0" />
                                                            <TextBox Grid.Column="2" Text="{Binding RegOffset, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Height="25" Padding="2,2" FontSize="11" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" 
                                                                     Background="#FFFFFF" BorderBrush="#E2E8F0" />
                                                            <ComboBox Grid.Column="4" ItemsSource="{Binding DataContext.AvailableDataTypes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                      SelectedValue="{Binding DataType}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                                                      Height="25" Padding="4,2" FontSize="10.5" VerticalContentAlignment="Center" BorderBrush="#E2E8F0" />
                                                            <ComboBox Grid.Column="6" ItemsSource="{Binding DataContext.AvailableEndianness, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                      SelectedValue="{Binding Endianness}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                                                      Height="25" Padding="4,2" FontSize="10.5" VerticalContentAlignment="Center" BorderBrush="#E2E8F0" />
                                                            <TextBox Grid.Column="8" Text="{Binding Multiplier, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Height="25" Padding="2,2" FontSize="11" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" 
                                                                     Background="#FFFFFF" BorderBrush="#E2E8F0" />
                                                            <Button Grid.Column="10" Content="✕" 
                                                                    Command="{Binding DataContext.RemovePinCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                    CommandParameter="{Binding}" 
                                                                    Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" 
                                                                    FontWeight="Bold" FontSize="11" Width="24" Height="24"
                                                                    Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Add Pin Button -->
                            <Button Grid.Row="2" Content="{Binding [ModbusWriteBtnAddPin], Source={x:Static services:LocalizationService.Instance}}" 
                                    Command="{Binding AddPinCommand}"
                                    Style="{StaticResource TiaTactileBtnStyle}"
                                    HorizontalAlignment="Left" FontSize="11" Height="28" Padding="14,4" Margin="0,8,0,0" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT PANE: LIVE HEX TEST & ANALYSIS -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [ModbusWriteTestSection], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" Foreground="#1E293B" FontSize="11" />
                            <TextBlock Text="{Binding [ModbusWriteTestSectionDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Interactive Test Input Card -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- A. Channel-Indexed Test Inputs -->
                                <Grid Visibility="{Binding IsChannelIndexedMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Test Channel & Command -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" ToolTip="{Binding [ModbusWriteSimChTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                            <TextBlock Text="{Binding [ModbusWriteSimChLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding SimChannel, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="26" Padding="4,2" FontSize="11" FontFamily="Consolas" TextAlignment="Center" 
                                                     Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="{Binding [ModbusWriteSimCmdTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                            <TextBlock Text="{Binding [ModbusWriteSimCmdLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding SimCommand, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="26" Padding="4,2" FontSize="11" FontFamily="Consolas" TextAlignment="Center" 
                                                     Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Test Param Hex (RGB color) -->
                                    <StackPanel Grid.Row="2" ToolTip="{Binding [ModbusWriteSimParamTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                        <TextBlock Text="{Binding [ModbusWriteSimParamLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding SimParamHex, UpdateSourceTrigger=PropertyChanged}" 
                                                 Height="26" Padding="4,2" FontSize="11" FontFamily="Consolas" 
                                                 Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- B. Direct Registers Test Inputs -->
                                <Grid Visibility="{Binding IsDirectRegistersMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Test Value -->
                                        <StackPanel Grid.Column="0" ToolTip="{Binding [ModbusWriteSimDirectValTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                            <TextBlock Text="{Binding [ModbusWriteSimDirectValLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding SimDirectValue, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="26" Padding="4,2" FontSize="11" FontFamily="Consolas" TextAlignment="Center" 
                                                     Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                                        </StackPanel>
                                        <!-- Start Address -->
                                        <StackPanel Grid.Column="2" ToolTip="{Binding [ModbusWriteColStartAddrTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                            <TextBlock Text="{Binding [ModbusWriteColStartAddr], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Height="26" CornerRadius="1">
                                                <TextBlock Text="{Binding StartAddress, StringFormat={}0x{0:X4}}" 
                                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#006487" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Text="{Binding NodeInfoSummary}" FontSize="10.5" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Center" />
                                </Grid>

                                <!-- Action Button -->
                                <Button Content="{Binding [ModbusWriteBtnRunTest], Source={x:Static services:LocalizationService.Instance}}" 
                                        Command="{Binding GenerateFramePreviewCommand}"
                                        ToolTip="{Binding [ModbusWriteSimBtnTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                        Style="{StaticResource BtnPrimary}"
                                        Height="28" FontSize="11" Padding="12,4" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Decoded Results Container (Symmetric, Ergonomic Layout) -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <StackPanel Margin="4,0,4,0">
                                    <!-- Status Banner (ISA-101 / TIA Portal Diagnostic Box) -->
                                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="7,5" Margin="0,0,0,6">
                                        <DockPanel LastChildFill="True">
                                            <Border Width="3" Background="#107C41" CornerRadius="1" Margin="0,0,7,0" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding SimStatusMessage}" FontWeight="SemiBold" FontSize="10.5" Foreground="#0F172A" FontFamily="Segoe UI" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Transmitted TX Frame -->
                                    <TextBlock Text="{Binding [ModbusWriteTxFrameLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,3" />

                                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,4"
                                            ToolTip="{Binding [ModbusWriteTxFrameTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                        <TextBlock Text="{Binding SimTxFrameHex}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Optional Param Frame -->
                                    <StackPanel Visibility="{Binding HasParamFrame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding [ModbusWriteTxParamLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2,0,2" />
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="6,4">
                                            <TextBlock Text="{Binding SimParamTxFrameHex}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#006487" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Frame Structure Breakdown -->
                                    <TextBlock Text="{Binding [ModbusWriteParseLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,6,0,4" />

                                    <ItemsControl ItemsSource="{Binding FrameBreakdownItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="6,3" Margin="0,0,0,3"
                                                        ToolTip="{Binding Tooltip}">
                                                    <DockPanel LastChildFill="True">
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FieldName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                                                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                                                    CornerRadius="2" Padding="4,1" Margin="6,0,6,0" VerticalAlignment="Center">
                                                                 <TextBlock Text="{Binding RawHex}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#006487" />
                                                            </Border>
                                                            <TextBlock Text="➔ " FontSize="10.5" Foreground="#94A3B8" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Interpretation}" 
                                                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Footer Action -->
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [ModbusTargetMaster], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="#64748B" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SummaryBadgeText}" 
                                   FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" />
                    </StackPanel>

                    <Button Content="{Binding [ModbusWriteBtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            DockPanel.Dock="Right" Click="Apply_Click"
                            Style="{StaticResource BtnPrimary}"
                            FontSize="11.5" Height="28" Padding="20,4" Margin="8,0,0,0" />
                    <Button Content="{Binding [BtnCancel], Source={x:Static services:LocalizationService.Instance}}" 
                            DockPanel.Dock="Right" Click="Cancel_Click"
                            Style="{StaticResource TiaTactileBtnStyle}"
                            FontSize="11.5" Height="28" Padding="16,4" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
