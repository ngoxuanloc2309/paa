<Window x:Class="SimplePLC.Studio.Views.MathConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
        xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [MathConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="1060" Height="720"
        MinWidth="980" MinHeight="600"
        ResizeMode="CanResizeWithGrip"
        controls:WindowChromeHelper.EnableIndependentMinimize="True"
        Icon="../Assets/app.png"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Industrial Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Two-Column Master-Detail Body -->
            <RowDefinition Height="*" />
            <!-- Row 2: Action Footer Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: INDUSTRIAL HEADER BANNER -->
        <Border Grid.Row="0" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="True">
                <!-- 38x38 Inset Box with IconMathAlu Vector Geometry -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Width="38" Height="38" Margin="0,0,14,0">
                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconMathAlu}" Stroke="{DynamicResource PrimaryBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Current Operation Badge on the Right -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentOpBadge}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [MathConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding [MathConfigDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: TWO-COLUMN MASTER-DETAIL BODY -->
        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <!-- Left Column: Master Settings & Pin Table (1.35*) -->
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="16" />
                <!-- Right Column: Sticky Live ALU Diagnostics & Simulation (380px) -->
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: MASTER SETTINGS & OPERANDS TABLE -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>
                    <!-- CARD 1: GENERAL PARAMETERS -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Card Header -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding [MathConfigGroupGeneral], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding [MathConfigGroupGeneralDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Form Controls: Operator, TypeMode, Output Tag (3 Columns) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <!-- Operator Selector -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [MathConfigFieldOperator], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{x:Static vm:RuleOptions.MathOperators}"
                                              SelectedValue="{Binding Operator}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Height="28" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Data Type Mode Selector -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [MathConfigFieldTypeMode], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{x:Static vm:RuleOptions.MathTypeModes}"
                                              SelectedValue="{Binding TypeMode}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Height="28" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- Target Output Tag OUT Selector -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{Binding [MathConfigFieldOutTag], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableOutputTags}"
                                              SelectedItem="{Binding OutputTag}"
                                              Height="28" VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="TxtTag" Text="{Binding DisplayName}" FontFamily="Consolas" FontSize="11" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter TargetName="TxtTag" Property="Text" Value="{Binding [MathConfigOptNoneTag], Source={x:Static services:LocalizationService.Instance}}" />
                                                        <Setter TargetName="TxtTag" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        <Setter TargetName="TxtTag" Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: INPUT OPERANDS TABLE (IBM Carbon Data Alignment) -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <!-- Card Header & Add Pin Toolbar -->
                            <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" 
                                        Content="{Binding [MathConfigBtnAddPin], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding AddPinCommand}"
                                        IsEnabled="{Binding CanAddPin}"
                                        Style="{StaticResource TiaTactileBtnStyle}"
                                        Height="28" Padding="12,4" FontSize="11" VerticalAlignment="Center" />

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [MathConfigGroupOperands], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding PinCountSummary}" 
                                                   FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding [MathConfigGroupOperandsDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Table Container with Header Strip -->
                            <Border BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Column Headers Strip (Height="28") -->
                                        <RowDefinition Height="28" />
                                        <!-- Rows List -->
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Column Headers Strip -->
                                    <Border Grid.Row="0" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding [MathConfigColIndex], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding [MathConfigColPin], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding [MathConfigColMode], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding [MathConfigColOperand], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="8" Text="{Binding [MathConfigColType], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="10" Text="{Binding [MathConfigColDelete], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Pin Rows -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Pins}" Margin="10,4,10,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="105" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="65" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Index (#) -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Index}" FontFamily="Consolas" FontSize="11" 
                                                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <!-- Pin Label (IN1, IN2...) -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                                    <!-- Mode ComboBox (Tag vs Constant) -->
                                                    <ComboBox Grid.Column="4" SelectedIndex="{Binding IsConstant, Converter={x:Null}}" 
                                                              Height="28" VerticalContentAlignment="Center" FontSize="11">
                                                        <ComboBoxItem Content="{Binding [MathConfigModeTag], Source={x:Static services:LocalizationService.Instance}}" 
                                                                      IsSelected="{Binding IsConstant, Converter={StaticResource InverseBoolToVis}, Mode=OneTime}" />
                                                        <ComboBoxItem Content="{Binding [MathConfigModeConst], Source={x:Static services:LocalizationService.Instance}}" 
                                                                      IsSelected="{Binding IsConstant, Mode=TwoWay}" />
                                                    </ComboBox>

                                                    <!-- Operand Selector / Input: Tag vs Constant -->
                                                    <!-- A) Tag Selector (Strictly ANY_NUM: AvailableNumericTags) -->
                                                    <ComboBox Grid.Column="6" 
                                                              Visibility="{Binding IsConstant, Converter={StaticResource InverseBoolToVis}}"
                                                              ItemsSource="{Binding DataContext.AvailableNumericTags, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Tag}"
                                                              DisplayMemberPath="DisplayName"
                                                              Height="28" VerticalContentAlignment="Center" FontSize="11" />

                                                    <!-- B) Constant Input (LostFocus Auto-Revert / Normalize) -->
                                                    <TextBox Grid.Column="6" 
                                                             Visibility="{Binding IsConstant, Converter={StaticResource BoolToVis}}"
                                                             Text="{Binding ConstantValueText, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="Consolas" FontSize="11.5" Padding="6,2" Height="28" 
                                                             VerticalContentAlignment="Center" TextAlignment="Right"
                                                             services:TextBoxBehaviors.SelectAllOnFocus="True">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Enter" Command="{Binding CommitConstantValueCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>

                                                    <!-- Data Type Badge (REAL / INT32) -->
                                                    <Border Grid.Column="8" Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                                                            BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Height="26" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DataTypeText}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Delete Button -->
                                                    <Button Grid.Column="10" 
                                                            Style="{StaticResource TableRowDeleteBtnStyle}"
                                                            Command="{Binding DataContext.RemovePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanDelete}"
                                                            ToolTip="{Binding [MathConfigColDelete], Source={x:Static services:LocalizationService.Instance}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- Table Footnote -->
                            <TextBlock Text="{Binding [MathConfigTableNote], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT PANE: STICKY LIVE ALU DIAGNOSTICS & SIMULATION (380px) -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <!-- Diagnostics Header -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding [MathConfigDiagTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding [MathConfigDiagSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Section 1: Algebraic Formula Box -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding [MathConfigFormulaTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                <TextBlock Text="{Binding FormulaExpression}" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" 
                                           Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- Section 2: Integrated Live Test Bench Table (Natural Height, Zero Clipping) -->
                        <Border BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Column Headers Strip -->
                                <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,0,0,1" Height="28">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="95" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding [MathConfigColPin], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding [MathConfigColOperand], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding [MathConfigColTestVal], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                    </Grid>
                                </Border>

                                <!-- Dynamic Pin Rows (Display all 2..8 pins cleanly) -->
                                <ItemsControl ItemsSource="{Binding Pins}" Margin="10,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="95" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Pin Label (IN1, IN2...) -->
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                                <!-- Operand Identifier -->
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="11" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <!-- Test Number Input -->
                                                <TextBox Grid.Column="4" Text="{Binding SimulationValue, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontFamily="Consolas" FontSize="11.5" Height="26" Padding="6,2" 
                                                         VerticalContentAlignment="Center" TextAlignment="Right"
                                                         Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}"
                                                         services:TextBoxBehaviors.SelectAllOnFocus="True" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Integrated Live Result Footer Strip (Never Clipped) -->
                                <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Result Value & Title -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [MathConfigAluResultTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding SimulationResultText}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" 
                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                        </StackPanel>

                                        <!-- Right: Validation Badge & Inferred Type -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,0,4" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding InferredTypeDisplayText}" 
                                                       FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: IEC 61131-3 Industrial Rules Banner -->
                        <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysInfo}" Stroke="{DynamicResource PrimaryBrush}" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [MathConfigRuleTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding [MathConfigRuleText], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ROW 2: ACTION FOOTER BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="True">
                <!-- Restore Defaults Button on the Left -->
                <Button Content="{Binding [BtnRestoreDefaults], Source={x:Static services:LocalizationService.Instance}}" 
                        Command="{Binding ResetDefaultsCommand}" 
                        DockPanel.Dock="Left" 
                        Padding="14,6" Height="30" 
                        Style="{StaticResource TiaTactileBtnStyle}" />

                <!-- Cancel and Apply Buttons on the Right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding [BtnCancel], Source={x:Static services:LocalizationService.Instance}}" 
                            Click="Cancel_Click" 
                            IsCancel="True" 
                            Padding="18,6" Height="30" Margin="0,0,10,0" 
                            Style="{StaticResource TiaTactileBtnStyle}" />

                    <Button Content="{Binding [BtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            Click="Apply_Click" 
                            IsDefault="True" 
                            Padding="22,6" Height="30" 
                            Style="{StaticResource BtnPrimary}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
