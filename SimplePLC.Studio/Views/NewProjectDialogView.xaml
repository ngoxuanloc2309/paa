<Window x:Class="SimplePLC.Studio.Views.NewProjectDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
        xmlns:viewmodels="clr-namespace:SimplePLC.Studio.ViewModels"
        xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
        Title="{Binding [NewProjectDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="880" Height="560"
        MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        controls:WindowChromeHelper.EnableIndependentMinimize="True"
        ShowInTaskbar="True"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{DynamicResource BgWindowBrush}"
        Icon="../Assets/app.png"
        FontFamily="Segoe UI, Segoe UI Variable, system-ui"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource BgWindowBrush}">
        <Grid.RowDefinitions>
            <!-- 0. Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- 1. Body Content -->
            <RowDefinition Height="*" />
            <!-- 2. Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Modern Fluent 2 Industrial Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Vector Icon Container -->
                <Border Grid.Column="0" Width="42" Height="42" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconIecProcessIo}" Stroke="{DynamicResource PrimaryBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="1.8" Stretch="Uniform" />
                </Border>

                <!-- Header Typography -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [NewProjectDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding [NewProjectDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Preset Target Badge -->
                <Border Grid.Column="2" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedPreset.DisplayName, TargetNullValue='SYNAPTIX CONTROLLER'}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- 1. Body Content (Left: Config Forms, Right: Hardware Preview) -->
        <Grid Grid.Row="1" Margin="20,14">
            <Grid.ColumnDefinitions>
                <!-- Left: Config inputs -->
                <ColumnDefinition Width="*" />
                <!-- Right: Hardware preview card (380px) -->
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Project Information & Target Hardware Selection -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- SECTION 1: PROJECT INFORMATION -->
                <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [NewProjectSectionInfo], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Project Name -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [NewProjectName], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="30" Padding="8,2" FontSize="12" FontWeight="SemiBold" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,3" VerticalContentAlignment="Center" />

                            <!-- Row 1: Save Location -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [NewProjectLocation], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3" />
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ProjectLocation, UpdateSourceTrigger=PropertyChanged}" 
                                         ToolTip="{Binding ProjectLocation}"
                                         Height="30" Padding="8,2" FontSize="11.5" BorderBrush="{DynamicResource BorderLightBrush}" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="{Binding [NewProjectBrowse], Source={x:Static services:LocalizationService.Instance}}" 
                                        Command="{Binding BrowseLocationCommand}" 
                                        Margin="6,0,0,0" Padding="14,0" Height="30" Style="{StaticResource BtnSecondary}" />
                            </Grid>

                            <!-- Row 2: Author -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [NewProjectAuthor], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="30" Padding="8,2" FontSize="11.5" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,3" VerticalContentAlignment="Center" />

                            <!-- Row 3: Description -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [NewProjectDescription], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" Padding="8,4" FontSize="11.5" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: TARGET HARDWARE -->
                <Border Grid.Row="1" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding [NewProjectSectionHw], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" />

                            <!-- Preset Selection -->
                            <TextBlock Text="{Binding [NewProjectPresetMode], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" 
                                      DisplayMemberPath="DisplayName" Height="30" FontSize="11.5" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,0,0,8" VerticalContentAlignment="Center" />

                            <!-- Preset Target Profile Card -->
                            <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Target Microcontroller:" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedPreset.McuTarget}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Device Family:" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedPreset.DeviceClass}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Detect from Connected MCU Button -->
                            <Button Command="{Binding DetectFromConnectedDeviceCommand}" 
                                    Style="{StaticResource BtnSecondary}"
                                    Height="32" Padding="12,0" HorizontalAlignment="Stretch" Cursor="Hand" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconIecTimerCycle}" Width="13" Height="13" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [NewProjectDetectConnected], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Status Feedback Text -->
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: Hardware Specification Preview Card -->
            <Border Grid.Column="1" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header & Target Info -->
                        <RowDefinition Height="Auto" />
                        <!-- Content Preview (Either Standard PLC or DTU Gateway) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header & Target Info -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding [NewProjectIoSummaryTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{Binding PreviewDeviceName}" 
                                   FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding [NewProjectTargetMcu], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" DockPanel.Dock="Left" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding PreviewMcuTarget}" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </DockPanel>
                        <Separator Margin="0,10,0,6" Background="{DynamicResource BorderLightBrush}" />
                    </StackPanel>

                    <!-- 1. Standard PLC Hardware Matrix (Visible when NOT DTU) -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDtuPresetSelected, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tabular Channel Matrix -->
                        <Grid Grid.Row="0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: DI -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [NewProjectCustomDi], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewDiText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 1: DO -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [NewProjectCustomDo], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewDoText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 2: AI -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [NewProjectCustomAi], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewAiText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 3: VFLAG -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [NewProjectCustomVflag], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviewVflagText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 4: VREG -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [NewProjectCustomVreg], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PreviewVregText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 5: RETAIN -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [NewProjectCustomRetain], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PreviewRetainText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 6: COUNTER -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [NewProjectCustomCounters], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PreviewCountersText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 7: Max Rules -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [NewProjectCustomMaxRules], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PreviewMaxRules, StringFormat='{}{0} rules'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Total Tag Footer -->
                        <Border Grid.Row="1" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,10,0,0" VerticalAlignment="Bottom">
                            <DockPanel>
                                <TextBlock Text="{Binding [NewProjectTotalTags], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding PreviewTotalTags, StringFormat='{}{0} / 128 tags'}" 
                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 2. DTU Gateway Hardware Matrix (Visible when DTU) -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDtuPresetSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tabular Channel Matrix (Exact identical layout & font sizes as Standard PLC) -->
                        <Grid Grid.Row="0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Device Category -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [NewProjectDtuCategoryLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [NewProjectDtuCategoryVal], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 1: RS-485 Serial Port -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [NewProjectDtuSerialLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding [NewProjectDtuSerialVal], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 2: Serial Protocol -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [NewProjectDtuProtoLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding [NewProjectDtuProtoVal], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 3: Uplink Network Interface -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [NewProjectDtuUplinkLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding [NewProjectDtuUplinkVal], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 4: Cloud Protocol -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [NewProjectDtuCloudLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding [NewProjectDtuCloudVal], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 5: Telemetry & Data Format -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [NewProjectDtuPayloadLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding [NewProjectDtuPayloadVal], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 6: Discrete Local I/O -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [NewProjectDtuIoLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding [NewProjectDtuIoVal], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />

                            <!-- Row 7: Diagnostic Registers -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [NewProjectDtuDiagLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding [NewProjectDtuDiagVal], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,0,4" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- DTU Operating Mode Footer (Identical style, font size, border as Standard PLC) -->
                        <Border Grid.Row="1" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,10,0,0" VerticalAlignment="Bottom">
                            <DockPanel>
                                <TextBlock Text="{Binding [NewProjectDtuOperatingLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding [NewProjectDtuOperatingVal], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Footer Action Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{Binding [NewProjectBtnCancel], Source={x:Static services:LocalizationService.Instance}}" 
                            Click="CancelButton_Click" IsCancel="True"
                            Width="95" Height="30" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" />
                    <Button Content="{Binding [NewProjectBtnCreate], Source={x:Static services:LocalizationService.Instance}}" 
                            Click="CreateButton_Click" IsDefault="True"
                            Width="125" Height="30" Style="{StaticResource BtnPrimary}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>