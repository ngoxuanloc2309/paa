                        <!-- Clamping Safety -->
                        <CheckBox IsChecked="{Binding SelectedScaleNode.IsClamped}" Content="{Binding [InspectorScaleClamp], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Margin="0,0,0,6" />
