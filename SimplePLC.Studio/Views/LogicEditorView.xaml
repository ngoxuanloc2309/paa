<UserControl x:Class="SimplePLC.Studio.Views.LogicEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
             xmlns:models="clr-namespace:SimplePLC.Studio.Models"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
             xmlns:views="clr-namespace:SimplePLC.Studio.Views"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />
        <converters:BooleanToVisibilityConverterEx x:Key="EmptyToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />

        <ContextMenu x:Key="ConnectionContextMenu">
            <MenuItem Header="{Binding [MenuDeleteConnection], Source={x:Static services:LocalizationService.Instance}}" 
                      Command="{Binding DataContext.DeleteConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      InputGestureText="Del" />
        </ContextMenu>

        <DataTemplate x:Key="ConnectionTemplate" DataType="{x:Type vm:ConnectionViewModel}">
            <Grid Background="Transparent" 
                  Cursor="Hand"
                  PreviewMouseDown="Connection_PreviewMouseDown"
                  ContextMenu="{StaticResource ConnectionContextMenu}">
                <!-- Vùng bắt dính chuột vô hình dày 12px (Transparent) giúp người dùng click chọn dây cực kỳ dễ dàng -->
                <nodify:StepConnection Source="{Binding Source.Anchor}"
                                       Target="{Binding Target.Anchor}"
                                       SourceOffset="0,0"
                                       TargetOffset="0,0"
                                       ArrowEnds="None"
                                       Stroke="Transparent"
                                       StrokeThickness="12" />
                <!-- Dây hiển thị thực tế: nét liền phẳng chuẩn công nghiệp, đường thẳng hoặc vuông góc 90 độ -->
                <nodify:StepConnection Source="{Binding Source.Anchor}"
                                       Target="{Binding Target.Anchor}"
                                       SourceOffset="0,0"
                                       TargetOffset="0,0"
                                       IsHitTestVisible="False">
                    <nodify:StepConnection.Style>
                        <Style TargetType="{x:Type nodify:StepConnection}">
                            <Setter Property="Stroke" Value="#64748B" />
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="ArrowEnds" Value="None" />
                            <Setter Property="ArrowSize" Value="6,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                    <Setter Property="Stroke" Value="#006487" />
                                    <Setter Property="StrokeThickness" Value="2.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="#006487" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGhost}" Value="True">
                                    <Setter Property="Stroke" Value="#00A389" />
                                    <Setter Property="StrokeThickness" Value="2.5" />
                                    <Setter Property="StrokeDashArray" Value="4 2" />
                                    <Setter Property="Opacity" Value="0.85" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Stroke" Value="#107C41" />
                                    <Setter Property="StrokeThickness" Value="2.5" />
                                    <Setter Property="ArrowEnds" Value="End" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </nodify:StepConnection.Style>
                </nodify:StepConnection>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PendingConnectionTemplate">
            <nodify:PendingConnection Stroke="#006487"
                                      StrokeThickness="2"
                                      EnableSnapping="True"
                                      AllowOnlyConnectors="True" />
        </DataTemplate>

        <!-- Tactile Toolbar Button Style with clear Hover and Pressed feedback -->
        <Style x:Key="TactileToolbarBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#006487" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#DFE3E8" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#004D68" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INDUSTRIAL EXPANDER FOR TOOLBOX CATEGORIES (DIN-RAIL RIBBON STYLE) -->
        <Style x:Key="ToolboxExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="Transparent" Padding="0">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" 
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Content="{TemplateBinding Header}"
                                              Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderRibbon" 
                                                    Background="#F1F5F9" 
                                                    BorderBrush="#CBD5E1" 
                                                    BorderThickness="1" 
                                                    CornerRadius="2" 
                                                    Padding="7,4">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock x:Name="Arrow" Text="▾" FontSize="10" FontWeight="Bold" Foreground="#475569" 
                                                               Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                    <ContentPresenter ContentSource="Content" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderRibbon" Property="Background" Value="#E2E8F0" />
                                                    <Setter TargetName="HeaderRibbon" Property="BorderBrush" Value="#94A3B8" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="Arrow" Property="Text" Value="▸" />
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="#64748B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" 
                                                  Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,3,0,1" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INDUSTRIAL TOOLBOX ITEM CARD STYLE -->
        <Style x:Key="ToolboxCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#94A3B8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveAndCompileCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="265" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT TOOLBOX -->
        <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" 
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,12,8,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header & Quick Search -->
                <StackPanel Grid.Row="0" Margin="0,0,4,10">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="{Binding [ToolboxTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding [ToolboxBlockCount], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#475569" />
                        </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding [ToolboxSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="10.5" Foreground="#64748B" Margin="0,2,0,8" />

                    <!-- Quick Search Box -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" 
                            CornerRadius="3" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="ToolboxWatermarkText" 
                                           Text="{Binding [ToolboxSearchPrompt], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="ToolboxSearchBox" BorderThickness="0" Background="Transparent" 
                                         FontSize="11" VerticalAlignment="Center" TextChanged="ToolboxSearchBox_TextChanged" />
                            </Grid>
                            <Button Grid.Column="2" x:Name="BtnClearToolboxSearch" Content="✕" 
                                    Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="10"
                                    Cursor="Hand" Visibility="Collapsed" Click="BtnClearToolboxSearch_Click" Padding="3,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Scrollable Categories with Smooth Auto-Scroll -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="0,0,4,0">
                    <StackPanel x:Name="ToolboxItemsHost">

                        <!-- Category 1: Core Logic Blocks (Trigger, Guard, Action) -->
                        <Expander Style="{StaticResource ToolboxExpanderStyle}" IsExpanded="True">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="⚡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ToolboxCoreCategory], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                    <Border Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="5,1" HorizontalAlignment="Right" Margin="4,0,0,0">
                                        <TextBlock Text="3" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#475569" />
                                    </Border>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,2,0,0">
                                <!-- Trigger Block -->
                                <Border Tag="Trigger" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxTriggerDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#166534" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="⚡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxTriggerTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxTriggerDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Guard Block -->
                                <Border Tag="Guard" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxGuardDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#B45309" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🛡️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxGuardTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxGuardDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Action Block -->
                                <Border Tag="Action" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxActionDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1D4ED8" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="⚙️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxActionTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxActionDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Category 2: Timer Macros (TON, TOF, TP) -->
                        <Expander Style="{StaticResource ToolboxExpanderStyle}" IsExpanded="True">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="⏳" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ToolboxTimerCategory], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                    <Border Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="5,1" HorizontalAlignment="Right" Margin="4,0,0,0">
                                        <TextBlock Text="3" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#475569" />
                                    </Border>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,2,0,0">
                                <!-- TON Block -->
                                <Border Tag="TON" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxTonDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#4C1D95" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🕒" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxTonTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxTonDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- TOF Block -->
                                <Border Tag="TOF" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxTofDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#4338CA" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="⌛" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxTofTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxTofDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- TP Block -->
                                <Border Tag="TP" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxTpDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#6D28D9" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="📶" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxTpTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxTpDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Category 3: Counter Macros (CTU, CTD) -->
                        <Expander Style="{StaticResource ToolboxExpanderStyle}" IsExpanded="True">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🧮" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ToolboxCounterCategory], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                    <Border Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="5,1" HorizontalAlignment="Right" Margin="4,0,0,0">
                                        <TextBlock Text="2" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#475569" />
                                    </Border>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,2,0,0">
                                <!-- CTU Block -->
                                <Border Tag="CTU" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxCtuDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0F766E" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🔼" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxCtuTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxCtuDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- CTD Block -->
                                <Border Tag="CTD" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxCtdDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#115E59" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🔽" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxCtdTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxCtdDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Category 4: Analog Signal Processing (SCALE) -->
                        <Expander Style="{StaticResource ToolboxExpanderStyle}" IsExpanded="True">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="📊" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ToolboxAnalogCategory], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                    <Border Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="5,1" HorizontalAlignment="Right" Margin="4,0,0,0">
                                        <TextBlock Text="1" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#475569" />
                                    </Border>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,2,0,0">
                                <!-- SCALE Block -->
                                <Border Tag="Scale" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxScaleDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0369A1" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="📈" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxScaleTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxScaleDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Category 5: Input Data Tags (Input) -->
                        <Expander Style="{StaticResource ToolboxExpanderStyle}" IsExpanded="True">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🗂️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ToolboxTagsCategory], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                    <Border Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="5,1" HorizontalAlignment="Right" Margin="4,0,0,0">
                                        <TextBlock Text="1" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#475569" />
                                    </Border>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,2,0,0">
                                <!-- Input Tag Block -->
                                <Border Tag="Input" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxInputDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#64748B" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🏷️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxInputTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxInputDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- Row 2: Fixed Bottom Guide / Tips -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" 
                        Padding="6,6,6,2" Margin="0,6,0,0">
                    <TextBlock Text="{Binding [ToolboxTipFooter], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="13" HorizontalAlignment="Center" TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 2. CENTER NODIFY CANVAS WITH DOCKED TOP SIMULATION TOOLBAR -->
        <Grid Grid.Column="1" Background="#F8FAFC"
              SnapsToDevicePixels="True" UseLayoutRounding="True"
              TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="SimDrawerRow" Height="0" MinHeight="0" MaxHeight="600" />
            </Grid.RowDefinitions>

            <!-- ROW 0: NODIFY CANVAS (UNOBSTRUCTED FULL WORKSPACE) -->
            <Grid Grid.Row="0">
                <Border Visibility="{Binding HasNodes, Converter={StaticResource EmptyToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="2" Padding="24,18" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Logic Graph" FontSize="16" FontWeight="Bold"
                                   Foreground="#0F172A" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding [EmptyCanvasPrompt1], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12" Foreground="#64748B" Margin="0,5,0,0"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding [EmptyCanvasPrompt2], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <nodify:NodifyEditor x:Name="Editor"
                                     ItemsSource="{Binding Nodes}"
                                     Connections="{Binding Connections}"
                                     ConnectionTemplate="{StaticResource ConnectionTemplate}"
                                     PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                                     ConnectionCompletedCommand="{Binding CompleteConnectionCommand}"
                                     DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                     SelectedItems="{Binding SelectedNodes}"
                                     AllowDrop="True"
                                     Drop="NodifyEditor_Drop"
                                     PreviewMouseDown="NodifyEditor_PreviewMouseDown"
                                     Background="#F8FAFC"
                                     Foreground="#E2E8F0"
                                     GridCellSize="1">
                    <nodify:NodifyEditor.ItemContainerStyle>
                        <Style TargetType="{x:Type nodify:ItemContainer}">
                            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding [MenuCut], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.CutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Ctrl+X" />
                                        <MenuItem Header="{Binding [MenuCopy], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Ctrl+C" />
                                        <MenuItem Header="{Binding [MenuPaste], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Ctrl+V" />
                                        <MenuItem Header="{Binding [MenuDuplicate], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Ctrl+D" />
                                        <Separator />
                                        <MenuItem Header="{Binding [MenuDeleteSelected], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.DeleteSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Del" />
                                        <Separator />
                                        <MenuItem Header="{Binding [MenuLayoutAndAlign], Source={x:Static services:LocalizationService.Instance}}">
                                            <MenuItem Header="{Binding [MenuAlignTop], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignTopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Up"
                                                      Icon="⤒" />
                                            <MenuItem Header="{Binding [MenuAlignMiddle], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignMiddleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+M"
                                                      Icon="╌" />
                                            <MenuItem Header="{Binding [MenuAlignBottom], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignBottomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Down"
                                                      Icon="⤓" />
                                            <Separator />
                                            <MenuItem Header="{Binding [MenuAlignLeft], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Left"
                                                      Icon="⇤" />
                                            <MenuItem Header="{Binding [MenuAlignCenter], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignCenterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+C"
                                                      Icon="┆" />
                                            <MenuItem Header="{Binding [MenuAlignRight], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Right"
                                                      Icon="⇥" />
                                            <Separator />
                                            <MenuItem Header="{Binding [MenuDistributeHorizontal], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.DistributeNodesHorizontallyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Shift+H"
                                                      Icon="⫸" />
                                            <MenuItem Header="{Binding [MenuDistributeVertical], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.DistributeNodesVerticallyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Shift+V"
                                                      Icon="⫶" />
                                            <Separator />
                                            <MenuItem Header="{Binding [MenuSnapToGrid], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.SnapAllNodesToGridCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+G"
                                                      Icon="⌗" />
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="PreviewMouseDown" Handler="ItemContainer_PreviewMouseDown" />
                            <EventSetter Event="PreviewMouseUp" Handler="ItemContainer_PreviewMouseUp" />
                        </Style>
                    </nodify:NodifyEditor.ItemContainerStyle>
                    <nodify:NodifyEditor.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding [ToolUndo], Source={x:Static services:LocalizationService.Instance}}" 
                                      Command="{Binding UndoCommand}"
                                      InputGestureText="Ctrl+Z" />
                            <MenuItem Header="{Binding [ToolRedo], Source={x:Static services:LocalizationService.Instance}}" 
                                      Command="{Binding RedoCommand}"
                                      InputGestureText="Ctrl+Y" />
                            <Separator />
                            <MenuItem Header="{Binding [MenuPaste], Source={x:Static services:LocalizationService.Instance}}" 
                                      Command="{Binding PasteCommand}"
                                      InputGestureText="Ctrl+V" />
                            <MenuItem Header="{Binding [MenuSelectAll], Source={x:Static services:LocalizationService.Instance}}" 
                                      Command="{Binding SelectAllCommand}"
                                      InputGestureText="Ctrl+A" />
                            <Separator />
                            <MenuItem Header="{Binding [MenuLayoutAndAlign], Source={x:Static services:LocalizationService.Instance}}">
                                <MenuItem Header="{Binding [MenuAlignTop], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignTopCommand}"
                                          InputGestureText="Alt+Up"
                                          Icon="⤒" />
                                <MenuItem Header="{Binding [MenuAlignMiddle], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignMiddleCommand}"
                                          InputGestureText="Alt+M"
                                          Icon="╌" />
                                <MenuItem Header="{Binding [MenuAlignBottom], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignBottomCommand}"
                                          InputGestureText="Alt+Down"
                                          Icon="⤓" />
                                <Separator />
                                <MenuItem Header="{Binding [MenuAlignLeft], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignLeftCommand}"
                                          InputGestureText="Alt+Left"
                                          Icon="⇤" />
                                <MenuItem Header="{Binding [MenuAlignCenter], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignCenterCommand}"
                                          InputGestureText="Alt+C"
                                          Icon="┆" />
                                <MenuItem Header="{Binding [MenuAlignRight], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignRightCommand}"
                                          InputGestureText="Alt+Right"
                                          Icon="⇥" />
                                <Separator />
                                <MenuItem Header="{Binding [MenuDistributeHorizontal], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding DistributeNodesHorizontallyCommand}"
                                          InputGestureText="Alt+Shift+H"
                                          Icon="⫸" />
                                <MenuItem Header="{Binding [MenuDistributeVertical], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding DistributeNodesVerticallyCommand}"
                                          InputGestureText="Alt+Shift+V"
                                          Icon="⫶" />
                                <Separator />
                                <MenuItem Header="{Binding [MenuSnapToGrid], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding SnapAllNodesToGridCommand}"
                                          InputGestureText="Alt+G"
                                          Icon="⌗" />
                            </MenuItem>
                        </ContextMenu>
                    </nodify:NodifyEditor.ContextMenu>
                </nodify:NodifyEditor>

                <!-- Floating AI Proposal Action Bar (Layer 5: Human Affirmation Gate) -->
                <Border Visibility="{Binding HasPendingAiProposal, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                        Background="#FFFFFF" BorderBrush="#006487" BorderThickness="1.5"
                        CornerRadius="4" Padding="14,8" Panel.ZIndex="1000">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🤖 " FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AiProposalSummaryText}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,12,0" />
                        
                        <!-- Safety Badge -->
                        <Border Background="#E6F4EA" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,12,0">
                            <TextBlock Text="✓ An toàn: 0 xung đột ghi" FontSize="10.5" FontWeight="SemiBold" Foreground="#0E6B37" />
                        </Border>

                        <!-- Accept Button -->
                        <Button Command="{Binding AcceptAiProposalCommand}" Background="#107C41" Foreground="#FFFFFF"
                                Padding="12,4" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,6,0" Cursor="Hand"
                                Content="✓ Chấp nhận (Accept)" />

                        <!-- Reject Button -->
                        <Button Command="{Binding RejectAiProposalCommand}" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="10,4" FontSize="11.5" Foreground="#475569" Cursor="Hand"
                                Content="✕ Hủy bỏ (Reject)" />
                    </StackPanel>
                </Border>

                <!-- Gate Warning Popup Toast (Bottom-Right, Auto-dismiss 3.5s or ✕ close, non-intrusive industrial design) -->
                <Border Visibility="{Binding ShowSimGateToast, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20"
                        Background="#FEF2F2" BorderBrush="#DC2626" BorderThickness="1.5"
                        CornerRadius="3" Padding="12,9" Panel.ZIndex="1050">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SimGateWarning}" Foreground="#991B1B" FontWeight="SemiBold" FontSize="11.5" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="✕" Command="{Binding DismissSimGateToastCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#DC2626" Opacity="0.8" FontWeight="Bold" FontSize="11.5" Cursor="Hand" VerticalAlignment="Center" Padding="4,2" />
                    </StackPanel>
                </Border>

                <!-- Save Confirmation Toast Notification (Bottom-Right, non-intrusive, industrial theme) -->
                <Border Visibility="{Binding ShowSaveToast, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16"
                        Background="#E6F4EA" BorderBrush="#107C41" BorderThickness="1"
                        CornerRadius="2" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontWeight="Bold" Foreground="#107C41" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SaveToastMessage}" FontWeight="SemiBold" Foreground="#107C41" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{Binding [ToastViewRuleTable], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ViewRuleTableCommand}"
                                Background="#FFFFFF" Foreground="#107C41" BorderBrush="#107C41" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="10.5" Padding="8,3" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ToastBtnBdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToastBtnBdr" Property="Background" Value="#F8F9FA" />
                                            <Setter TargetName="ToastBtnBdr" Property="BorderBrush" Value="#0B5A2F" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ToastBtnBdr" Property="Background" Value="#DFE3E8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="✕" Command="{Binding DismissToastCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#107C41" Opacity="0.75" FontWeight="Bold" FontSize="11" Cursor="Hand" VerticalAlignment="Center" Padding="4,2" />
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ROW 1: GRID SPLITTER FOR RESIZING SIMULATION DRAWER -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="#CBD5E1" ShowsPreview="False" Cursor="SizeNS"
                          Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}" />

            <!-- ROW 2: INDUSTRIAL SIMULATION TEST BENCH & DIAGNOSTICS DRAWER (LIGHT SLATE THEME) -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0"
                    SnapsToDevicePixels="True" UseLayoutRounding="True"
                    VerticalAlignment="Stretch"
                    Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <!-- Drawer Header: Industrial Simulation Console Toolbar -->
                    <Border DockPanel.Dock="Top" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Status Pill, Clocks, Primary Controls, Filter & Tools (Flat Compact Bar, No Scrollbar) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Running / Paused Pill -->
                                <Border CornerRadius="2" Padding="6,2.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E2E8F0" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSimRunning}" Value="True">
                                                    <Setter Property="Background" Value="#E6F4EA" />
                                                    <Setter Property="BorderBrush" Value="#107C41" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6.5" Height="6.5" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#64748B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSimRunning}" Value="True">
                                                            <Setter Property="Fill" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SimRunStatusText}" FontSize="9.5" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSimRunning}" Value="True">
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Scan Counter & Cycle Details -->
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="5,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="#" FontSize="9" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding SimScanNumber}" FontSize="10.5" FontWeight="Bold" Foreground="#0F172A" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SimElapsedMs, StringFormat='{}{0}ms'}" FontSize="10" FontWeight="SemiBold" Foreground="#475569" FontFamily="Consolas" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Gate Alert Pill -->
                                <Border Background="#FEF2F2" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="5,2" VerticalAlignment="Center" Margin="0,0,6,0"
                                        Visibility="{Binding HasSimGateWarning, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SimGateWarning}" FontSize="9.5" FontWeight="SemiBold" Foreground="#B91C1C" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons: Step, Auto-Run/Pause, Reset -->
                                <Button Command="{Binding StepSimScanCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Padding="7,3" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="{Binding [SimStepTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⏭" FontSize="10" Foreground="#0F766E" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [SimBarStep], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ToggleSimPlayPauseCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Padding="7,3" Margin="0,0,5,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SimPlayPauseIcon}" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#107C41" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSimRunning}" Value="True">
                                                            <Setter Property="Foreground" Value="#D97706" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SimPlayPauseButtonText}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Speed Selector ComboBox -->
                                <ComboBox ItemsSource="{Binding SimSpeedOptions}"
                                          SelectedItem="{Binding SelectedSimSpeed}"
                                          DisplayMemberPath="DisplayText"
                                          Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1"
                                          FontSize="10" FontFamily="Segoe UI" FontWeight="Medium"
                                          Padding="4,2" Width="78" VerticalAlignment="Center" Margin="0,0,4,0"
                                          ToolTip="{Binding [SimBarSpeed], Source={x:Static services:LocalizationService.Instance}}" />

                                <!-- Reset Button -->
                                <Button Command="{Binding ResetSimCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#475569"
                                        FontWeight="Medium" FontSize="10" FontFamily="Segoe UI"
                                        Padding="7,3" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="{Binding [SimResetTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [SimBtnResetPlc], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Separator -->
                                <Border Width="1" Height="16" Background="#CBD5E1" Margin="3,0,5,0" VerticalAlignment="Center" />

                                <!-- Filter Changed Scans Only Checkbox -->
                                <CheckBox IsChecked="{Binding FilterChangedScansOnly}"
                                          Content="{Binding [SimFilterChanged], Source={x:Static services:LocalizationService.Instance}}"
                                          VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10" Foreground="#334155"
                                          Cursor="Hand" ToolTip="{Binding [SimFilterTip], Source={x:Static services:LocalizationService.Instance}}" />

                                <!-- Clear Scan Log Button -->
                                <Button Command="{Binding ClearScanLogCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#64748B"
                                        FontWeight="Medium" FontSize="10" FontFamily="Segoe UI"
                                        Padding="6,3" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="{Binding [SimClearTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🗑" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [SimBtnClearLog], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Toggle Virtual I/O Board Button -->
                                <Button Command="{Binding ToggleVirtualIoBoardCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#1E3A8A"
                                        FontWeight="Medium" FontSize="10" FontFamily="Segoe UI"
                                        Padding="7,3" Margin="2,0,0,0" Cursor="Hand"
                                        ToolTip="{Binding [VirtualIoToggleTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎛️" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [VirtualIoBoardBtn], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Right Controls: History Count & Exit Simulation (Always Visible, Never Overlapped) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding [SimTotalCycles], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontFamily="Consolas" Foreground="#64748B" />
                                    <TextBlock Text=": " FontSize="10.5" FontFamily="Consolas" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SimScanHistory.Count}" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#64748B" />
                                </StackPanel>

                                <!-- Exit Simulation Button -->
                                <Button Command="{Binding StopSimulationCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Background="#FEE2E2" BorderBrush="#B91C1C" Foreground="#B91C1C"
                                        FontWeight="SemiBold" FontSize="11" FontFamily="Segoe UI"
                                        Padding="10,4" Cursor="Hand"
                                        ToolTip="{Binding [SimExitTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✕" FontSize="10.5" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [SimBarStop], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content Area: Master-Detail Layout -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="350" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 0: MASTER SCAN HISTORY TABLE -->
                        <Grid Grid.Column="0">
                            <!-- Empty History Hint -->
                            <TextBlock Text="{Binding [SimEmptyHistory], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="#64748B" FontSize="11" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SimScanHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Data Table of Scans with Custom Header and Alternating Rows -->
                            <ListView ItemsSource="{Binding FilteredSimScanHistory}"
                                      SelectedItem="{Binding SelectedScanItem, Mode=TwoWay}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0"
                                      Foreground="#0F172A" FontFamily="Segoe UI" FontSize="11"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.Resources>
                                    <!-- Explicit GridViewColumnHeader style to eliminate white glare -->
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                        <Setter Property="Foreground" Value="#475569" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="10.5" />
                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="6,3" />
                                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E0F2FE" />
                                                <Setter Property="BorderBrush" Value="#38BDF8" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                         <GridViewColumn Header="{Binding [SimColScan], Source={x:Static services:LocalizationService.Instance}}" Width="65">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding ScanDisplay}" FontWeight="Bold" FontFamily="Consolas" Foreground="#006487" />
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColTime], Source={x:Static services:LocalizationService.Instance}}" Width="75">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding TimeDisplay}" FontFamily="Consolas" Foreground="#64748B" />
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColEvent], Source={x:Static services:LocalizationService.Instance}}" Width="85">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <Border CornerRadius="2" Padding="4,1" HorizontalAlignment="Left">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#F1F5F9" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding ActionFired}" Value="True">
                                                                         <Setter Property="Background" Value="#DFE3E8" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding GuardStatus}" Value="BLOCKED">
                                                                         <Setter Property="Background" Value="#FEE2E2" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding TriggerPassed}" Value="True">
                                                                         <Setter Property="Background" Value="#DFE3E8" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="{Binding ActivityBadgeText}" FontSize="9.5" FontWeight="Bold">
                                                             <TextBlock.Style>
                                                                 <Style TargetType="TextBlock">
                                                                     <Setter Property="Foreground" Value="#64748B" />
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding ActionFired}" Value="True">
                                                                             <Setter Property="Foreground" Value="#006487" />
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding GuardStatus}" Value="BLOCKED">
                                                                             <Setter Property="Foreground" Value="#B91C1C" />
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding TriggerPassed}" Value="True">
                                                                             <Setter Property="Foreground" Value="#006487" />
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </TextBlock.Style>
                                                         </TextBlock>
                                                     </Border>
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColInput], Source={x:Static services:LocalizationService.Instance}}" Width="130">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding InputChange}" FontWeight="Medium" FontFamily="Consolas" Foreground="#0F172A" />
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColTrigger], Source={x:Static services:LocalizationService.Instance}}" Width="180">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <StackPanel Orientation="Horizontal">
                                                         <TextBlock Text="{Binding TriggerResult}" FontWeight="Bold" Margin="0,0,6,0">
                                                             <TextBlock.Style>
                                                                 <Style TargetType="TextBlock">
                                                                     <Setter Property="Foreground" Value="#64748B" />
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding TriggerPassed}" Value="True">
                                                                             <Setter Property="Foreground" Value="#107C41" />
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </TextBlock.Style>
                                                         </TextBlock>
                                                         <TextBlock Text="{Binding TriggerReason}" Foreground="#475569" TextTrimming="CharacterEllipsis" MaxWidth="125" />
                                                     </StackPanel>
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColGuard], Source={x:Static services:LocalizationService.Instance}}" Width="130">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding GuardReason}" FontWeight="Medium">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding GuardPassed}" Value="True">
                                                                         <Setter Property="Foreground" Value="#107C41" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding GuardStatus}" Value="BLOCKED">
                                                                         <Setter Property="Foreground" Value="#B91C1C" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColAction], Source={x:Static services:LocalizationService.Instance}}" Width="130">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding OutputDelta}" FontWeight="Bold" FontFamily="Consolas">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding ActionFired}" Value="True">
                                                                         <Setter Property="Foreground" Value="#4C1D95" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColDwell], Source={x:Static services:LocalizationService.Instance}}" Width="90">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding DwellStatus}" Foreground="#D97706" FontFamily="Consolas" />
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                     </GridView>
                                 </ListView.View>
                             </ListView>
                         </Grid>

                         <!-- SPLITTER -->
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#CBD5E1" ResizeDirection="Columns" />

                        <!-- COLUMN 2: SNAPSHOT DETAIL INSPECTOR (DETAIL PANEL) -->
                        <Border Grid.Column="2" Background="#F8FAFC" Padding="12,8">
                             <ScrollViewer VerticalScrollBarVisibility="Auto">
                                 <StackPanel>
                                     <!-- Empty state when no scan selected -->
                                     <TextBlock Text="{Binding [SimSelectRowHint], Source={x:Static services:LocalizationService.Instance}}"
                                                Foreground="#94A3B8" FontSize="11" FontStyle="Italic"
                                                HorizontalAlignment="Center" Margin="0,40,0,0">
                                         <TextBlock.Style>
                                             <Style TargetType="TextBlock">
                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding SelectedScanItem}" Value="{x:Null}">
                                                         <Setter Property="Visibility" Value="Visible" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </TextBlock.Style>
                                     </TextBlock>

                                     <!-- Content when a scan is selected -->
                                     <StackPanel>
                                         <StackPanel.Style>
                                             <Style TargetType="StackPanel">
                                                 <Setter Property="Visibility" Value="Visible" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding SelectedScanItem}" Value="{x:Null}">
                                                         <Setter Property="Visibility" Value="Collapsed" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </StackPanel.Style>

                                         <!-- Header of Snapshot -->
                                         <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                             <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                 <TextBlock Text="{Binding [SimDetailTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                 <TextBlock Text="{Binding SelectedScanItem.ScanDisplay}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Foreground="#006487" VerticalAlignment="Center" />
                                             </StackPanel>
                                             <TextBlock Text="{Binding SelectedScanItem.TimeDisplay, StringFormat='{}T = {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#64748B" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                         </DockPanel>

                                         <!-- Card 1: Ngõ vào -->
                                         <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,6">
                                             <StackPanel>
                                                 <TextBlock Text="{Binding [SimDetailInput], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                                                 <TextBlock Text="{Binding SelectedScanItem.InputChange}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                                             </StackPanel>
                                         </Border>

                                         <!-- Card 2: Kích hoạt -->
                                         <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,6">
                                             <StackPanel>
                                                 <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                                     <TextBlock Text="{Binding [SimDetailTrigger], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                     <TextBlock Text="{Binding SelectedScanItem.TriggerResult}" FontWeight="Bold" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding SelectedScanItem.TriggerPassed}" Value="True">
                                                                         <Setter Property="Foreground" Value="#107C41" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DockPanel>
                                                 <TextBlock Text="{Binding SelectedScanItem.TriggerReason}" FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" />
                                             </StackPanel>
                                         </Border>

                                         <!-- Card 3: Khóa liên động -->
                                         <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,6">
                                             <StackPanel>
                                                 <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                                     <TextBlock Text="{Binding [SimDetailGuard], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                     <TextBlock Text="{Binding SelectedScanItem.GuardStatus}" FontWeight="Bold" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding SelectedScanItem.GuardPassed}" Value="True">
                                                                         <Setter Property="Foreground" Value="#107C41" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding SelectedScanItem.GuardStatus}" Value="BLOCKED">
                                                                         <Setter Property="Foreground" Value="#B91C1C" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DockPanel>
                                                 <TextBlock Text="{Binding SelectedScanItem.GuardReason}" FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" />
                                             </StackPanel>
                                         </Border>

                                         <!-- Card 4: Lệnh xuất -->
                                         <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6">
                                             <StackPanel>
                                                 <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                                     <TextBlock Text="{Binding [SimDetailAction], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                     <TextBlock Text="{Binding SelectedScanItem.ActionStatus}" FontWeight="Bold" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding SelectedScanItem.ActionFired}" Value="True">
                                                                         <Setter Property="Foreground" Value="#006487" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DockPanel>
                                                 <TextBlock Text="{Binding SelectedScanItem.ActionDetails}" FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" />
                                                 <TextBlock FontSize="10" Foreground="#D97706" Margin="0,2,0,0">
                                                     <Run Text="{Binding [SimDetailDwell], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding SelectedScanItem.DwellStatus, Mode=OneWay}" />
                                                 </TextBlock>
                                             </StackPanel>
                                         </Border>
                                     </StackPanel>
                                 </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 3. RIGHT INSPECTOR / PROPERTIES -->
        <Border Grid.Column="2" Background="{StaticResource BgPanelBrush}" 
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="{Binding [InspectorTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding [InspectorSubtitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,14" />

                    <!-- 1. SIMULATION MODE: LIVE I/O WATCH & FORCE TABLE (SHOWN WHEN NO NODE SELECTED) -->
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedNode}" Value="{x:Null}" />
                                            <Condition Binding="{Binding IsSimulationMode}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Panel Header Card -->
                        <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding [SimWatchTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#1E293B" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding [SimWatchBadge], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#006487" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <TextBlock Text="{Binding [SimWatchHint], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#64748B" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Group 1: Discrete & Analog Inputs -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [SimWatchInputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#475569" DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding CanvasInputNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                        <TextBlock Text=" " FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding [SimWatchInputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#94A3B8" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding CanvasInputNodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,4">
                                                <DockPanel LastChildFill="True">
                                                    <!-- Left: Tag Name & Alias -->
                                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TagCode}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="#0F172A" />
                                                            <TextBlock Text="{Binding TagKindText, StringFormat=' ({0})'}" FontSize="10" Foreground="#64748B" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TagDescriptionText}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="105" />
                                                    </StackPanel>

                                                    <!-- Right: Interactive Control -->
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <!-- Digital Input Button -->
                                                        <Button Command="{Binding DataContext.ToggleSimInputNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="8,3" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Cursor="Hand">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource TactileToolbarBtnStyle}">
                                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag.IsDigital}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag.Value}" Value="1">
                                                                            <Setter Property="Background" Value="#E6F4EA" />
                                                                            <Setter Property="Foreground" Value="#107C41" />
                                                                            <Setter Property="BorderBrush" Value="#107C41" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="{Binding SimButtonContent}" />
                                                        </Button>

                                                        <!-- Analog Stepper -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag.IsDigital}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Button Content="-" Command="{Binding DataContext.DecrementSimAnalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="6,2" FontSize="11" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" />
                                                                    <TextBlock Text="{Binding Tag.Value}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="4,0" Width="36" TextAlignment="Center" />
                                                            <Button Content="+" Command="{Binding DataContext.IncrementSimAnalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="6,2" FontSize="11" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Outputs (DO) Monitor -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [SimWatchOutputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#475569" DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding CanvasActionNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                        <TextBlock Text=" " FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding [SimWatchOutputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#94A3B8" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding CanvasActionNodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,4">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ActionExpression}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="#0F172A" />
                                                        <TextBlock Text="{Binding TargetTagShortText}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="2" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F1F5F9" />
                                                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSimFired}" Value="True">
                                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                                        <Setter Property="BorderBrush" Value="#107C41" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding SimLedStatusText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSimFired}" Value="True">
                                                                            <Setter Property="Foreground" Value="#0E6B37" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. DESIGN MODE PLACEHOLDER (SHOWN ONLY WHEN NO NODE SELECTED AND NOT IN SIMULATION) -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="20,24" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedNode}" Value="{x:Null}" />
                                            <Condition Binding="{Binding IsSimulationMode}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👆" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding [InspectorNoSelectionTitle], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding [InspectorNoSelectionDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" LineHeight="16" />
                        </StackPanel>
                    </Border>

                    <!-- TRIGGER NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedTriggerNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorTriggerSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#107C41" FontSize="12" />
                        </Border>

                        <!-- SIMULATION TRIGGER STATUS CARD -->
                        <Border Background="#E6F4EA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding [InspectorSimTriggerStatus], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#107C41" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <Border CornerRadius="2" Padding="6,2" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTriggerNode.IsSimTriggered}" Value="True">
                                                    <Setter Property="Background" Value="#E6F4EA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedTriggerNode.SimStatusText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTriggerNode.IsSimTriggered}" Value="True">
                                                        <Setter Property="Foreground" Value="#107C41" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{Binding [InspectorTriggerType], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{x:Static vm:RuleOptions.TriggerTypes}"
                                  SelectedValue="{Binding SelectedTriggerNode.TriggerType}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <!-- GIAO DIỆN CẤU HÌNH THỜI GIAN THỰC (RTC CLOCK / TIME OF DAY) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10"
                                Visibility="{Binding SelectedTriggerNode.IsTimeTrigger, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding [InspectorTimeMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6" />
                                
                                <RadioButton GroupName="RtcTimeMode" IsChecked="{Binding SelectedTriggerNode.IsTimePointInTime}" Content="{Binding [InspectorTimeModePoint], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Margin="0,0,0,4" />
                                <RadioButton GroupName="RtcTimeMode" IsChecked="{Binding SelectedTriggerNode.IsTimeWindowRange}" Content="{Binding [InspectorTimeModeWindow], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Margin="0,0,0,8" />

                                <Separator Background="#E2E8F0" Margin="0,0,0,8" />

                                <!-- Chế độ Mốc thời gian (At Time) -->
                                <StackPanel Visibility="{Binding SelectedTriggerNode.IsTimePointInTime, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [InspectorTimeAt], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeStartHour, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text=":" FontSize="13" FontWeight="Bold" Margin="4,2" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeStartMinute, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text="{Binding SelectedTriggerNode.TimeStartFormatted, StringFormat='{} ({0})'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Chế độ Khung thời gian (Time Window) -->
                                <StackPanel Visibility="{Binding SelectedTriggerNode.IsTimeWindowRange, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [InspectorTimeStart], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeStartHour, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text=":" FontSize="13" FontWeight="Bold" Margin="4,2" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeStartMinute, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text="{Binding SelectedTriggerNode.TimeStartFormatted, StringFormat='{} ({0})'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding [InspectorTimeEnd], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeEndHour, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text=":" FontSize="13" FontWeight="Bold" Margin="4,2" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeEndMinute, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text="{Binding SelectedTriggerNode.TimeEndFormatted, StringFormat='{} ({0})'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- CÁC THUỘC TÍNH SO SÁNH TIÊU CHUẨN (ẨN KHI LÀ TIME TRIGGER) -->
                        <StackPanel Visibility="{Binding SelectedTriggerNode.IsTimeTrigger, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{Binding [InspectorCompareOp], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:RuleOptions.CompareOps}"
                                      SelectedValue="{Binding SelectedTriggerNode.CompareOp}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,10" />

                            <!-- Ngưỡng so sánh (Ẩn khi None, tự đổi nhãn theo phép toán) -->
                            <StackPanel Visibility="{Binding SelectedTriggerNode.HasComparison, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedTriggerNode.ThresholdPromptText}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedTriggerNode.ThresholdLo, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />
                            </StackPanel>

                            <!-- Ngưỡng trên (CHỈ HIỂN THỊ KHI SO SÁNH TRONG KHOẢNG BETWEEN) -->
                            <StackPanel Visibility="{Binding SelectedTriggerNode.IsRangeComparison, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [InspectorThresholdHi], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedTriggerNode.ThresholdHi, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />
                            </StackPanel>

                            <TextBlock Text="{Binding [InspectorDwellTime], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedTriggerNode.ForMs, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />
                        </StackPanel>
                    </StackPanel>

                    <!-- GUARD NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedGuardNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorGuardSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#C05621" FontSize="12" />
                        </Border>

                        <!-- CẢNH BÁO NẾU CHỌN TAG KHÔNG PHẢI BOOLEAN -->
                        <Border Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,10"
                                Visibility="{Binding SelectedGuardNode.IsInvalidTagType, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [InspectorGuardTagWarning], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" Foreground="#991B1B" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- SIMULATION GUARD INTERACTIVE CARD -->
                        <Border Background="#FEF3C7" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorSimGuardTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#92400E" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Border CornerRadius="3" Padding="6,1.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF2F2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGuardNode.IsSimPassed}" Value="True">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedGuardNode.SimStatusText}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGuardNode.IsSimPassed}" Value="True">
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <!-- Tag info & value -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding SelectedGuardNode.GuardTag.DisplayName, StringFormat='{}Tag: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#475569" DockPanel.Dock="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    <TextBlock Text="{Binding SelectedGuardNode.GuardTag.Value, StringFormat='{}Giá trị: {0}'}" FontWeight="Bold" FontFamily="Consolas" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Toggle Button for Digital Guard Tag -->
                                <Button Command="{Binding ToggleSimTagCommand}" CommandParameter="{Binding SelectedGuardNode.GuardTag}"
                                        Padding="8,4" FontSize="10.5" FontWeight="Bold" Cursor="Hand" Margin="0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TactileToolbarBtnStyle}">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGuardNode.GuardTag.IsDigital}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedGuardNode.GuardTag.Value}" Value="1">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                    <Setter Property="Foreground" Value="#C05621" />
                                                    <Setter Property="BorderBrush" Value="#C05621" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding [InspectorSimToggleTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedGuardNode.SimButtonContent}" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [InspectorGuardTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TagCatalog.DigitalTags}"
                                  SelectedItem="{Binding SelectedGuardNode.GuardTag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorGuardTagAlias], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedGuardNode.GuardTag.Alias, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <CheckBox IsChecked="{Binding SelectedGuardNode.Negate}" Content="{Binding [InspectorInvertCondition], Source={x:Static services:LocalizationService.Instance}}" Margin="0,4,0,10" />
                    </StackPanel>

                    <!-- ACTION NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedActionNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorActionSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#006487" FontSize="12" />
                        </Border>

                        <!-- SIMULATION ACTION STATUS CARD -->
                        <Border Background="#DFE3E8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorSimActionStatus], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#006487" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Border CornerRadius="3" Padding="6,1.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedActionNode.IsSimFired}" Value="True">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedActionNode.SimStatusText}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedActionNode.IsSimFired}" Value="True">
                                                            <Setter Property="Foreground" Value="#0E6B37" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock Text="{Binding SelectedActionNode.TargetTag.DisplayName, StringFormat='{}Tag: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#334155" DockPanel.Dock="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    <TextBlock Text="{Binding SelectedActionNode.TargetTag.Value, StringFormat='{}Giá trị: {0}'}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="#1D4ED8" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [InspectorActionType], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{x:Static vm:RuleOptions.ActionTypes}"
                                  SelectedValue="{Binding SelectedActionNode.ActionType}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorTargetTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TagCatalog.AllTags}"
                                  SelectedItem="{Binding SelectedActionNode.TargetTag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorTargetTagAlias], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedActionNode.TargetTag.Alias, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorActionParam], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedActionNode.ActionParam, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />
                    </StackPanel>

                    <!-- TIMER NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedTimerNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#EDE9FE" BorderBrush="#4C1D95" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorTimerSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#4C1D95" FontSize="12" />
                        </Border>

                        <!-- Custom Node Label -->
                        <TextBlock Text="{Binding [InspectorNodeLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedTimerNode.CustomLabel, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Timer Mode: TON / TOF / TP -->
                        <TextBlock Text="{Binding [InspectorTimerMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox SelectedValue="{Binding SelectedTimerNode.TimerMode}"
                                  SelectedValuePath="Tag"
                                  Margin="0,0,0,10">
                            <ComboBoxItem Content="TON — On-Delay Timer" Tag="TON" />
                            <ComboBoxItem Content="TOF — Off-Delay Timer" Tag="TOF" />
                            <ComboBoxItem Content="TP — Pulse Timer" Tag="TP" />
                        </ComboBox>

                        <!-- Preset Time PT (ms) -->
                        <TextBlock Text="{Binding [InspectorPresetMs], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedTimerNode.PresetMs, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Output Tag Q (DO or VFLAG) -->
                        <TextBlock Text="{Binding [InspectorOutputTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TagCatalog.OutputDigitalTags}"
                                  SelectedItem="{Binding SelectedTimerNode.OutputTag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,4" />
                        <TextBlock Text="{Binding [InspectorOutputTagHint], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,10" />
                    </StackPanel>

                    <!-- COUNTER NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedCounterNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#ECFDF5" BorderBrush="#059669" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorCounterSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#059669" FontSize="12" />
                        </Border>

                        <!-- Custom Node Label -->
                        <TextBlock Text="{Binding [InspectorNodeLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedCounterNode.CustomLabel, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Counter Mode: CTU / CTD -->
                        <TextBlock Text="{Binding [InspectorCounterMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox SelectedValue="{Binding SelectedCounterNode.CounterMode}"
                                  SelectedValuePath="Tag"
                                  Margin="0,0,0,10">
                            <ComboBoxItem Content="CTU — Count Up (Đếm tiến)" Tag="CTU" />
                            <ComboBoxItem Content="CTD — Count Down (Đếm lùi)" Tag="CTD" />
                        </ComboBox>

                        <!-- Preset Value PV -->
                        <TextBlock Text="{Binding [InspectorPresetValue], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedCounterNode.PresetValue, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Output Tag Q (DO or VFLAG) -->
                        <TextBlock Text="{Binding [InspectorOutputTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TagCatalog.OutputDigitalTags}"
                                  SelectedItem="{Binding SelectedCounterNode.OutputTag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,4" />
                        <TextBlock Text="{Binding [InspectorCounterOutputTagHint], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,10" />

                        <!-- Storage Register CV (Advanced Collapsible) -->
                        <Expander Header="{Binding [InspectorCounterAdvancedCv], Source={x:Static services:LocalizationService.Instance}}" IsExpanded="False" Margin="0,4,0,10">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding [InspectorCvTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding TagCatalog.RegisterTags}"
                                          SelectedItem="{Binding SelectedCounterNode.CvTag}"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,0,6" />
                                <TextBlock Text="{Binding [InspectorCvTagHint], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="15" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- SCALE NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedScaleNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorScaleSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#0284C7" FontSize="12" />
                        </Border>

                        <!-- Custom Node Label -->
                        <TextBlock Text="{Binding [InspectorNodeLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedScaleNode.CustomLabel, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Gain & Offset -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [InspectorScaleGain], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedScaleNode.Gain, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [InspectorScaleOffset], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedScaleNode.Offset, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                        </Grid>

                        <!-- Unit & Decimal Places -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [InspectorScaleUnit], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedScaleNode.Unit, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [InspectorScaleDecimals], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedScaleNode.DecimalPlaces, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                        </Grid>

                        <!-- Clamping Safety -->
                        <CheckBox IsChecked="{Binding SelectedScaleNode.IsClamped}" Content="{Binding [InspectorScaleClamp], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10" IsEnabled="{Binding SelectedScaleNode.IsClamped}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [InspectorScaleClampMin], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#475569" Margin="0,0,0,3" />
                                <TextBox Text="{Binding SelectedScaleNode.ClampMin, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [InspectorScaleClampMax], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#475569" Margin="0,0,0,3" />
                                <TextBox Text="{Binding SelectedScaleNode.ClampMax, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                        </Grid>


                        <!-- Two-Point Calibration Helper Expander -->
                        <Expander Header="{Binding [InspectorScaleCalibTitle], Source={x:Static services:LocalizationService.Instance}}" IsExpanded="False" Margin="0,0,0,10">
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [InspectorScaleCalibDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <!-- Point 1 -->
                                    <TextBlock Text="{Binding [InspectorScalePoint1], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Margin="0,2,0,2" />
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [InspectorScaleCalibColX], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#64748B" />
                                        <TextBlock Grid.Column="2" Text="{Binding [InspectorScaleCalibColY], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#64748B" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SelectedScaleNode.CalibX1, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" ToolTip="X1 (mV)" />
                                        <TextBox Grid.Column="2" Text="{Binding SelectedScaleNode.CalibY1, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" ToolTip="Y1 (Eng)" />
                                    </Grid>
                                    <!-- Point 2 -->
                                    <TextBlock Text="{Binding [InspectorScalePoint2], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Margin="0,2,0,2" />
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [InspectorScaleCalibColX], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#64748B" />
                                        <TextBlock Grid.Column="2" Text="{Binding [InspectorScaleCalibColY], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#64748B" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SelectedScaleNode.CalibX2, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" ToolTip="X2 (mV)" />
                                        <TextBox Grid.Column="2" Text="{Binding SelectedScaleNode.CalibY2, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" ToolTip="Y2 (Eng)" />
                                    </Grid>
                                    <Button Content="{Binding [InspectorScaleBtnApplyCalib], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding SelectedScaleNode.CalculateFromCalibPointsCommand}"
                                            Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="8,4" Cursor="Hand" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <!-- INPUT NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedInputNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorInputSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#006487" FontSize="12" />
                        </Border>

                        <!-- SIMULATION INPUT INTERACTIVE FORCE CARD -->
                        <Border Background="#E6F4EA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorSimForceInput], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#107C41" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Border Background="#DFE3E8" CornerRadius="2" Padding="4,1" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="FORCE" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#006487" />
                                    </Border>
                                </DockPanel>

                                <!-- Digital Input Button -->
                                <Button Command="{Binding ToggleInputNodeCommand}" CommandParameter="{Binding SelectedInputNode}"
                                        Padding="10,6" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TactileToolbarBtnStyle}">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedInputNode.Tag.IsDigital}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedInputNode.Tag.Value}" Value="1">
                                                    <Setter Property="Background" Value="#E6F4EA" />
                                                    <Setter Property="Foreground" Value="#107C41" />
                                                    <Setter Property="BorderBrush" Value="#107C41" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding [InspectorSimTogglePulse], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedInputNode.SimButtonContent}" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>

                                <!-- Analog Slider -->
                                <StackPanel Margin="0,4,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedInputNode.Tag.IsDigital}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding [InspectorSimAnalogValue], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#334155" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedInputNode.Tag.Value}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="#107C41" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding SelectedInputNode.Tag.Value, Mode=TwoWay}"
                                            TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [InspectorInputTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TagCatalog.AllTags}"
                                  SelectedItem="{Binding SelectedInputNode.Tag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorTagAlias], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedInputNode.Tag.Alias, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorTagValue], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedInputNode.Tag.Value, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Tag Info Badge -->
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="{Binding [InspectorTagKind], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#64748B" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding SelectedInputNode.Tag.Kind}" FontWeight="Bold" FontFamily="Consolas" FontSize="10.5" Foreground="#006487" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- NARRATIVE & ACTIONS (VISIBLE ONLY WHEN NODE SELECTED) -->
                    <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToVis}}">
                        <Border BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- Default: Stale / NotCompiled (Amber) -->
                                    <Setter Property="Background" Value="#FFFBEB" />
                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                    <Style.Triggers>
                                        <!-- Valid: Industrial Muted Green -->
                                        <DataTrigger Binding="{Binding CompileState}" Value="Valid">
                                            <Setter Property="Background" Value="#ECFDF5" />
                                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                                        </DataTrigger>
                                        <!-- Invalid: Industrial Red -->
                                        <DataTrigger Binding="{Binding CompileState}" Value="Invalid">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding [InspectorLogicStatus], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#D97706" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CompileState}" Value="Valid">
                                                        <Setter Property="Foreground" Value="#059669" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CompileState}" Value="Invalid">
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CompileStateDisplay}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#D97706" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CompileState}" Value="Valid">
                                                        <Setter Property="Foreground" Value="#059669" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CompileState}" Value="Invalid">
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.NavigateToDiagnosticCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="4,3" Margin="0,2,0,0"
                                                    HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                    ToolTip="Nhấp đúp để định vị và căn giữa khối lỗi trên sơ đồ">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                            <DockPanel LastChildFill="True">
                                                                <TextBlock Text="🔍" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Top" />
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                                           FontSize="11" Foreground="#DC2626" LineHeight="16" />
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FEE2E2" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" 
                                CornerRadius="2" Padding="12" Margin="0,8,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding [InspectorNarrativeTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding NarrativePreview}" FontSize="12" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <Button Content="{Binding [InspectorDeleteButton], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding DeleteSelectedNodeCommand}" 
                                Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#B91C1C" BorderThickness="1" 
                                Padding="10,6" FontSize="12" HorizontalAlignment="Stretch" Cursor="Hand" />

                        <!-- Save & Compile Status Card in Inspector -->
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorSaveTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding SaveStatusMessage}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <TextBlock Text="{Binding [InspectorSaveDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button Content="{Binding [InspectorSaveButton], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SaveAndCompileCommand}"
                                        Background="#006487" Foreground="White" FontWeight="SemiBold" FontSize="11.5" Padding="10,7"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="{Binding [SaveAsNewRule], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SaveAsNewRuleCommand}"
                                        Background="#107C41" Foreground="White" FontWeight="SemiBold" FontSize="11.5" Padding="10,7"
                                        BorderThickness="0" Cursor="Hand" Margin="0,6,0,0"
                                        ToolTip="{Binding [SaveAsNewRuleTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingExistingRule}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Virtual Device I/O Simulation Board (Top-level Floating HUD on Canvas & Workspace, ZIndex 9999) -->
        <views:VirtualIoBoardView Grid.Column="1"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,16,20,0" Panel.ZIndex="9999">
            <views:VirtualIoBoardView.Style>
                <Style TargetType="views:VirtualIoBoardView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSimulationMode}" Value="True" />
                                <Condition Binding="{Binding IsVirtualIoBoardOpen}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </views:VirtualIoBoardView.Style>
        </views:VirtualIoBoardView>
    </Grid>
</UserControl>
