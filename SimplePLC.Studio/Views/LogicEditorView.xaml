                            <StackPanel>
                                <!-- Slave ID -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [ModbusColSlaveId], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedModbusReadNode.SlaveId}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Function Code -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [ModbusColFunctionCode], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedModbusReadNode.FunctionCodeDisplay}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <!-- Read Mode & Poll Interval -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [ModbusReadModeLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
