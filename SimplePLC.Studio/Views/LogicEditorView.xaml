                                <ComboBoxItem Content="{Binding [TimerStartWithOn], Source={x:Static services:LocalizationService.Instance}}" />
                                <ComboBoxItem Content="{Binding [TimerStartWithOff], Source={x:Static services:LocalizationService.Instance}}" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Output Tag Q (DO or VFLAG) -->
                        <TextBlock Text="{Binding [InspectorOutputTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
