                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [InspectorScaleGain], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedScaleNode.GainText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [InspectorScaleOffset], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedScaleNode.OffsetText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
