                            <StackPanel>
                                <!-- Topic -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorMqttTopic], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedMqttSubNode.Topic}" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="155" ToolTip="{Binding SelectedMqttSubNode.Topic}" />
                                </DockPanel>

                                <!-- Queue Mode -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [MqttSubColQueueMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedMqttSubNode.QueueModeSummaryText}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <!-- QoS -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorMqttQos], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedMqttSubNode.QosSummary}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
