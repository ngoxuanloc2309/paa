                                    <TextBlock Text="{Binding [ModbusColStartAddr], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedModbusReadNode.StartAddress}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Register Count -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [ModbusColRegCount], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedModbusReadNode.RegCount}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Target Summary Info -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding [InspectorModbusPinsLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedModbusReadNode.PinsCountSummary}" FontSize="11" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <Button Content="{Binding [InspectorModbusConfigureBtn], Source={x:Static services:LocalizationService.Instance}}" 
                                        ToolTip="{Binding [InspectorModbusReadConfigureTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding OpenModbusReadConfigCommand}"
                                        CommandParameter="{Binding SelectedModbusReadNode}"
                                        Style="{StaticResource TiaTactileBtnStyle}"
                                        Padding="12,7" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- MODBUS MASTER WRITE NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedModbusWriteNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <!-- Header Banner -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="📤" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [InspectorModbusWriteSelecting], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontWeight="Bold" Foreground="#1E293B" FontSize="11.5" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Custom Node Label -->
                        <TextBlock Text="{Binding [InspectorNodeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedModbusWriteNode.CustomLabel, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Write Summary Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [ModbusColSlaveId], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedModbusWriteNode.SlaveId}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Write Mode -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [ModbusWriteColMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedModbusWriteNode.WriteModeName}" FontSize="11" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Trigger Mode -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [ModbusWriteColTrigMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedModbusWriteNode.TriggerModeName}" FontSize="11" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <!-- Target Summary Info -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding [InspectorModbusWritePinsLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedModbusWriteNode.PinsCountSummary}" FontSize="11" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <Button Content="{Binding [InspectorModbusConfigureBtn], Source={x:Static services:LocalizationService.Instance}}" 
                                        Command="{Binding OpenModbusWriteConfigCommand}"
                                        CommandParameter="{Binding SelectedModbusWriteNode}"
                                        Style="{StaticResource TiaTactileBtnStyle}"
                                        Padding="12,7" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- DIRECT WRITE ACTUATOR NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedDirectWriteNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <!-- Header Banner -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [InspectorDirectWriteSelecting], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontWeight="Bold" Foreground="#1E293B" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Custom Node Label -->
                        <TextBlock Text="{Binding [InspectorNodeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedDirectWriteNode.CustomLabel, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Direct Write Summary Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorDirectWritePinLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedDirectWriteNode.TargetPinDisplay}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Output Mode — Inline ComboBox -->
                                <TextBlock Text="{Binding [InspectorDirectWriteModeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding SelectedDirectWriteNode.AvailableModes}"
                                          SelectedValue="{Binding SelectedDirectWriteNode.Mode, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="{Binding [DirectWriteModeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                          Padding="6,4" Margin="0,0,0,6" />

                                <!-- Trigger Mode — Inline ComboBox -->
                                <TextBlock Text="{Binding [DirectWriteTriggerModeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding SelectedDirectWriteNode.AvailableTriggerModes}"
                                          SelectedValue="{Binding SelectedDirectWriteNode.TriggerMode, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="{Binding [DirectWriteTriggerModeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                          Padding="6,4" Margin="0,0,0,6" />

                                <!-- Deadband — visible only in COV mode -->
                                <StackPanel Visibility="{Binding SelectedDirectWriteNode.IsCovMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [ModbusWriteColDeadbandLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding SelectedDirectWriteNode.Deadband, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" 
                                             ToolTip="{Binding [DirectWriteDeadbandTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                             Padding="6,4" />
                                </StackPanel>

                                <!-- PWM Frequency — visible only in PWM mode -->
                                <StackPanel Visibility="{Binding SelectedDirectWriteNode.IsPwmMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [DirectWritePwmFreqLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding SelectedDirectWriteNode.PwmFrequencyHz, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="{Binding [DirectWritePwmFreqTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                             Padding="6,4" />
                                </StackPanel>

                                <!-- PTO Pulse Width — visible only in PulseTrain mode -->
                                <StackPanel Visibility="{Binding SelectedDirectWriteNode.IsPulseTrainMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [DirectWritePulseWidthLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding SelectedDirectWriteNode.PulseWidthUs, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="{Binding [DirectWritePulseWidthTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                             Padding="6,4" />
                                </StackPanel>

                                <!-- Channel / Summary Info -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding [InspectorDirectWriteSummaryLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedDirectWriteNode.ModeSummaryDisplay}" FontSize="11" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <Button Content="{Binding [InspectorDirectWriteConfigureBtn], Source={x:Static services:LocalizationService.Instance}}" 
                                        ToolTip="{Binding [InspectorDirectWriteConfigureTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding OpenDirectWriteConfigCommand}"
                                        CommandParameter="{Binding SelectedDirectWriteNode}"
                                        Style="{StaticResource TiaTactileBtnStyle}"
                                        Padding="12,7" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- INPUT NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedInputNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorInputSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#334155" FontSize="12" />
                        </Border>

                        <!-- SIMULATION INPUT INTERACTIVE FORCE CARD (ISA-101 Diagnostic Box) -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorSimForceInput], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#107C41" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Border Background="#DFE3E8" CornerRadius="2" Padding="4,1" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="FORCE" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" />
                                    </Border>
                                </DockPanel>

                                <!-- Digital Input Button -->
                                <Button Command="{Binding ToggleInputNodeCommand}" CommandParameter="{Binding SelectedInputNode}"
                                        Padding="10,6" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TactileToolbarBtnStyle}">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedInputNode.Tag.IsDigital}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedInputNode.Tag.Value}" Value="1">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="Foreground" Value="#107C41" />
                                                    <Setter Property="BorderBrush" Value="#107C41" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding [InspectorSimTogglePulse], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedInputNode.SimButtonContent}" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>

                                <!-- Analog Slider -->
                                <StackPanel Margin="0,4,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedInputNode.Tag.IsDigital}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding [InspectorSimAnalogValue], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#334155" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedInputNode.Tag.Value}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="#107C41" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding SelectedInputNode.Tag.Value, Mode=TwoWay}"
                                            TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [InspectorInputTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TagCatalog.AllTags}"
                                  SelectedItem="{Binding SelectedInputNode.Tag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorTagAlias], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedInputNode.Tag.Alias, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorTagValue], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedInputNode.Tag.Value, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Tag Info Badge -->
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="{Binding [InspectorTagKind], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#64748B" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding SelectedInputNode.Tag.Kind}" FontWeight="Bold" FontFamily="Consolas" FontSize="10.5" Foreground="#334155" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- NARRATIVE & ACTIONS (VISIBLE ONLY WHEN NODE SELECTED) -->
                    <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToVis}}">
                        <Border BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- Default: Stale / NotCompiled (Amber) -->
                                    <Setter Property="Background" Value="#FFFBEB" />
                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                    <Style.Triggers>
                                        <!-- Valid: Industrial Standard Green -->
                                        <DataTrigger Binding="{Binding CompileState}" Value="Valid">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Setter Property="BorderBrush" Value="#107C41" />
                                        </DataTrigger>
                                        <!-- Invalid: Industrial Red -->
                                        <DataTrigger Binding="{Binding CompileState}" Value="Invalid">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding [InspectorLogicStatus], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9C4221" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CompileState}" Value="Valid">
                                                        <Setter Property="Foreground" Value="#107C41" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CompileState}" Value="Invalid">
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CompileStateDisplay}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9C4221" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CompileState}" Value="Valid">
                                                        <Setter Property="Foreground" Value="#107C41" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CompileState}" Value="Invalid">
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.NavigateToDiagnosticCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="4,3" Margin="0,2,0,0"
                                                    HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                    ToolTip="Nhấp đúp để định vị và căn giữa khối lỗi trên sơ đồ">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                            <DockPanel LastChildFill="True">
                                                                <TextBlock Text="🔍" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Top" />
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                                           FontSize="11" Foreground="#DC2626" LineHeight="16" />
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FEE2E2" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" 
                                CornerRadius="2" Padding="12" Margin="0,8,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding [InspectorNarrativeTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding NarrativePreview}" FontSize="12" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <Button Content="{Binding [InspectorDeleteButton], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding DeleteSelectedNodeCommand}" 
                                Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#B91C1C" BorderThickness="1" 
                                Padding="10,6" FontSize="12" HorizontalAlignment="Stretch" Cursor="Hand" />

                        <!-- Save & Compile Status Card in Inspector -->
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [InspectorSaveTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <!-- Status Pill Badge -->
                                    <Border Grid.Column="1" Background="{Binding CompileStateBackground}" 
                                            BorderBrush="{Binding CompileStateBorder}" BorderThickness="1" 
                                            CornerRadius="10" Padding="8,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompileStateDisplay}" FontSize="10" FontWeight="SemiBold" 
                                                   Foreground="{Binding CompileStateColor}" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Message chi tiết trạng thái biên dịch -->
                                <TextBlock Text="{Binding SaveStatusMessage}" FontSize="11" Foreground="{Binding CompileStateColor}" 
                                           FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="{Binding [InspectorSaveDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button Content="{Binding [InspectorSaveButton], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SaveAndCompileCommand}"
                                        Style="{StaticResource BtnPrimary}"
                                        FontSize="11.5" Padding="12,7" Margin="0,0,0,0" />

                                <Button Content="{Binding [SaveAsNewRule], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SaveAsNewRuleCommand}"
                                        Background="#107C41" Foreground="White" FontWeight="SemiBold" FontSize="11.5" Padding="10,7"
                                        BorderThickness="0" Cursor="Hand" Margin="0,6,0,0"
                                        ToolTip="{Binding [SaveAsNewRuleTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingExistingRule}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Virtual Device I/O Simulation Board (Top-level Floating HUD on Canvas & Workspace, ZIndex 9999) -->
        <views:VirtualIoBoardView Grid.Column="1"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,16,20,0" Panel.ZIndex="9999">
            <views:VirtualIoBoardView.Style>
                <Style TargetType="views:VirtualIoBoardView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSimulationMode}" Value="True" />
                                <Condition Binding="{Binding IsVirtualIoBoardOpen}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </views:VirtualIoBoardView.Style>
        </views:VirtualIoBoardView>
    </Grid>
</UserControl>
