                            <DockPanel LastChildFill="True">
                                <TextBlock Text="📥" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [InspectorMqttSubSelecting], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontWeight="Bold" Foreground="#0F172A" FontSize="11.5" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Custom Node Label -->
                        <TextBlock Text="{Binding [InspectorNodeLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
