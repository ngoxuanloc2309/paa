                                <ComboBox Grid.Column="2" 
                                          ItemsSource="{x:Static vm:TimerNodeViewModel.AvailableUnits}"
                                          SelectedValue="{Binding SelectedTimerNode.OnTimeUnit, Mode=TwoWay}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Label"
                                          Height="28" Padding="5,3" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                            </Grid>

                            <!-- T_OFF (Thoi gian NGHI) -->
                            <TextBlock Text="{Binding [TimerOffTime], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="145" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SelectedTimerNode.OffDurationValueText, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="6,4" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" 
                                          ItemsSource="{x:Static vm:TimerNodeViewModel.AvailableUnits}"
                                          SelectedValue="{Binding SelectedTimerNode.OffTimeUnit, Mode=TwoWay}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Label"
                                          Height="28" Padding="5,3" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                            </Grid>

                            <!-- Pha khoi dau (Start Phase) -->
                            <TextBlock Text="{Binding [TimerStartPhase], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
