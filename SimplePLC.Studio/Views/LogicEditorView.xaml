                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [InspectorScaleCalibColX], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#64748B" />
                                        <TextBlock Grid.Column="2" Text="{Binding [InspectorScaleCalibColY], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#64748B" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SelectedScaleNode.CalibX2Text, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" ToolTip="X2 (mV)" />
                                        <TextBox Grid.Column="2" Text="{Binding SelectedScaleNode.CalibY2Text, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" ToolTip="Y2 (Eng)" />
                                    </Grid>
                                    <Button Content="{Binding [InspectorScaleBtnApplyCalib], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding SelectedScaleNode.CalculateFromCalibPointsCommand}"
                                            Style="{StaticResource TiaTactileBtnStyle}" Padding="10,5" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <!-- MQTT PUBLISH NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedMqttNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <!-- Header Banner (Industrial Slate) -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="📡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [InspectorMqttSelecting], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontWeight="Bold" Foreground="#1E293B" FontSize="11.5" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Custom Node Label -->
                        <TextBlock Text="{Binding [InspectorNodeLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedMqttNode.CustomLabel, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="{Binding [InspectorNodeLabelTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                 Padding="6,4" Margin="0,0,0,10" />

                        <!-- MQTT Publish Summary Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Topic -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorMqttTopic], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedMqttNode.Topic}" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="155" ToolTip="{Binding SelectedMqttNode.Topic}" />
                                </DockPanel>

                                <!-- Publish Mode -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorMqttPublishMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedMqttNode.PublishModeSummaryText}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <!-- QoS & Retain -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="QoS / Retain" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedMqttNode.QosRetainSummary}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Payload Format -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorMqttFormatLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedMqttNode.PayloadMode}" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Source / Fields Count -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding [InspectorMqttSourceLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedMqttNode.DataTagBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right" />
                                </DockPanel>

                                <Button Content="{Binding [InspectorMqttConfigureBtn], Source={x:Static services:LocalizationService.Instance}}" 
                                        Command="{Binding OpenMqttConfigCommand}"
                                        CommandParameter="{Binding SelectedMqttNode}"
                                        ToolTip="{Binding [InspectorMqttConfigureTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                        Style="{StaticResource TiaTactileBtnStyle}"
                                        Padding="12,7" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

