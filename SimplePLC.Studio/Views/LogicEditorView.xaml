                                  SelectedItem="{Binding SelectedTimerNode.OutputTag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,4" />
                        <TextBlock Text="{Binding [InspectorOutputTagHint], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,10" />
