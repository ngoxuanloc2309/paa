                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [InspectorScaleClampMin], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#475569" Margin="0,0,0,3" />
                                <TextBox Text="{Binding SelectedScaleNode.ClampMinText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [InspectorScaleClampMax], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#475569" Margin="0,0,0,3" />
                                <TextBox Text="{Binding SelectedScaleNode.ClampMaxText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
