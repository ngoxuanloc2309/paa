                        <TextBox Text="{Binding SelectedCounterNode.CustomLabel, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Counter Mode: CTU / CTD -->
                        <TextBlock Text="{Binding [InspectorCounterMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox SelectedValue="{Binding SelectedCounterNode.CounterMode}"
                                  SelectedValuePath="Tag"
                                  Margin="0,0,0,10">
                            <ComboBoxItem Content="{Binding [OptCounterCtu], Source={x:Static services:LocalizationService.Instance}}" Tag="CTU" />
                            <ComboBoxItem Content="{Binding [OptCounterCtd], Source={x:Static services:LocalizationService.Instance}}" Tag="CTD" />
                        </ComboBox>

                        <!-- Preset Value PV -->
                        <TextBlock Text="{Binding [InspectorPresetValue], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
