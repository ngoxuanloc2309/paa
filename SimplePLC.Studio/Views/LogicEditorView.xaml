                                            <TextBlock Text="{Binding [ToolboxTpDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- CYCLE Block -->
                                <Border Tag="CYCLE" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxCycleDesc], Source={x:Static services:LocalizationService.Instance}}"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7C3AED" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🔄" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxCycleTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxCycleDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Category 4: Standard Counters (CTU, CTD) -->
                        <Expander Style="{StaticResource ToolboxExpanderStyle}" IsExpanded="True">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🧮" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ToolboxCounterCategory], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,2,0,0">
                                <!-- CTU Block -->
                                <Border Tag="CTU" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxCtuDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0F766E" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🔼" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxCtuTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxCtuDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- CTD Block -->
                                <Border Tag="CTD" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxCtdDesc], Source={x:Static services:LocalizationService.Instance}}"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#115E59" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🔽" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxCtdTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxCtdDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Category 5: Analog Signal Processing (SCALE) -->
                        <Expander Style="{StaticResource ToolboxExpanderStyle}" IsExpanded="True">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="📊" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ToolboxAnalogCategory], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,2,0,0">
                                <!-- SCALE Block -->
                                <Border Tag="Scale" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxScaleDesc], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0369A1" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="📈" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxScaleTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxScaleDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Category 6: Cloud & IIoT Communication (MQTT) -->
                        <Expander Style="{StaticResource ToolboxExpanderStyle}" IsExpanded="True">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="📡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ToolboxMqttCategory], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,2,0,0">
                                <!-- MQTT Publish Block -->
                                <Border Tag="MqttPublish" Style="{StaticResource ToolboxCardStyle}"
                                        IsEnabled="{Binding IsMqttPublishSupported}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding MqttPublishDisabledTooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7C3AED" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="📡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxMqttTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxMqttDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- MQTT Subscribe Block -->
                                <Border Tag="MqttSubscribe" Style="{StaticResource ToolboxCardStyle}"
                                        IsEnabled="{Binding IsMqttSubscribeSupported}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding MqttSubscribeDisabledTooltip}"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0D9488" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="📥" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxMqttSubTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxMqttSubDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Modbus Master Read Block -->
                                <Border Tag="MB_READ" Style="{StaticResource ToolboxCardStyle}"
                                        IsEnabled="{Binding IsModbusMasterSupported}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding ModbusReadDisabledTooltip}"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0284C7" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🔄" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxModbusReadTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxModbusReadDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Modbus Master Write Block -->
                                <Border Tag="MB_WRITE" Style="{StaticResource ToolboxCardStyle}"
                                        IsEnabled="{Binding IsModbusMasterSupported}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding ModbusWriteDisabledTooltip}"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0284C7" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="📤" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxModbusWriteTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxModbusWriteDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Direct Hardware Actuator Write Block -->
                                <Border Tag="DIRECT_WRITE" Style="{StaticResource ToolboxCardStyle}"
                                        PreviewMouseMove="ToolboxItem_MouseMove"
                                        ToolTip="{Binding [ToolboxDirectWriteDesc], Source={x:Static services:LocalizationService.Instance}}"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0284C7" CornerRadius="1,0,0,1" />
                                        <StackPanel Grid.Column="1" Margin="8,5,8,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="⚡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding [ToolboxDirectWriteTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                                           FontWeight="SemiBold" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding [ToolboxDirectWriteDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                                       FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="16,1.5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- Row 2: Fixed Bottom Guide / Tips -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" 
                        Padding="6,6,6,2" Margin="0,6,0,0">
                    <TextBlock Text="{Binding [ToolboxTipFooter], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="13" HorizontalAlignment="Center" TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 2. CENTER NODIFY CANVAS WITH DOCKED TOP SIMULATION TOOLBAR -->
        <Grid Grid.Column="1" Background="#F8FAFC"
              SnapsToDevicePixels="True" UseLayoutRounding="True"
              TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="SimDrawerRow" Height="0" MinHeight="0" MaxHeight="600" />
            </Grid.RowDefinitions>

            <!-- ROW 0: NODIFY CANVAS (UNOBSTRUCTED FULL WORKSPACE) -->
            <Grid Grid.Row="0">
                <Border Visibility="{Binding HasNodes, Converter={StaticResource EmptyToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="2" Padding="24,18" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Logic Graph" FontSize="16" FontWeight="Bold"
                                   Foreground="#0F172A" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding [EmptyCanvasPrompt1], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12" Foreground="#64748B" Margin="0,5,0,0"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding [EmptyCanvasPrompt2], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <nodify:NodifyEditor x:Name="Editor"
                                     ItemsSource="{Binding Nodes}"
                                     Connections="{Binding Connections}"
                                     ConnectionTemplate="{StaticResource ConnectionTemplate}"
                                     PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                                     ConnectionCompletedCommand="{Binding CompleteConnectionCommand}"
                                     DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                     SelectedItems="{Binding SelectedNodes}"
                                     AllowDrop="True"
                                     Drop="NodifyEditor_Drop"
                                     DragOver="NodifyEditor_DragOver"
                                     DragEnter="NodifyEditor_DragEnter"
                                     PreviewMouseDown="NodifyEditor_PreviewMouseDown">
                    <nodify:NodifyEditor.Style>
                        <Style TargetType="{x:Type nodify:NodifyEditor}">
                            <Setter Property="Background" Value="{StaticResource EngineeringGridBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridVisible}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource PlainCanvasBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </nodify:NodifyEditor.Style>
                    <nodify:NodifyEditor.ItemContainerStyle>
                        <Style TargetType="{x:Type nodify:ItemContainer}">
                            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding [MenuCut], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.CutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Ctrl+X" />
                                        <MenuItem Header="{Binding [MenuCopy], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Ctrl+C" />
                                        <MenuItem Header="{Binding [MenuPaste], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Ctrl+V" />
                                        <MenuItem Header="{Binding [MenuDuplicate], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Ctrl+D" />
                                        <Separator />
                                        <MenuItem Header="{Binding [MenuDeleteSelected], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding DataContext.DeleteSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  InputGestureText="Del" />
                                        <Separator />
                                        <MenuItem Header="{Binding [MenuLayoutAndAlign], Source={x:Static services:LocalizationService.Instance}}">
                                            <MenuItem Header="{Binding [MenuAlignTop], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignTopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Up"
                                                      Icon="⤒" />
                                            <MenuItem Header="{Binding [MenuAlignMiddle], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignMiddleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+M"
                                                      Icon="╌" />
                                            <MenuItem Header="{Binding [MenuAlignBottom], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignBottomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Down"
                                                      Icon="⤓" />
                                            <Separator />
                                            <MenuItem Header="{Binding [MenuAlignLeft], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Left"
                                                      Icon="⇤" />
                                            <MenuItem Header="{Binding [MenuAlignCenter], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignCenterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+C"
                                                      Icon="┆" />
                                            <MenuItem Header="{Binding [MenuAlignRight], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.AlignRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Right"
                                                      Icon="⇥" />
                                            <Separator />
                                            <MenuItem Header="{Binding [MenuDistributeHorizontal], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.DistributeNodesHorizontallyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Shift+H"
                                                      Icon="⫸" />
                                            <MenuItem Header="{Binding [MenuDistributeVertical], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.DistributeNodesVerticallyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+Shift+V"
                                                      Icon="⫶" />
                                            <Separator />
                                            <MenuItem Header="{Binding [MenuSnapToGrid], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.SnapAllNodesToGridCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      InputGestureText="Alt+G"
                                                      Icon="⌗" />
                                            <MenuItem Header="{Binding [MenuToggleGrid], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Command="{Binding DataContext.ToggleGridCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      IsCheckable="True"
                                                      IsChecked="{Binding DataContext.IsGridVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Icon="▦" />
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="PreviewMouseDown" Handler="ItemContainer_PreviewMouseDown" />
                            <EventSetter Event="PreviewMouseUp" Handler="ItemContainer_PreviewMouseUp" />
                        </Style>
                    </nodify:NodifyEditor.ItemContainerStyle>
                    <nodify:NodifyEditor.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding [ToolUndo], Source={x:Static services:LocalizationService.Instance}}" 
                                      Command="{Binding UndoCommand}"
                                      InputGestureText="Ctrl+Z" />
                            <MenuItem Header="{Binding [ToolRedo], Source={x:Static services:LocalizationService.Instance}}" 
                                      Command="{Binding RedoCommand}"
                                      InputGestureText="Ctrl+Y" />
                            <Separator />
                            <MenuItem Header="{Binding [MenuPaste], Source={x:Static services:LocalizationService.Instance}}" 
                                      Command="{Binding PasteCommand}"
                                      InputGestureText="Ctrl+V" />
                            <MenuItem Header="{Binding [MenuSelectAll], Source={x:Static services:LocalizationService.Instance}}" 
                                      Command="{Binding SelectAllCommand}"
                                      InputGestureText="Ctrl+A" />
                            <Separator />
                            <MenuItem Header="{Binding [MenuLayoutAndAlign], Source={x:Static services:LocalizationService.Instance}}">
                                <MenuItem Header="{Binding [MenuAlignTop], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignTopCommand}"
                                          InputGestureText="Alt+Up"
                                          Icon="⤒" />
                                <MenuItem Header="{Binding [MenuAlignMiddle], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignMiddleCommand}"
                                          InputGestureText="Alt+M"
                                          Icon="╌" />
                                <MenuItem Header="{Binding [MenuAlignBottom], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignBottomCommand}"
                                          InputGestureText="Alt+Down"
                                          Icon="⤓" />
                                <Separator />
                                <MenuItem Header="{Binding [MenuAlignLeft], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignLeftCommand}"
                                          InputGestureText="Alt+Left"
                                          Icon="⇤" />
                                <MenuItem Header="{Binding [MenuAlignCenter], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignCenterCommand}"
                                          InputGestureText="Alt+C"
                                          Icon="┆" />
                                <MenuItem Header="{Binding [MenuAlignRight], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding AlignRightCommand}"
                                          InputGestureText="Alt+Right"
                                          Icon="⇥" />
                                <Separator />
                                <MenuItem Header="{Binding [MenuDistributeHorizontal], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding DistributeNodesHorizontallyCommand}"
                                          InputGestureText="Alt+Shift+H"
                                          Icon="⫸" />
                                <MenuItem Header="{Binding [MenuDistributeVertical], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding DistributeNodesVerticallyCommand}"
                                          InputGestureText="Alt+Shift+V"
                                          Icon="⫶" />
                                <Separator />
                                <MenuItem Header="{Binding [MenuSnapToGrid], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding SnapAllNodesToGridCommand}"
                                          InputGestureText="Alt+G"
                                          Icon="⌗" />
                                <MenuItem Header="{Binding [MenuToggleGrid], Source={x:Static services:LocalizationService.Instance}}" 
                                          Command="{Binding ToggleGridCommand}"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsGridVisible}"
                                          Icon="▦" />
                            </MenuItem>
                        </ContextMenu>
                    </nodify:NodifyEditor.ContextMenu>
                </nodify:NodifyEditor>

                <!-- Floating AI Proposal Action Bar (Layer 5: Human Affirmation Gate) -->
                <Border Visibility="{Binding HasPendingAiProposal, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                        Background="#FFFFFF" BorderBrush="#334155" BorderThickness="1.5"
                        CornerRadius="4" Padding="14,8" Panel.ZIndex="1000">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🤖 " FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AiProposalSummaryText}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,12,0" />
                        
                        <!-- Safety Badge -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#107C41" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="✓ An toàn: 0 xung đột ghi" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" />
                            </StackPanel>
                        </Border>

                        <!-- Accept Button -->
                        <Button Command="{Binding AcceptAiProposalCommand}" Background="#107C41" Foreground="#FFFFFF"
                                Padding="12,4" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,6,0" Cursor="Hand"
                                Content="✓ Chấp nhận (Accept)" />

                        <!-- Reject Button -->
                        <Button Command="{Binding RejectAiProposalCommand}" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="10,4" FontSize="11.5" Foreground="#475569" Cursor="Hand"
                                Content="✕ Hủy bỏ (Reject)" />
                    </StackPanel>
                </Border>

                <!-- Gate Warning Popup Toast (Bottom-Right, Auto-dismiss 3.5s or ✕ close, non-intrusive industrial design) -->
                <Border Visibility="{Binding ShowSimGateToast, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20"
                        Background="#FEF2F2" BorderBrush="#DC2626" BorderThickness="1.5"
                        CornerRadius="3" Padding="12,9" Panel.ZIndex="1050">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SimGateWarning}" Foreground="#991B1B" FontWeight="SemiBold" FontSize="11.5" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="✕" Command="{Binding DismissSimGateToastCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#DC2626" Opacity="0.8" FontWeight="Bold" FontSize="11.5" Cursor="Hand" VerticalAlignment="Center" Padding="4,2" />
                    </StackPanel>
                </Border>

                <!-- Save Confirmation Toast Notification (Bottom-Right, non-intrusive, industrial theme) -->
                <Border Visibility="{Binding ShowSaveToast, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16"
                        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="2" Padding="12,8">
                    <DockPanel LastChildFill="True">
                        <Border Width="3" Background="#107C41" CornerRadius="1" Margin="0,0,8,0" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="#107C41" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SaveToastMessage}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{Binding [ToastViewRuleTable], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ViewRuleTableCommand}"
                                Background="#FFFFFF" Foreground="#107C41" BorderBrush="#107C41" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="10.5" Padding="8,3" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ToastBtnBdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToastBtnBdr" Property="Background" Value="#F8F9FA" />
                                            <Setter TargetName="ToastBtnBdr" Property="BorderBrush" Value="#0B5A2F" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ToastBtnBdr" Property="Background" Value="#DFE3E8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="✕" Command="{Binding DismissToastCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#107C41" Opacity="0.75" FontWeight="Bold" FontSize="11" Cursor="Hand" VerticalAlignment="Center" Padding="4,2" />
                    </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Live Debug Floating HUD Banner (Top-Center, CAD & VS Code Industrial Floating Bar) -->
                <Border Visibility="{Binding IsLiveDebugActive, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                        Background="#FFFFFF" BorderBrush="#107C41" BorderThickness="1.5"
                        CornerRadius="4" Padding="14,6" Panel.ZIndex="1060">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#0F172A" Opacity="0.18" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pulsing Status Dot -->
                        <Grid Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="PulsingRing" Width="10" Height="10" Fill="#107C41" Opacity="0.3">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.5" To="0.0" Duration="0:0:1.0" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="1.0" To="1.8" Duration="0:0:1.0" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="1.0" To="1.8" Duration="0:0:1.0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                                <Ellipse.RenderTransform>
                                    <ScaleTransform CenterX="5" CenterY="5" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="6" Height="6" Fill="#107C41" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Title -->
                        <TextBlock Text="{Binding [LiveDebugHudTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontWeight="Bold" FontSize="11" Foreground="#107C41" VerticalAlignment="Center" Margin="0,0,8,0" />

                        <!-- Separator -->
                        <TextBlock Text="·" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <!-- Sub Status (Device Connected / Waiting) -->
                        <TextBlock Text="{Binding LiveDebugBannerSubText}"
                                   FontSize="11" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,14,0" />

                        <!-- Stop Button -->
                        <Button Command="{Binding ToggleLiveDebugCommand}"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="8,3" Cursor="Hand" ToolTip="{Binding [LiveDebugHudStop], Source={x:Static services:LocalizationService.Instance}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="StopBtnBdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="7" Height="7" Fill="#B91C1C" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding [LiveDebugHudStop], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontSize="10.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="StopBtnBdr" Property="Background" Value="#FEE2E2" />
                                            <Setter TargetName="StopBtnBdr" Property="BorderBrush" Value="#DC2626" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="StopBtnBdr" Property="Background" Value="#FECACA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ROW 1: GRID SPLITTER FOR RESIZING SIMULATION DRAWER -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="#CBD5E1" ShowsPreview="False" Cursor="SizeNS"
                          Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}" />

            <!-- ROW 2: INDUSTRIAL SIMULATION TEST BENCH & DIAGNOSTICS DRAWER (LIGHT SLATE THEME) -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0"
                    SnapsToDevicePixels="True" UseLayoutRounding="True"
                    VerticalAlignment="Stretch"
                    Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <!-- Drawer Header: Industrial Simulation Console Toolbar -->
                    <Border DockPanel.Dock="Top" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Status Pill, Clocks, Primary Controls, Filter & Tools (Flat Compact Bar, No Scrollbar) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Running / Paused Pill -->
                                <Border CornerRadius="2" Padding="6,2.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E2E8F0" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSimRunning}" Value="True">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#107C41" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6.5" Height="6.5" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#64748B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSimRunning}" Value="True">
                                                            <Setter Property="Fill" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SimRunStatusText}" FontSize="9.5" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSimRunning}" Value="True">
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Scan Counter & Cycle Details -->
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="5,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="#" FontSize="9" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding SimScanNumber}" FontSize="10.5" FontWeight="Bold" Foreground="#0F172A" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SimElapsedMs, StringFormat='{}{0}ms'}" FontSize="10" FontWeight="SemiBold" Foreground="#475569" FontFamily="Consolas" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Gate Alert Pill -->
                                <Border Background="#FEF2F2" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="5,2" VerticalAlignment="Center" Margin="0,0,6,0"
                                        Visibility="{Binding HasSimGateWarning, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SimGateWarning}" FontSize="9.5" FontWeight="SemiBold" Foreground="#B91C1C" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons: Step, Auto-Run/Pause, Reset -->
                                <Button Command="{Binding StepSimScanCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Padding="7,3" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="{Binding [SimStepTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⏭" FontSize="10" Foreground="#0F766E" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [SimBarStep], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ToggleSimPlayPauseCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Padding="7,3" Margin="0,0,5,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SimPlayPauseIcon}" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#107C41" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSimRunning}" Value="True">
                                                            <Setter Property="Foreground" Value="#9C4221" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SimPlayPauseButtonText}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Speed Selector ComboBox -->
                                <ComboBox ItemsSource="{Binding SimSpeedOptions}"
                                          SelectedItem="{Binding SelectedSimSpeed}"
                                          DisplayMemberPath="DisplayText"
                                          Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1"
                                          FontSize="10" FontFamily="Segoe UI" FontWeight="Medium"
                                          Padding="4,2" Width="78" VerticalAlignment="Center" Margin="0,0,4,0"
                                          ToolTip="{Binding [SimBarSpeed], Source={x:Static services:LocalizationService.Instance}}" />

                                <!-- Reset Button -->
                                <Button Command="{Binding ResetSimCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#475569"
                                        FontWeight="Medium" FontSize="10" FontFamily="Segoe UI"
                                        Padding="7,3" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="{Binding [SimResetTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [SimBtnResetPlc], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Separator -->
                                <Border Width="1" Height="16" Background="#CBD5E1" Margin="3,0,5,0" VerticalAlignment="Center" />

                                <!-- Filter Changed Scans Only Checkbox -->
                                <CheckBox IsChecked="{Binding FilterChangedScansOnly}"
                                          Content="{Binding [SimFilterChanged], Source={x:Static services:LocalizationService.Instance}}"
                                          VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10" Foreground="#334155"
                                          Cursor="Hand" ToolTip="{Binding [SimFilterTip], Source={x:Static services:LocalizationService.Instance}}" />

                                <!-- Clear Scan Log Button -->
                                <Button Command="{Binding ClearScanLogCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#64748B"
                                        FontWeight="Medium" FontSize="10" FontFamily="Segoe UI"
                                        Padding="6,3" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="{Binding [SimClearTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🗑" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [SimBtnClearLog], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Toggle Virtual I/O Board Button -->
                                <Button Command="{Binding ToggleVirtualIoBoardCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#1E3A8A"
                                        FontWeight="Medium" FontSize="10" FontFamily="Segoe UI"
                                        Padding="7,3" Margin="2,0,0,0" Cursor="Hand"
                                        ToolTip="{Binding [VirtualIoToggleTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎛️" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [VirtualIoBoardBtn], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Right Controls: History Count & Exit Simulation (Always Visible, Never Overlapped) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding [SimTotalCycles], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontFamily="Consolas" Foreground="#64748B" />
                                    <TextBlock Text=": " FontSize="10.5" FontFamily="Consolas" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SimScanHistory.Count}" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#64748B" />
                                </StackPanel>

                                <!-- Exit Simulation Button -->
                                <Button Command="{Binding StopSimulationCommand}"
                                        Style="{StaticResource TactileToolbarBtnStyle}"
                                        Background="#FEE2E2" BorderBrush="#B91C1C" Foreground="#B91C1C"
                                        FontWeight="SemiBold" FontSize="11" FontFamily="Segoe UI"
                                        Padding="10,4" Cursor="Hand"
                                        ToolTip="{Binding [SimExitTip], Source={x:Static services:LocalizationService.Instance}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✕" FontSize="10.5" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [SimBarStop], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content Area: Master-Detail Layout -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="350" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 0: MASTER SCAN HISTORY TABLE -->
                        <Grid Grid.Column="0">
                            <!-- Empty History Hint -->
                            <TextBlock Text="{Binding [SimEmptyHistory], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="#64748B" FontSize="11" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SimScanHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Data Table of Scans with Custom Header and Alternating Rows -->
                            <ListView ItemsSource="{Binding FilteredSimScanHistory}"
                                      SelectedItem="{Binding SelectedScanItem, Mode=TwoWay}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0"
                                      Foreground="#0F172A" FontFamily="Segoe UI" FontSize="11"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.Resources>
                                    <!-- Explicit GridViewColumnHeader style to eliminate white glare -->
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                        <Setter Property="Foreground" Value="#475569" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="10.5" />
                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="6,3" />
                                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                         <GridViewColumn Header="{Binding [SimColScan], Source={x:Static services:LocalizationService.Instance}}" Width="90">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding ScanDisplay}" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" />
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColTime], Source={x:Static services:LocalizationService.Instance}}" Width="75">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding TimeDisplay}" FontFamily="Consolas" Foreground="#64748B" />
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColEvent], Source={x:Static services:LocalizationService.Instance}}" Width="85">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <Border CornerRadius="2" Padding="4,1" HorizontalAlignment="Left">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#F1F5F9" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding ActionFired}" Value="True">
                                                                         <Setter Property="Background" Value="#DFE3E8" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding GuardStatus}" Value="BLOCKED">
                                                                         <Setter Property="Background" Value="#FEE2E2" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding TriggerPassed}" Value="True">
                                                                         <Setter Property="Background" Value="#DFE3E8" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="{Binding ActivityBadgeText}" FontSize="9.5" FontWeight="Bold">
                                                             <TextBlock.Style>
                                                                 <Style TargetType="TextBlock">
                                                                     <Setter Property="Foreground" Value="#64748B" />
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding ActionFired}" Value="True">
                                                                             <Setter Property="Foreground" Value="#334155" />
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding GuardStatus}" Value="BLOCKED">
                                                                             <Setter Property="Foreground" Value="#B91C1C" />
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding TriggerPassed}" Value="True">
                                                                             <Setter Property="Foreground" Value="#334155" />
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </TextBlock.Style>
                                                         </TextBlock>
                                                     </Border>
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColInput], Source={x:Static services:LocalizationService.Instance}}" Width="130">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding InputChange}" FontWeight="Medium" FontFamily="Consolas" Foreground="#0F172A" />
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColTrigger], Source={x:Static services:LocalizationService.Instance}}" Width="180">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <StackPanel Orientation="Horizontal">
                                                         <TextBlock Text="{Binding TriggerResult}" FontWeight="Bold" Margin="0,0,6,0">
                                                             <TextBlock.Style>
                                                                 <Style TargetType="TextBlock">
                                                                     <Setter Property="Foreground" Value="#64748B" />
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding TriggerPassed}" Value="True">
                                                                             <Setter Property="Foreground" Value="#107C41" />
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </TextBlock.Style>
                                                         </TextBlock>
                                                         <TextBlock Text="{Binding TriggerReason}" Foreground="#475569" TextTrimming="CharacterEllipsis" MaxWidth="125" />
                                                     </StackPanel>
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColGuard], Source={x:Static services:LocalizationService.Instance}}" Width="130">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding GuardReason}" FontWeight="Medium">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding GuardPassed}" Value="True">
                                                                         <Setter Property="Foreground" Value="#107C41" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding GuardStatus}" Value="BLOCKED">
                                                                         <Setter Property="Foreground" Value="#B91C1C" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColAction], Source={x:Static services:LocalizationService.Instance}}" Width="130">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding OutputDelta}" FontWeight="Bold" FontFamily="Consolas">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding ActionFired}" Value="True">
                                                                         <Setter Property="Foreground" Value="#4C1D95" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                         <GridViewColumn Header="{Binding [SimColDwell], Source={x:Static services:LocalizationService.Instance}}" Width="90">
                                             <GridViewColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <TextBlock Text="{Binding DwellStatus}" Foreground="#9C4221" FontFamily="Consolas" />
                                                 </DataTemplate>
                                             </GridViewColumn.CellTemplate>
                                         </GridViewColumn>
                                     </GridView>
                                 </ListView.View>
                             </ListView>
                         </Grid>

                         <!-- SPLITTER -->
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#CBD5E1" ResizeDirection="Columns" />

                        <!-- COLUMN 2: SNAPSHOT DETAIL INSPECTOR (DETAIL PANEL) -->
                        <Border Grid.Column="2" Background="#F8FAFC" Padding="12,8">
                             <ScrollViewer VerticalScrollBarVisibility="Auto">
                                 <StackPanel>
                                     <!-- Empty state when no scan selected -->
                                     <TextBlock Text="{Binding [SimSelectRowHint], Source={x:Static services:LocalizationService.Instance}}"
                                                Foreground="#94A3B8" FontSize="11" FontStyle="Italic"
                                                HorizontalAlignment="Center" Margin="0,40,0,0">
                                         <TextBlock.Style>
                                             <Style TargetType="TextBlock">
                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding SelectedScanItem}" Value="{x:Null}">
                                                         <Setter Property="Visibility" Value="Visible" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </TextBlock.Style>
                                     </TextBlock>

                                     <!-- Content when a scan is selected -->
                                     <StackPanel>
                                         <StackPanel.Style>
                                             <Style TargetType="StackPanel">
                                                 <Setter Property="Visibility" Value="Visible" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding SelectedScanItem}" Value="{x:Null}">
                                                         <Setter Property="Visibility" Value="Collapsed" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </StackPanel.Style>

                                         <!-- Header of Snapshot -->
                                         <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                             <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                 <TextBlock Text="{Binding [SimDetailTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                 <TextBlock Text="{Binding SelectedScanItem.ScanDisplay}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" VerticalAlignment="Center" />
                                             </StackPanel>
                                             <TextBlock Text="{Binding SelectedScanItem.TimeDisplay, StringFormat='{}T = {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#64748B" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                         </DockPanel>

                                         <!-- Card 1: Ngõ vào -->
                                         <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,6">
                                             <StackPanel>
                                                 <TextBlock Text="{Binding [SimDetailInput], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                                                 <TextBlock Text="{Binding SelectedScanItem.InputChange}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                                             </StackPanel>
                                         </Border>

                                         <!-- Card 2: Kích hoạt -->
                                         <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,6">
                                             <StackPanel>
                                                 <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                                     <TextBlock Text="{Binding [SimDetailTrigger], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                     <TextBlock Text="{Binding SelectedScanItem.TriggerResult}" FontWeight="Bold" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding SelectedScanItem.TriggerPassed}" Value="True">
                                                                         <Setter Property="Foreground" Value="#107C41" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DockPanel>
                                                 <TextBlock Text="{Binding SelectedScanItem.TriggerReason}" FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" />
                                             </StackPanel>
                                         </Border>

                                         <!-- Card 3: Khóa liên động -->
                                         <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,6">
                                             <StackPanel>
                                                 <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                                     <TextBlock Text="{Binding [SimDetailGuard], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                     <TextBlock Text="{Binding SelectedScanItem.GuardStatus}" FontWeight="Bold" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding SelectedScanItem.GuardPassed}" Value="True">
                                                                         <Setter Property="Foreground" Value="#107C41" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding SelectedScanItem.GuardStatus}" Value="BLOCKED">
                                                                         <Setter Property="Foreground" Value="#B91C1C" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DockPanel>
                                                 <TextBlock Text="{Binding SelectedScanItem.GuardReason}" FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" />
                                             </StackPanel>
                                         </Border>

                                         <!-- Card 4: Lệnh xuất -->
                                         <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6">
                                             <StackPanel>
                                                 <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                                     <TextBlock Text="{Binding [SimDetailAction], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                     <TextBlock Text="{Binding SelectedScanItem.ActionStatus}" FontWeight="Bold" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding SelectedScanItem.ActionFired}" Value="True">
                                                                         <Setter Property="Foreground" Value="#334155" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </DockPanel>
                                                 <TextBlock Text="{Binding SelectedScanItem.ActionDetails}" FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" />
                                                 <TextBlock FontSize="10" Foreground="#9C4221" Margin="0,2,0,0">
                                                     <Run Text="{Binding [SimDetailDwell], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding SelectedScanItem.DwellStatus, Mode=OneWay}" />
                                                 </TextBlock>
                                             </StackPanel>
                                         </Border>
                                     </StackPanel>
                                 </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 3. RIGHT INSPECTOR / PROPERTIES -->
        <Border Grid.Column="2" Background="{StaticResource BgPanelBrush}" 
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="{Binding [InspectorTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding [InspectorSubtitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,14" />

                    <!-- 1. SIMULATION MODE: LIVE I/O WATCH & FORCE TABLE (SHOWN WHEN NO NODE SELECTED) -->
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedNode}" Value="{x:Null}" />
                                            <Condition Binding="{Binding IsSimulationMode}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Panel Header Card -->
                        <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding [SimWatchTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#1E293B" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding [SimWatchBadge], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <TextBlock Text="{Binding [SimWatchHint], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#64748B" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Group 1: Discrete & Analog Inputs -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [SimWatchInputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#475569" DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding CanvasInputNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                        <TextBlock Text=" " FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding [SimWatchInputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#94A3B8" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding CanvasInputNodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,4">
                                                <DockPanel LastChildFill="True">
                                                    <!-- Left: Tag Name & Alias -->
                                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TagCode}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="#0F172A" />
                                                            <TextBlock Text="{Binding TagKindText, StringFormat=' ({0})'}" FontSize="10" Foreground="#64748B" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TagDescriptionText}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="105" />
                                                    </StackPanel>

                                                    <!-- Right: Interactive Control -->
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <!-- Digital Input Button -->
                                                        <Button Command="{Binding DataContext.ToggleSimInputNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="8,3" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Cursor="Hand">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource TactileToolbarBtnStyle}">
                                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag.IsDigital}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag.Value}" Value="1">
                                                                            <Setter Property="Background" Value="#F1F5F9" />
                                                                            <Setter Property="Foreground" Value="#107C41" />
                                                                            <Setter Property="BorderBrush" Value="#107C41" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="{Binding SimButtonContent}" />
                                                        </Button>

                                                        <!-- Analog Stepper -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag.IsDigital}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Button Content="-" Command="{Binding DataContext.DecrementSimAnalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="6,2" FontSize="11" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" />
                                                                    <TextBlock Text="{Binding Tag.Value}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="4,0" Width="36" TextAlignment="Center" />
                                                            <Button Content="+" Command="{Binding DataContext.IncrementSimAnalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="6,2" FontSize="11" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Outputs (DO) Monitor -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [SimWatchOutputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#475569" DockPanel.Dock="Left" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding CanvasActionNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                        <TextBlock Text=" " FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding [SimWatchOutputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#94A3B8" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding CanvasActionNodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,4">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ActionExpression}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="#0F172A" />
                                                        <TextBlock Text="{Binding TargetTagShortText}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="2" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F1F5F9" />
                                                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSimFired}" Value="True">
                                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                                        <Setter Property="BorderBrush" Value="#107C41" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding SimLedStatusText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSimFired}" Value="True">
                                                                            <Setter Property="Foreground" Value="#0E6B37" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. DESIGN MODE PLACEHOLDER (SHOWN ONLY WHEN NO NODE SELECTED AND NOT IN SIMULATION) -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="20,24" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedNode}" Value="{x:Null}" />
                                            <Condition Binding="{Binding IsSimulationMode}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👆" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding [InspectorNoSelectionTitle], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding [InspectorNoSelectionDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" LineHeight="16" />
                        </StackPanel>
                    </Border>

                    <!-- TRIGGER NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedTriggerNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorTriggerSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#107C41" FontSize="12" />
                        </Border>

                        <!-- SIMULATION TRIGGER STATUS CARD (ISA-101 Diagnostic Box) -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding [InspectorSimTriggerStatus], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#107C41" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <Border CornerRadius="2" Padding="6,2" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTriggerNode.IsSimTriggered}" Value="True">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedTriggerNode.SimStatusText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTriggerNode.IsSimTriggered}" Value="True">
                                                        <Setter Property="Foreground" Value="#107C41" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{Binding [InspectorTriggerType], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{x:Static vm:RuleOptions.TriggerTypes}"
                                  SelectedValue="{Binding SelectedTriggerNode.TriggerType}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <!-- GIAO DIỆN CẤU HÌNH THỜI GIAN THỰC (RTC CLOCK / TIME OF DAY) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10"
                                Visibility="{Binding SelectedTriggerNode.IsTimeTrigger, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding [InspectorTimeMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6" />
                                
                                <RadioButton GroupName="RtcTimeMode" IsChecked="{Binding SelectedTriggerNode.IsTimePointInTime}" Content="{Binding [InspectorTimeModePoint], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Margin="0,0,0,4" />
                                <RadioButton GroupName="RtcTimeMode" IsChecked="{Binding SelectedTriggerNode.IsTimeWindowRange}" Content="{Binding [InspectorTimeModeWindow], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Margin="0,0,0,8" />

                                <Separator Background="#E2E8F0" Margin="0,0,0,8" />

                                <!-- Chế độ Mốc thời gian (At Time) -->
                                <StackPanel Visibility="{Binding SelectedTriggerNode.IsTimePointInTime, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [InspectorTimeAt], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeStartHour, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text=":" FontSize="13" FontWeight="Bold" Margin="4,2" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeStartMinute, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text="{Binding SelectedTriggerNode.TimeStartFormatted, StringFormat='{} ({0})'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Chế độ Khung thời gian (Time Window) -->
                                <StackPanel Visibility="{Binding SelectedTriggerNode.IsTimeWindowRange, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [InspectorTimeStart], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeStartHour, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text=":" FontSize="13" FontWeight="Bold" Margin="4,2" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeStartMinute, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text="{Binding SelectedTriggerNode.TimeStartFormatted, StringFormat='{} ({0})'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding [InspectorTimeEnd], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeEndHour, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text=":" FontSize="13" FontWeight="Bold" Margin="4,2" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding SelectedTriggerNode.TimeEndMinute, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" BorderBrush="#CBD5E1" />
                                        <TextBlock Text="{Binding SelectedTriggerNode.TimeEndFormatted, StringFormat='{} ({0})'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- CHU KỲ LẶP LẠI (CHỈ HIỂN THỊ KHI LÀ PERIODIC INTERVAL) -->
                        <StackPanel Visibility="{Binding SelectedTriggerNode.IsIntervalTrigger, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorIntervalMs], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedTriggerNode.ForMs, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6" />
                            <TextBlock Text="⚡ Bộ phát nhịp sự kiện lặp lại tự động theo chu kỳ mỗi N mili-giây (ms)." FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- THỜI GIAN LỌC TÍN HIỆU / DWELL TIME (CHỈ HIỂN THỊ KHI LÀ ON_RISE, ON_FALL, ON_CHANGE) -->
                        <StackPanel Visibility="{Binding SelectedTriggerNode.IsStandardEdgeTrigger, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorDwellTimeFilter], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedTriggerNode.ForMs, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                    </StackPanel>

                    <!-- COMPARATOR NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedComparatorNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#F0F9FF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorComparatorSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#0284C7" FontSize="12" />
                        </Border>

                        <!-- SIMULATION COMPARATOR EVALUATION STATUS CARD -->
                        <Border Background="#F0F9FF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="⚖️ CMP LOGIC EVALUATION:" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <Border CornerRadius="2" Padding="6,2" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedComparatorNode.IsConditionMet}" Value="True">
                                                    <Setter Property="Background" Value="#E0F2FE" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedComparatorNode.ConditionPassedText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedComparatorNode.IsConditionMet}" Value="True">
                                                        <Setter Property="Foreground" Value="#0284C7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- FORMULA EXPRESSION PREVIEW -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Expression:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SelectedComparatorNode.FormulaExpression}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Foreground="#0284C7" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- TÍN HIỆU ĐẦU VÀO (INPUT TAG / VARIABLE) -->
                        <TextBlock Text="{Binding [InspectorComparatorInputTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TagCatalog.AllTags}"
                                  SelectedItem="{Binding SelectedComparatorNode.InputTag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <!-- TOÁN TỬ SO SÁNH -->
                        <TextBlock Text="{Binding [InspectorCompareOp], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{x:Static vm:RuleOptions.CompareOps}"
                                  SelectedValue="{Binding SelectedComparatorNode.CompareOp}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <!-- NGƯỠNG SO SÁNH (THRESHOLD LO) -->
                        <TextBlock Text="{Binding [InspectorThresholdLo], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedComparatorNode.ThresholdLoText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- NGƯỠNG TRÊN (THRESHOLD HI - KHI LÀ DẢI BETWEEN) -->
                        <StackPanel Visibility="{Binding SelectedComparatorNode.IsRangeCompare, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding [InspectorThresholdHi], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedComparatorNode.ThresholdHiText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />
                        </StackPanel>
                    </StackPanel>

                    <!-- GUARD NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedGuardNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorGuardSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#C05621" FontSize="12" />
                        </Border>

                        <!-- CẢNH BÁO NẾU CHỌN TAG KHÔNG PHẢI BOOLEAN -->
                        <Border Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,10"
                                Visibility="{Binding SelectedGuardNode.IsInvalidTagType, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [InspectorGuardTagWarning], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" Foreground="#991B1B" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- SIMULATION GUARD INTERACTIVE CARD -->
                        <Border Background="#FFFBEB" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorSimGuardTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#92400E" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Border CornerRadius="3" Padding="6,1.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF2F2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGuardNode.IsSimPassed}" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedGuardNode.SimStatusText}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGuardNode.IsSimPassed}" Value="True">
                                                            <Setter Property="Foreground" Value="#107C41" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <!-- Tag info & value -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding SelectedGuardNode.GuardTag.DisplayName, StringFormat='{}Tag: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#475569" DockPanel.Dock="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    <TextBlock Text="{Binding SelectedGuardNode.GuardTag.Value, StringFormat='{}Giá trị: {0}'}" FontWeight="Bold" FontFamily="Consolas" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Toggle Button for Digital Guard Tag -->
                                <Button Command="{Binding ToggleSimTagCommand}" CommandParameter="{Binding SelectedGuardNode.GuardTag}"
                                        Padding="8,4" FontSize="10.5" FontWeight="Bold" Cursor="Hand" Margin="0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TactileToolbarBtnStyle}">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGuardNode.GuardTag.IsDigital}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedGuardNode.GuardTag.Value}" Value="1">
                                                    <Setter Property="Background" Value="#FFFBEB" />
                                                    <Setter Property="Foreground" Value="#C05621" />
                                                    <Setter Property="BorderBrush" Value="#C05621" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding [InspectorSimToggleTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedGuardNode.SimButtonContent}" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [InspectorGuardTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TagCatalog.DigitalTags}"
                                  SelectedItem="{Binding SelectedGuardNode.GuardTag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorGuardTagAlias], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedGuardNode.GuardTag.Alias, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <CheckBox IsChecked="{Binding SelectedGuardNode.Negate}" Content="{Binding [InspectorInvertCondition], Source={x:Static services:LocalizationService.Instance}}" Margin="0,4,0,10" />
                    </StackPanel>

                    <!-- ACTION NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedActionNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorActionSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#334155" FontSize="12" />
                        </Border>

                        <!-- SIMULATION ACTION STATUS CARD -->
                        <Border Background="#DFE3E8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [InspectorSimActionStatus], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="#334155" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Border CornerRadius="3" Padding="6,1.5" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedActionNode.IsSimFired}" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedActionNode.SimStatusText}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedActionNode.IsSimFired}" Value="True">
                                                            <Setter Property="Foreground" Value="#0E6B37" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock Text="{Binding SelectedActionNode.TargetTag.DisplayName, StringFormat='{}Tag: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#334155" DockPanel.Dock="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    <TextBlock Text="{Binding SelectedActionNode.TargetTag.Value, StringFormat='{}Giá trị: {0}'}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="#1D4ED8" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [InspectorActionType], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{x:Static vm:RuleOptions.ActionTypes}"
                                  SelectedValue="{Binding SelectedActionNode.ActionType}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorTargetTag], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TagCatalog.AllTags}"
                                  SelectedItem="{Binding SelectedActionNode.TargetTag}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorTargetTagAlias], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedActionNode.TargetTag.Alias, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding [InspectorActionParam], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedActionNode.ActionParam, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />
                    </StackPanel>

                    <!-- TIMER NODE PROPERTIES FORM -->
                    <StackPanel Visibility="{Binding SelectedTimerNode, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                        <Border Background="#EDE9FE" BorderBrush="#4C1D95" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [InspectorTimerSelecting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="#4C1D95" FontSize="12" />
                        </Border>

                        <!-- Custom Node Label -->
                        <TextBlock Text="{Binding [InspectorNodeLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SelectedTimerNode.CustomLabel, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10" />

                        <!-- Timer Mode: TON / TOF / TP -->
                        <TextBlock Text="{Binding [InspectorTimerMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox SelectedValue="{Binding SelectedTimerNode.TimerMode}"
                                  SelectedValuePath="Tag"
                                  Margin="0,0,0,10">
                            <ComboBoxItem Content="{Binding [OptTimerTon], Source={x:Static services:LocalizationService.Instance}}" Tag="TON" />
                            <ComboBoxItem Content="{Binding [OptTimerTof], Source={x:Static services:LocalizationService.Instance}}" Tag="TOF" />
                            <ComboBoxItem Content="{Binding [OptTimerTp], Source={x:Static services:LocalizationService.Instance}}" Tag="TP" />
                            <ComboBoxItem Content="{Binding [OptTimerCycle], Source={x:Static services:LocalizationService.Instance}}" Tag="CYCLE" />
                        </ComboBox>

                        <!-- Preset Time PT (Value + Unit) - Khi KHONG o che do CYCLE -->
                        <StackPanel Visibility="{Binding SelectedTimerNode.IsCycleMode, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{Binding [InspectorPresetTime], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="145" />
                                </Grid.ColumnDefinitions>

                                <!-- Value Input (supports integer and decimals, e.g. 30, 1.5, 500) -->
                                <TextBox Grid.Column="0" Text="{Binding SelectedTimerNode.DurationValueText, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="6,4" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" />

                                <!-- Unit Selector: ms, s, min, h (dynamically localized) -->
                                <ComboBox Grid.Column="2" 
                                          ItemsSource="{x:Static vm:TimerNodeViewModel.AvailableUnits}"
                                          SelectedValue="{Binding SelectedTimerNode.TimeUnit, Mode=TwoWay}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Label"
                                          Height="28" Padding="5,3" FontSize="11" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                            </Grid>
                        </StackPanel>

                        <!-- Cycle Parameters: T_ON, T_OFF, StartPhase - Khi o che do CYCLE -->
                        <StackPanel Visibility="{Binding SelectedTimerNode.IsCycleMode, Converter={StaticResource BoolToVis}}">
                            <!-- T_ON (Thoi gian BAT) -->
                            <TextBlock Text="{Binding [TimerOnTime], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#107C41" Margin="0,0,0,4" />
