<Window x:Class="SimplePLC.Studio.Views.MqttSubConfigDialogView"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:services="clr-namespace:SimplePLC.Studio.Services"

        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"

        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"

        Title="{Binding [MqttSubConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}"

        Width="1040" Height="660"

        MinWidth="980" MinHeight="600"

        ResizeMode="CanResizeWithGrip"

        controls:WindowChromeHelper.EnableIndependentMinimize="True"

        Icon="../Assets/app.png"

        WindowStartupLocation="CenterOwner"

        ShowInTaskbar="True"

        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"

        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"

        Background="{DynamicResource BgWindowBrush}"

        FontFamily="Segoe UI"

        TextOptions.TextFormattingMode="Display"

        TextOptions.TextRenderingMode="ClearType"

        RenderOptions.ClearTypeHint="Enabled">



    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="../Styles/Colors.xaml" />

                <ResourceDictionary Source="../Styles/Controls.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

        </ResourceDictionary>

    </Window.Resources>



    <Border BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1">

        <Grid Margin="16">

            <Grid.RowDefinitions>

                <!-- 0. Header -->

                <RowDefinition Height="Auto" />

                <!-- 1. Content Two-Column Body -->

                <RowDefinition Height="*" />

                <!-- 2. Footer Actions -->

                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>



            <!-- 0. Header (Industrial Slate & Ocean Blue) -->

            <Grid Grid.Row="0" Margin="0,0,0,12">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <Border Grid.Column="0" Width="40" Height="40" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,12,0"

                        ToolTip="{Binding [MqttSubHeaderTooltip], Source={x:Static services:LocalizationService.Instance}}">

                    <TextBlock Text="📥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />

                </Border>



                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                    <DockPanel>

                        <Button DockPanel.Dock="Right" Command="{Binding OpenDeviceBrokerSettingsCommand}"

                                Style="{StaticResource TiaTactileBtnStyle}" Padding="10,4" VerticalAlignment="Center"

                                ToolTip="{Binding [BtnOpenDeviceBrokerSettings], Source={x:Static services:LocalizationService.Instance}}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding [BtnOpenDeviceBrokerSettings], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" />

                            </StackPanel>

                        </Button>

                        <StackPanel>

                            <TextBlock Text="{Binding [MqttSubConfigDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 

                                       FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Text="{Binding [MqttSubConfigDialogSubtitle], Source={x:Static services:LocalizationService.Instance}}" 

                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />

                        </StackPanel>

                    </DockPanel>

                </StackPanel>

            </Grid>



            <!-- 1. Two-Column Body -->

            <Grid Grid.Row="1" Margin="0,0,0,12">

                <Grid.ColumnDefinitions>

                    <!-- Left: Communication & Output Pins (1.3*) -->

                    <ColumnDefinition Width="1.3*" />

                    <ColumnDefinition Width="14" />

                    <!-- Right: Live Payload Test & Extraction (1*) -->

                    <ColumnDefinition Width="1*" />

                </Grid.ColumnDefinitions>



                <!-- LEFT PANE: CONFIGURATION & OUTPUT PINS -->

                <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="14">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>



                        <!-- Top Accent Line (Industrial Option 1 Flat) -->

                        <Border Grid.Row="0" Height="2" Background="{DynamicResource IndustrialPrimaryBrush}" Margin="-14,-14,-14,12" />



                        <!-- Section: Communication Parameters -->

                        <StackPanel Grid.Row="1" Margin="0,0,0,10">

                            <!-- MQTT Topic -->

                            <TextBlock Text="{Binding [InspectorMqttTopic], Source={x:Static services:LocalizationService.Instance}}" 

                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />

                            <Grid Margin="0,0,0,6">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{Binding Node.Topic, UpdateSourceTrigger=PropertyChanged}" 

                                         ToolTip="{Binding [InspectorMqttSubTopicTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                         Padding="6,4" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />

                                <Button Grid.Column="1" Command="{Binding Node.SanitizeTopicCommand}" 

                                        ToolTip="{Binding [InspectorMqttTopicSanitizeTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                        Content="🧹" Style="{StaticResource TiaTactileBtnStyle}" Padding="8,4" Margin="4,0,0,0" />

                            </Grid>



                            <!-- Topic Validation Warning -->

                            <Border Visibility="{Binding Node.HasTopicError, Converter={StaticResource BoolToVis}}"

                                    Background="{DynamicResource SelectionHoverBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,6">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="⚠ " Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold" />

                                    <TextBlock Text="{Binding Node.TopicValidationError}" Foreground="{DynamicResource DangerBrush}" FontSize="10.5" TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>



                            <!-- QoS & Queue Mode Row -->

                            <Grid Margin="0,0,0,6">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="10" />

                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>



                                <!-- QoS Selector -->

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="{Binding [InspectorMqttQos], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="*" />

                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="QoS 0" Command="{Binding Node.SetQos0Command}" 

                                                Margin="0,0,2,0" Padding="0,4" FontSize="10.5" Cursor="Hand">

                                            <Button.Style>

                                                <Style TargetType="Button">

                                                    <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />

                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />

                                                    <Setter Property="BorderBrush" Value="{DynamicResource IndustrialBorderDefaultBrush}" />

                                                    <Setter Property="BorderThickness" Value="1" />

                                                    <Setter Property="FontWeight" Value="Normal" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Node.IsQos0}" Value="True">

                                                            <Setter Property="Background" Value="{DynamicResource SelectionHighlightBrush}" />

                                                            <Setter Property="Foreground" Value="{DynamicResource IndustrialPrimaryBrush}" />

                                                            <Setter Property="BorderBrush" Value="{DynamicResource IndustrialPrimaryBrush}" />

                                                            <Setter Property="FontWeight" Value="Bold" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>

                                        <Button Grid.Column="1" Content="QoS 1" Command="{Binding Node.SetQos1Command}" 

                                                Margin="2,0,2,0" Padding="0,4" FontSize="10.5" Cursor="Hand">

                                            <Button.Style>

                                                <Style TargetType="Button">

                                                    <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />

                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />

                                                    <Setter Property="BorderBrush" Value="{DynamicResource IndustrialBorderDefaultBrush}" />

                                                    <Setter Property="BorderThickness" Value="1" />

                                                    <Setter Property="FontWeight" Value="Normal" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Node.IsQos1}" Value="True">

                                                            <Setter Property="Background" Value="{DynamicResource SelectionHighlightBrush}" />

                                                            <Setter Property="Foreground" Value="{DynamicResource IndustrialPrimaryBrush}" />

                                                            <Setter Property="BorderBrush" Value="{DynamicResource IndustrialPrimaryBrush}" />

                                                            <Setter Property="FontWeight" Value="Bold" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>

                                        <Button Grid.Column="2" Content="QoS 2" Command="{Binding Node.SetQos2Command}" 

                                                Margin="2,0,0,0" Padding="0,4" FontSize="10.5" Cursor="Hand">

                                            <Button.Style>

                                                <Style TargetType="Button">

                                                    <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />

                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />

                                                    <Setter Property="BorderBrush" Value="{DynamicResource IndustrialBorderDefaultBrush}" />

                                                    <Setter Property="BorderThickness" Value="1" />

                                                    <Setter Property="FontWeight" Value="Normal" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Node.IsQos2}" Value="True">

                                                            <Setter Property="Background" Value="{DynamicResource SelectionHighlightBrush}" />

                                                            <Setter Property="Foreground" Value="{DynamicResource IndustrialPrimaryBrush}" />

                                                            <Setter Property="BorderBrush" Value="{DynamicResource IndustrialPrimaryBrush}" />

                                                            <Setter Property="FontWeight" Value="Bold" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>

                                    </Grid>

                                </StackPanel>



                                <!-- Queue Mode Selector -->

                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="{Binding [MqttSubColQueueMode], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />

                                    <ComboBox SelectedValue="{Binding Node.QueueMode, Mode=TwoWay}"

                                              SelectedValuePath="Value"

                                              DisplayMemberPath="DisplayName"

                                              ItemsSource="{Binding AvailableQueueModes}"

                                              Padding="6,4" FontSize="11" />

                                </StackPanel>

                            </Grid>

                        </StackPanel>



                        <!-- Section: Output Pins Header -->

                        <Border Grid.Row="2" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,4">

                            <DockPanel LastChildFill="True">

                                <TextBlock Text="{Binding [MqttSubFieldSection], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" VerticalAlignment="Center" />

                                <TextBlock Text="{Binding Node.PinsCountSummary}" 

                                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            </DockPanel>

                        </Border>



                        <!-- Fields Grid / Table -->

                        <Grid Grid.Row="3">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <!-- Column Header Row -->

                            <Grid Grid.Row="0" Margin="4,0,4,4" Background="{DynamicResource BgSubtleBrush}" Height="26">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="6" />

                                    <ColumnDefinition Width="130" />

                                    <ColumnDefinition Width="6" />

                                    <ColumnDefinition Width="28" />

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding [MqttSubColFieldName], Source={x:Static services:LocalizationService.Instance}}" 

                                           ToolTip="{Binding [MqttSubColFieldNameTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" />

                                <TextBlock Grid.Column="2" Text="{Binding [MqttSubColType], Source={x:Static services:LocalizationService.Instance}}" 

                                           ToolTip="{Binding [MqttSubColTypeTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0" />

                            </Grid>



                            <!-- Scrollable rows -->

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">

                                <ItemsControl ItemsSource="{Binding Node.Pins}" Margin="4,2,4,2">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Grid Margin="0,0,0,6">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="6" />

                                                    <ColumnDefinition Width="130" />

                                                    <ColumnDefinition Width="6" />

                                                    <ColumnDefinition Width="28" />

                                                </Grid.ColumnDefinitions>

                                                <!-- Field Name -->

                                                <TextBox Grid.Column="0" Text="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" 

                                                         ToolTip="{Binding [MqttSubFieldNameTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                                         Height="25" Padding="6,2" FontSize="11" FontFamily="Consolas" VerticalContentAlignment="Center" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" />

                                                <!-- Data Type -->

                                                <ComboBox Grid.Column="2" 

                                                          SelectedValue="{Binding DataType, Mode=TwoWay}"

                                                          SelectedValuePath="Value"

                                                          DisplayMemberPath="DisplayName"

                                                          ItemsSource="{Binding DataContext.AvailableDataTypes, RelativeSource={RelativeSource AncestorType=Window}}"

                                                          ToolTip="{Binding [MqttSubFieldTypeTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                                          Height="25" Padding="4,2" FontSize="10.5" VerticalContentAlignment="Center" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" />

                                                <!-- Delete Button -->

                                                <Button Grid.Column="4"

                                                        Style="{StaticResource TableRowDeleteBtnStyle}"

                                                        Command="{Binding DataContext.RemovePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                                        CommandParameter="{Binding}"

                                                        ToolTip="{Binding [MqttSubFieldDeleteTooltip], Source={x:Static services:LocalizationService.Instance}}" />

                                            </Grid>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Grid>



                        <!-- Add Field Button -->

                        <Button Grid.Row="4" Content="{Binding [MqttSubBtnAddField], Source={x:Static services:LocalizationService.Instance}}" 

                                Command="{Binding AddPinCommand}" 

                                ToolTip="{Binding [MqttSubBtnAddFieldTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                Style="{StaticResource TiaTactileBtnStyle}"

                                Margin="0,8,0,0" Padding="12,6" FontSize="11" HorizontalAlignment="Left" />

                    </Grid>

                </Border>



                <!-- RIGHT PANE: LIVE PAYLOAD TEST & EXTRACTION -->

                <Border Grid.Column="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="14">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>



                        <!-- Payload Test Header -->

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">

                            <Button DockPanel.Dock="Right" Content="{Binding [MqttSubBtnResetSample], Source={x:Static services:LocalizationService.Instance}}" 

                                    Command="{Binding ResetSamplePayloadCommand}"

                                    ToolTip="{Binding [MqttSubBtnResetSampleTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                    Style="{StaticResource TiaTactileBtnStyle}"

                                    Padding="8,3" FontSize="10" VerticalAlignment="Top" />

                            <StackPanel Margin="0,0,8,0">

                                <TextBlock Text="{Binding [MqttSubTestSection], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Margin="0,0,0,3" />

                                <TextBlock Text="{Binding [MqttSubTestSectionDesc], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

                            </StackPanel>

                        </DockPanel>



                        <!-- Payload Test Input Box -->

                        <TextBox Grid.Row="1" Text="{Binding SimulationInput, UpdateSourceTrigger=PropertyChanged}" 

                                 AcceptsReturn="True" AcceptsTab="True" Height="140"

                                 ToolTip="{Binding [MqttSubTestInputTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 

                                 FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource BgWindowBrush}" 

                                 BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" />



                        <!-- Test Action & Results -->

                        <Grid Grid.Row="2">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <Button Grid.Row="0" Content="{Binding [MqttSubBtnRunTest], Source={x:Static services:LocalizationService.Instance}}" 

                                    Command="{Binding RunSimulationCommand}"

                                    ToolTip="{Binding [MqttSubBtnRunTestTooltip], Source={x:Static services:LocalizationService.Instance}}"

                                    Style="{StaticResource BtnPrimary}"

                                    Padding="12,6" FontSize="11" HorizontalAlignment="Stretch" Margin="0,0,0,8" />



                            <!-- Result Display Card -->

                            <Border Grid.Row="1" Background="{DynamicResource BgWindowBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="10"

                                    ToolTip="{Binding [MqttSubResultsPreviewTooltip], Source={x:Static services:LocalizationService.Instance}}">

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">

                                    <StackPanel>

                                        <!-- Status Banner -->

                                        <Border Visibility="{Binding HasRunSimulation, Converter={StaticResource BoolToVis}}" 

                                                BorderThickness="1" CornerRadius="2" Padding="7,5" Margin="0,0,0,6">

                                            <Border.Style>

                                                <Style TargetType="Border">

                                                    <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />

                                                    <Setter Property="BorderBrush" Value="{DynamicResource IndustrialBorderDefaultBrush}" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsSimulationSuccess}" Value="False">

                                                            <Setter Property="Background" Value="{DynamicResource SelectionHoverBrush}" />

                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <DockPanel LastChildFill="True">

                                                <Border Width="3" CornerRadius="1" Margin="0,0,7,0" DockPanel.Dock="Left">

                                                    <Border.Style>

                                                        <Style TargetType="Border">

                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding IsSimulationSuccess}" Value="False">

                                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </Border.Style>

                                                </Border>

                                                <TextBlock Text="{Binding SimulationStatusMessage}" FontWeight="SemiBold" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center">

                                                    <TextBlock.Style>

                                                        <Style TargetType="TextBlock">

                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding IsSimulationSuccess}" Value="False">

                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </TextBlock.Style>

                                                </TextBlock>

                                            </DockPanel>

                                        </Border>



                                        <!-- Extracted Values List -->

                                        <StackPanel Visibility="{Binding HasRunSimulation, Converter={StaticResource BoolToVis}}">

                                            <TextBlock Text="{Binding [MqttSubResultsPreview], Source={x:Static services:LocalizationService.Instance}}" 

                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4" />



                                            <ItemsControl ItemsSource="{Binding Node.Pins}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,3">

                                                            <DockPanel LastChildFill="True">

                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">

                                                                    <TextBlock Text="• " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />

                                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

                                                                    <Border Visibility="{Binding HasCustomResolvedPath, Converter={StaticResource BoolToVis}}"

                                                                            Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1"

                                                                            CornerRadius="2" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">

                                                                        <TextBlock Text="{Binding ResolvedPath}" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />

                                                                    </Border>

                                                                    <TextBlock Text=" ➔" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0" />

                                                                </StackPanel>

                                                                <TextBlock Text="{Binding CurrentStringValue}" FontFamily="Consolas" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource SuccessDarkBrush}" HorizontalAlignment="Right" />

                                                            </DockPanel>

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                    </StackPanel>

                                </ScrollViewer>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>



            <!-- 2. Footer Action -->

            <Border Grid.Row="2" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">

                <DockPanel LastChildFill="False">

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"

                                ToolTip="{Binding [MqttSubFooterTopicTooltip], Source={x:Static services:LocalizationService.Instance}}">

                        <TextBlock Text="{Binding [MqttConfigTargetTopic], Source={x:Static services:LocalizationService.Instance}}" 

                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />

                        <TextBlock Text="{Binding Node.Topic}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" />

                    </StackPanel>



                    <Button Content="{Binding [MqttSubBtnApply], Source={x:Static services:LocalizationService.Instance}}" 

                            DockPanel.Dock="Right" Click="ApplyButton_Click"

                            ToolTip="{Binding [MqttSubBtnApplyTooltip], Source={x:Static services:LocalizationService.Instance}}"

                            Style="{StaticResource BtnPrimary}"

                            FontSize="11.5" Padding="20,6" />

                </DockPanel>

            </Border>

        </Grid>

    </Border>

</Window>

