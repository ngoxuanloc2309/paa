<UserControl x:Class="SimplePLC.Studio.Views.DtuGatewayStudioView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:services="clr-namespace:SimplePLC.Studio.Services"

             xmlns:viewmodels="clr-namespace:SimplePLC.Studio.ViewModels"

             xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"

             xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"

             Background="{DynamicResource BgWindowBrush}"

             FontFamily="Segoe UI"

             TextOptions.TextFormattingMode="Display"

             TextOptions.TextRenderingMode="ClearType"

             RenderOptions.ClearTypeHint="Enabled">



    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="../Styles/Colors.xaml" />

                <ResourceDictionary Source="../Styles/Controls.xaml" />

                <ResourceDictionary Source="../Styles/Icons.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <converters:ComparisonConverter x:Key="CompareConverter" />

            <converters:ComparisonToVisibilityConverter x:Key="CompareToVisConverter" />

            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />



            <!-- Vertical Sidebar Nav Button Style -->

            <Style x:Key="SidebarNavRadioBtnStyle" TargetType="RadioButton">

                <Setter Property="Background" Value="Transparent" />

                <Setter Property="BorderThickness" Value="0" />

                <Setter Property="Padding" Value="14,10" />

                <Setter Property="Cursor" Value="Hand" />

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="RadioButton">

                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,0,0,4">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ActiveIndicator" Grid.Column="0" Width="3" Height="20" Background="{DynamicResource PrimaryBrush}" 

                                            CornerRadius="1.5" Margin="-14,0,10,0" Visibility="Collapsed" />

                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />

                                </Grid>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionHoverBrush}" />

                                </Trigger>

                                <Trigger Property="IsChecked" Value="True">

                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgPanelBrush}" />

                                    <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>



            <!-- Segmented Pill Button Style for Uplink / Role Mode Selection -->

            <Style x:Key="SegmentedPillBtnStyle" TargetType="RadioButton">

                <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />

                <Setter Property="BorderBrush" Value="{DynamicResource IndustrialBorderDefaultBrush}" />

                <Setter Property="BorderThickness" Value="1" />

                <Setter Property="Padding" Value="14,6" />

                <Setter Property="Cursor" Value="Hand" />

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="RadioButton">

                            <Border x:Name="PillBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 

                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource SelectionHoverBrush}" />

                                    <Setter TargetName="PillBd" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />

                                </Trigger>

                                <Trigger Property="IsChecked" Value="True">

                                    <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource BgPanelBrush}" />

                                    <Setter TargetName="PillBd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />

                                    <Setter TargetName="PillBd" Property="BorderThickness" Value="1.5" />

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>

        </ResourceDictionary>

    </UserControl.Resources>



    <!-- 3-COLUMN ERGONOMIC WIDESCREEN ARCHITECTURE -->

    <Grid>

        <Grid.ColumnDefinitions>

            <!-- 0. Left Category Navigation Sidebar (245px) -->

            <ColumnDefinition Width="220" />

            <!-- 1. Center Primary Configuration Workspace (Flexible Min 780px) -->

            <ColumnDefinition Width="*" MinWidth="480" />

            <!-- 2. Right Context Inspector & Live Intelligence Panel (390px) -->

            <ColumnDefinition Width="340" />

        </Grid.ColumnDefinitions>



        <!-- ======================================================== -->

        <!-- COLUMN 0: VERTICAL SIDEBAR NAVIGATION                    -->

        <!-- ======================================================== -->

        <Border Grid.Column="0" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,0,1,0">

            <DockPanel LastChildFill="True">

                <!-- Sidebar Header -->

                <Border DockPanel.Dock="Top" Padding="14,16" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,0,0,1">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">

                            <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysSettings}" 

                                  Stroke="{DynamicResource PrimaryBrush}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />

                            <TextBlock Text="{Binding [DeviceConfigTitle], Source={x:Static services:LocalizationService.Instance}}" 

                                       FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                        </StackPanel>

                        <TextBlock Text="{Binding [DeviceConfigSubtitle], Source={x:Static services:LocalizationService.Instance}}" 

                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

                    </StackPanel>

                </Border>



                <!-- Sidebar Footer: Save Action -->

                <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="0,1,0,0">

                    <StackPanel>

                        <Button Command="{Binding SaveConfigurationCommand}" Style="{StaticResource TiaTactileBtnStyle}" Height="34" Margin="0,0,0,6">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysSave}" 

                                      Stroke="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />

                                <TextBlock Text="{Binding [BtnSaveConfig], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>

                        <TextBlock Text="{Binding DeployStatusMessage}" FontSize="10" Foreground="{DynamicResource SuccessBrush}" 

                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />

                    </StackPanel>

                </Border>



                <!-- Navigation List Items -->

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,10">

                    <StackPanel>

                        <!-- Item 0: RS-485 Modbus -->

                        <RadioButton Style="{StaticResource SidebarNavRadioBtnStyle}" GroupName="DeviceNavSection"

                                     IsChecked="{Binding IsSectionRs485, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="0"

                                     Visibility="{Binding HasRs485Capability, Converter={StaticResource BoolToVis}}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconIecModbus}" 

                                      Stroke="{DynamicResource PrimaryBrush}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding [DeviceNavRs485], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Text="{Binding [DeviceNavRs485Desc], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />

                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 

                                        BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Rs485StatusBadge}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />

                                </Border>

                            </Grid>

                        </RadioButton>



                        <!-- Item 1: Wi-Fi Network -->

                        <RadioButton Style="{StaticResource SidebarNavRadioBtnStyle}" GroupName="DeviceNavSection"

                                     IsChecked="{Binding IsSectionWifi, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="1"

                                     Visibility="{Binding HasWifiCapability, Converter={StaticResource BoolToVis}}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysRadio}" 

                                      Stroke="{DynamicResource PrimaryBrush}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding [DeviceNavWifi], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Text="{Binding [DeviceNavWifiDesc], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />

                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 

                                        BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding WifiStatusBadge}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />

                                </Border>

                            </Grid>

                        </RadioButton>



                        <!-- Item 2: MQTT Client -->

                        <RadioButton Style="{StaticResource SidebarNavRadioBtnStyle}" GroupName="DeviceNavSection"

                                     IsChecked="{Binding IsSectionMqtt, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="2"

                                     Visibility="{Binding HasMqttCapability, Converter={StaticResource BoolToVis}}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconIecMqtt}" 

                                      Stroke="{DynamicResource PrimaryBrush}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding [DeviceNavMqtt], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Text="{Binding [DeviceNavMqttDesc], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />

                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 

                                        BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding MqttSidebarBadgeText}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />

                                </Border>

                            </Grid>

                        </RadioButton>



                        <!-- Item 3: HTTP Client -->

                        <RadioButton Style="{StaticResource SidebarNavRadioBtnStyle}" GroupName="DeviceNavSection"

                                     IsChecked="{Binding IsSectionHttp, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="3"

                                     Visibility="{Binding HasHttpCapability, Converter={StaticResource BoolToVis}}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconIecHttpClient}" 

                                      Stroke="{DynamicResource PrimaryBrush}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding [DeviceNavHttp], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Text="{Binding [DeviceNavHttpDesc], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />

                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 

                                        BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding HttpSidebarBadgeText}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />

                                </Border>

                            </Grid>

                        </RadioButton>



                        <!-- Item 4: TCP Client -->

                        <RadioButton Style="{StaticResource SidebarNavRadioBtnStyle}" GroupName="DeviceNavSection"

                                     IsChecked="{Binding IsSectionTcp, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="4"

                                     Visibility="{Binding HasTcpSocketCapability, Converter={StaticResource BoolToVis}}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysConnect}" 

                                      Stroke="{DynamicResource PrimaryBrush}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding [DeviceNavTcp], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Text="{Binding [DeviceNavTcpDesc], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />

                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 

                                        BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding TcpSidebarBadgeText}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />

                                </Border>

                            </Grid>

                        </RadioButton>

                        <!-- Item 5: Zigbee Wireless -->
                        <RadioButton Style="{StaticResource SidebarNavRadioBtnStyle}" GroupName="DeviceNavSection"
                                     IsChecked="{Binding IsSectionZigbee, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="5"
                                     Visibility="{Binding HasZigbeeCapability, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysRadio}" 
                                      Stroke="{DynamicResource PrimaryBrush}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [DeviceNavZigbee], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding [DeviceNavZigbeeDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                                        BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ZigbeeSidebarBadgeText}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>

                    </StackPanel>

                </ScrollViewer>

            </DockPanel>

        </Border>



        <!-- ======================================================== -->

        <!-- COLUMN 1: CENTER PRIMARY CONFIGURATION WORKSPACE         -->

        <!-- ======================================================== -->

        <Border Grid.Column="1" Background="{DynamicResource BgAppBrush}" Padding="22,18">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                <StackPanel>



                    <!-- SECTION 0: RS-485 MODBUS -->

                    <StackPanel Visibility="{Binding IsSectionRs485, Converter={StaticResource BoolToVis}}">

                        <!-- Section Header -->

                        <StackPanel Margin="0,0,0,16">

                            <TextBlock Text="{Binding [DeviceNavRs485], Source={x:Static services:LocalizationService.Instance}}" 

                                       FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />

                            <TextBlock Text="{Binding [DeviceNavRs485Desc], Source={x:Static services:LocalizationService.Instance}}" 

                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />

                        </StackPanel>



                        <!-- Reusable Modbus Port Configuration Control -->

                        <controls:ModbusPortConfigControl DataContext="{Binding ModbusPortConfigVM}" />

                    </StackPanel>



<!-- ================= SECTION 1: MẠNG WI-FI ================= -->

                    <StackPanel Visibility="{Binding IsSectionWifi, Converter={StaticResource BoolToVis}}">

                        <!-- Header with Enable Checkbox -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                <TextBlock Text="{Binding [DeviceNavWifi], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />

                                <TextBlock Text="{Binding [DeviceWifiSubtitle], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />

                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding WifiEnabled}" 

                                      Content="{Binding [EnableWifiService], Source={x:Static services:LocalizationService.Instance}}"

                                      FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                        </Grid>



                        <!-- Notice Banner when Wi-Fi is Disabled -->

                        <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 

                                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,14"

                                Visibility="{Binding WifiEnabled, Converter={StaticResource InverseBoolToVis}}">

                            <StackPanel Orientation="Horizontal">

                                <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysAlertTriangle}" 

                                      Stroke="{DynamicResource WarningBrush}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />

                                <TextBlock Text="{Binding [NoticeWifiDisabled], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

                            </StackPanel>

                        </Border>



                        <!-- Reusable Wi-Fi Network & Configuration Control (Disabled when WifiEnabled is false) -->

                        <Border IsEnabled="{Binding WifiEnabled}">

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Style.Triggers>

                                        <Trigger Property="IsEnabled" Value="False">

                                            <Setter Property="Opacity" Value="0.45" />

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <controls:WifiConfigControl DataContext="{Binding WifiVM}" />

                        </Border>

                    </StackPanel>







<!-- ================= SECTION 2: MQTT CLIENT ================= -->

                    <StackPanel Visibility="{Binding IsSectionMqtt, Converter={StaticResource BoolToVis}}">

                        <!-- Section Header -->

                        <StackPanel Margin="0,0,0,16">

                            <TextBlock Text="{Binding [PageHeaderMqttTitle], Source={x:Static services:LocalizationService.Instance}}" 

                                       FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />

                            <TextBlock Text="{Binding [PageHeaderMqttSubtitle], Source={x:Static services:LocalizationService.Instance}}" 

                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />

                        </StackPanel>



                                                <!-- Notice Banner when Wi-Fi is Disabled while MQTT is enabled on Wi-Fi capable device -->
                        <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,14"
                                Visibility="{Binding IsWifiRequiredNoticeVisible, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" 
                                        Content="{Binding [ActionEnableWifiNow], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding EnableWifiCommand}"
                                        Style="{StaticResource BtnSecondary}" Padding="10,3" FontSize="11" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysInfo}" 
                                          Stroke="{DynamicResource PrimaryBrush}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [NoticeWifiRequiredForMqtt], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
<!-- MQTT Sub-navigation Segmented Bar -->

                        <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 

                                BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" Padding="4">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0" Style="{StaticResource SegmentedPillBtnStyle}" GroupName="MqttSubSectionGroup"

                                             IsChecked="{Binding IsMqttTabBroker, Mode=TwoWay}">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconIecMqtt}" 

                                              Stroke="{DynamicResource PrimaryBrush}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />

                                        <TextBlock Text="{Binding [DtuTabBrokerServer], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    </StackPanel>

                                </RadioButton>

                                <RadioButton Grid.Column="1" Style="{StaticResource SegmentedPillBtnStyle}" GroupName="MqttSubSectionGroup"

                                             IsChecked="{Binding IsMqttTabTelemetry, Mode=TwoWay}">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconMqttTelemetry}" 

                                              Stroke="{DynamicResource PrimaryBrush}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />

                                        <TextBlock Text="{Binding [DtuTabTelemetryPub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    </StackPanel>

                                </RadioButton>

                                <RadioButton Grid.Column="2" Style="{StaticResource SegmentedPillBtnStyle}" GroupName="MqttSubSectionGroup"

                                             IsChecked="{Binding IsMqttTabCommand, Mode=TwoWay}">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconMqttCommand}" 

                                              Stroke="{DynamicResource PrimaryBrush}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />

                                        <TextBlock Text="{Binding [DtuTabCommandSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    </StackPanel>

                                </RadioButton>

                            </Grid>

                        </Border>



                        <!-- 1. Broker Server & Security Tab -->

                        <controls:MqttBrokerConfigControl DataContext="{Binding MqttBrokerConfigVM}" 

                                                          Visibility="{Binding Path=DataContext.IsMqttTabBroker, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />



                        <!-- 2. Telemetry Publish Tab -->

                        <controls:MqttTelemetryPublishControl DataContext="{Binding MqttTelemetryVM}"

                                                             Visibility="{Binding Path=DataContext.IsMqttTabTelemetry, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />



                        <!-- 3. Command Subscribe Tab -->

                        <controls:MqttCommandSubscribeControl DataContext="{Binding MqttCommandVM}"

                                                              Visibility="{Binding Path=DataContext.IsMqttTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />

                    </StackPanel>



                    <!-- ================= SECTION 3: HTTP CLIENT ================= -->

                    <StackPanel Visibility="{Binding IsSectionHttp, Converter={StaticResource BoolToVis}}">

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                <TextBlock Text="{Binding [PageHeaderHttpTitle], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />

                                <TextBlock Text="{Binding [PageHeaderHttpSubtitle], Source={x:Static services:LocalizationService.Instance}}" 

                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />

                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding HttpEnabled}" 

                                      Content="{Binding [EnableHttpClientService], Source={x:Static services:LocalizationService.Instance}}"

                                      FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                        </Grid>



                        <!-- Notice Banner when HTTP Client is Disabled -->

