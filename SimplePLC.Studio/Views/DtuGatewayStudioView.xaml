                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding TcpServerDisplay}" 

                                               FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />

                                </Grid>



                                <!-- Row 3: Port -->

                                <Grid Margin="0,0,0,7">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding [InspectorTcpPortLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding TcpPortDisplay}" 

                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />

                                </Grid>



                                <!-- Row 4: Heartbeat -->

                                <Grid Margin="0,0,0,7">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding [InspectorTcpHeartbeatLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding TcpHeartbeatDisplay}" 

                                               FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />

                                </Grid>



                                <!-- Row 5: Registration -->

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding [InspectorTcpRegLabel], Source={x:Static services:LocalizationService.Instance}}" 

                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding TcpRegDisplay}" 

                                               FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />

                                </Grid>

                            </StackPanel>

                        

                        </Border>



                    </StackPanel>

<!-- ================= INSPECTOR FOR SECTION 5: ZIGBEE WIRELESS ================= -->
                        <StackPanel Visibility="{Binding IsSectionZigbee, Converter={StaticResource BoolToVis}}">
                            <!-- Card 1: Wireless Link & Telemetry (IBM Carbon Key-Value Layout) -->
                            <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" 
                                    BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                <StackPanel DataContext="{Binding ZigbeeVM}">
                                    <TextBlock Text="{Binding [InspectorZigbeeRadioTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                    <!-- Row 1: Link State -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [ZigbeeInspectorLinkState], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding LinkStateDisplayText}" 
                                                   FontSize="11" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLinkUp}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Row 2: Signal Strength (RSSI) -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [ZigbeeInspectorRssi], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding RssiDisplayText}" 
                                                   FontSize="11" FontFamily="Cascadia Code, Consolas" FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Row 3: Signal Quality (LQI) -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [ZigbeeInspectorLqi], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Lqi}" 
                                                   FontSize="11" FontFamily="Cascadia Code, Consolas" FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Row 4: Mesh Node Count -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [ZigbeeInspectorNodeCount], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding NodeCount}" 
                                                   FontSize="11" FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Row 5: Hardware Error Code -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [ZigbeeInspectorErrorCode], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding ErrorDisplayText}" 
                                                   FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                   TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>


                        </StackPanel>



                    </StackPanel>

                </ScrollViewer>

            </DockPanel>

        </Border>

    </Grid>

</UserControl>

