<Window x:Class="SimplePLC.Studio.Views.DeviceInfoDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:viewmodels="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [DeviceInfoTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="730" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        Icon="../Assets/app.png"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Content Cards -->
                <RowDefinition Height="*" />
                <!-- 2. Footer Action -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Margin="0,0,14,0">
                    <TextBlock Text="📟" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeviceModel}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding [DeviceInfoSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Online / Offline Badge -->
                <Border Grid.Column="2" BorderThickness="1" CornerRadius="2" Padding="12,5" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F3F4F6" />
                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Background" Value="#E6F4EA" />
                                    <Setter Property="BorderBrush" Value="#107C41" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Foreground" Value="#107C41" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- 1. Content Cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Card 1: Nhận dạng phần cứng & Firmware (Mục 1) -->
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding [DeviceInfoGroupOverview], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#006487" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="165" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" MinWidth="165" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [DeviceInfoClass], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceClassText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding [DeviceInfoHwVersion], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding HwVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <!-- Row 1 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [DeviceInfoVariant], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceVariantText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding [DeviceInfoFwVersion], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding FwVersion}" FontSize="12" FontWeight="SemiBold" Foreground="#006487" Margin="6,4" VerticalAlignment="Center" />

                                <!-- Row 2 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [DeviceInfoWireProfile], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WireProfileText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding [DeviceInfoRuleFormat], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding RuleFormatText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Bản đồ tài nguyên I/O & Bộ nhớ (Mục 2) -->
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding [DeviceInfoGroupResources], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#006487" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="165" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" MinWidth="165" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [DeviceInfoDigitalInputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DigitalInputsText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding [DeviceInfoVirtualFlags], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding VirtualFlagsText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <!-- Row 1 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [DeviceInfoDigitalOutputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DigitalOutputsText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding [DeviceInfoVirtualRegs], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding VirtualRegsText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <!-- Row 2 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [DeviceInfoAnalogInputs], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AnalogInputsText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding [DeviceInfoRetainRegs], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding RetainRegsText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <!-- Row 3 -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [DeviceInfoMaxRules], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MaxRulesText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding [DeviceInfoCounters], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding CountersText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Thông số truyền thông -->
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{Binding [DeviceInfoGroupComms], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#006487" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="165" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" MinWidth="165" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [DeviceInfoPort], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PortName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding [DeviceInfoBaudRate], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding BaudRate, StringFormat='{}{0} bps'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <!-- Row 1 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [DeviceInfoSlaveId], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SlaveId, StringFormat='{}# {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding [DeviceInfoProtocol], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding ProtocolText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. Footer Action -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [DeviceInfoBtnClose], Source={x:Static services:LocalizationService.Instance}}"
                        Padding="28,6" FontSize="12" FontWeight="SemiBold"
                        Style="{StaticResource BtnPrimary}"
                        IsDefault="True" IsCancel="True"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
