<UserControl x:Class="SimplePLC.Studio.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
             xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverterEx x:Key="InverseBoolToVis" Invert="True" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Action Ribbon (Industrial Desktop Style) -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="16,14" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <!-- Action Button at Top Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="{Binding ActionButtonText}"
                            Command="{Binding PrimaryActionCommand}"
                            Padding="20,10" FontSize="13" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Background" Value="#107C41" />
                                        <Setter Property="BorderBrush" Value="#0B5A2F" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanDeploy}" Value="False" />
                                            <Condition Binding="{Binding IsSuccess}" Value="False" />
                                            <Condition Binding="{Binding IsDeploying}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#006487" />
                                        <Setter Property="BorderBrush" Value="#004D68" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Left: Title, Device Badge & Context Subtitle -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [DeployTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        
                        <Border Background="#F3F4F6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#94A3B8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#107C41" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DeviceInfoBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content (2 Columns Desktop Layout) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Bản Kê Khai Cấu Hình & Chẩn Đoán (Left Column) -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="16" Margin="0,0,16,0">
                <DockPanel>
                    <!-- Header of Left Column -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{Binding [DeployManifestHeader], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border CornerRadius="2" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F3F4F6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasValidRules}" Value="True">
                                            <Setter Property="Background" Value="#E6F4EA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding [DeployManifestNotReady], Source={x:Static services:LocalizationService.Instance}}" />
                                        <Setter Property="Foreground" Value="#94A3B8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValidRules}" Value="True">
                                                <Setter Property="Text" Value="{Binding [DeployManifestValid], Source={x:Static services:LocalizationService.Instance}}" />
                                                <Setter Property="Foreground" Value="#107C41" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <!-- Content Stack -->
                    <StackPanel>
                        <!-- Scenario 1: Blocked / Warning Card -->
                        <Border Visibility="{Binding CanDeploy, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Setter Property="BorderBrush" Value="#C05621" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="2" />
                                    <Setter Property="Padding" Value="12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDeploying}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding StatusTitle}" FontWeight="Bold" FontSize="12" Foreground="#C05621" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding StatusSubtitle}" FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,10" />
                                
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding [DeployBtnOpenRules], Source={x:Static services:LocalizationService.Instance}}" 
                                            Command="{Binding NavigateToRulesCommand}" 
                                            Style="{StaticResource BtnSecondary}" Padding="10,5" FontSize="11" Margin="0,0,8,0" />
                                    <Button Content="{Binding [DeployBtnOpenLogic], Source={x:Static services:LocalizationService.Instance}}" 
                                            Command="{Binding NavigateToLogicEditorCommand}" 
                                            Style="{StaticResource BtnSecondary}" Padding="10,5" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Scenario 2: Success Card -->
                        <Border Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="#E6F4EA" />
                                    <Setter Property="BorderBrush" Value="#107C41" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="2" />
                                    <Setter Property="Padding" Value="12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding [DeploySuccessTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontWeight="Bold" FontSize="12" Foreground="#107C41" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding [DeploySuccessDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" Foreground="#107C41" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Manifest Details (Always Available) -->
                        <StackPanel>
                            <!-- Item 1: Quy tắc nạp -->
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [DeployRuleCountLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ManifestRuleCountText}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Item 2: Tóm tắt logic -->
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding [DeployLogicSummaryLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding ManifestRuleSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Item 3: Cơ chế an toàn -->
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding [DeploySafetyMechLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding [DeploySafetyMechDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#006487" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Column 1: Tiến Trình Nạp & Output Console (Right Column) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Upper Section: 5 Steps Stepper -->
                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="16" Margin="0,0,0,16">
                    <DockPanel>
                        <!-- Stepper Header -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="{Binding [DeployPipelineHeader], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Background="#ECEFF1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StepperBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            </Border>
                        </DockPanel>

                        <!-- Progress Bar (Only visible during deploying or success) -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding [DeployProgressLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontWeight="Bold" FontFamily="Consolas" 
                                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <ProgressBar Value="{Binding ProgressPercent}" Height="6" Foreground="{StaticResource PrimaryBrush}" Background="#DFE3E8" BorderThickness="0" />
                        </StackPanel>

                        <!-- 5 Steps List (Single-line per step) -->
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Step Number -->
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" BorderThickness="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F3F4F6" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Success}">
                                                                <Setter Property="Background" Value="#E6F4EA" />
                                                                <Setter Property="BorderBrush" Value="#107C41" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.InProgress}">
                                                                <Setter Property="Background" Value="#ECEFF1" />
                                                                <Setter Property="BorderBrush" Value="#006487" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Index}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Success}">
                                                                    <Setter Property="Foreground" Value="#107C41" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.InProgress}">
                                                                    <Setter Property="Foreground" Value="#006487" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Step Title -->
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0" />

                                            <!-- Step Status Badge -->
                                            <Border Grid.Column="2" CornerRadius="2" Padding="6,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F3F4F6" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Success}">
                                                                <Setter Property="Background" Value="#E6F4EA" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.InProgress}">
                                                                <Setter Property="Background" Value="#ECEFF1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding [DeployStepStatusPending], Source={x:Static services:LocalizationService.Instance}}" />
                                                            <Setter Property="Foreground" Value="#94A3B8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Success}">
                                                                    <Setter Property="Text" Value="{Binding [DeployStepStatusDone], Source={x:Static services:LocalizationService.Instance}}" />
                                                                    <Setter Property="Foreground" Value="#107C41" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.InProgress}">
                                                                    <Setter Property="Text" Value="{Binding [DeployStepStatusRunning], Source={x:Static services:LocalizationService.Instance}}" />
                                                                    <Setter Property="Foreground" Value="#006487" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Lower Section: Console Output Log -->
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2">
                    <DockPanel>
                        <!-- Console Header -->
                        <Border DockPanel.Dock="Top" Background="#ECEFF1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                            <DockPanel>
                                <TextBlock Text="{Binding [DeployOutputLogHeader], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="{Binding [DeployBtnCopy], Source={x:Static services:LocalizationService.Instance}}" 
                                            Command="{Binding CopyLogCommand}" Style="{StaticResource BtnSecondary}" Padding="8,3" FontSize="10" Margin="0,0,6,0" />
                                    <Button Content="{Binding [DeployBtnClear], Source={x:Static services:LocalizationService.Instance}}" 
                                            Command="{Binding ClearLogCommand}" Style="{StaticResource BtnSecondary}" Padding="8,3" FontSize="10" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Terminal Textbox -->
                        <TextBox Text="{Binding ConsoleLog}" IsReadOnly="True"
                                 Background="#FFFFFF" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11"
                                 BorderThickness="0" Padding="12,10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
