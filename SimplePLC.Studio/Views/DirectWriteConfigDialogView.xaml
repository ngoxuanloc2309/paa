<Window x:Class="SimplePLC.Studio.Views.DirectWriteConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [DirectWriteDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="540"
        SizeToContent="Height"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        Icon="../Assets/app.png"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Card 1: Target Pin & Operating Mode -->
                <RowDefinition Height="Auto" />
                <!-- 2. Card 2: Mode Parameters -->
                <RowDefinition Height="Auto" />
                <!-- 3. Footer Action -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Margin="0,0,14,0">
                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [DirectWriteDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Subtitle}" 
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 1. Card 1: Target Pin & Operating Mode -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [DirectWriteSectionHardware], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Target Pin -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [DirectWriteTargetPinLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableTargetPins}" 
                                      SelectedValue="{Binding TargetPin}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                      Height="28" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                        </StackPanel>

                        <!-- Operating Mode -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding [DirectWriteModeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableModes}" 
                                      SelectedValue="{Binding Mode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                      Height="28" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                        </StackPanel>
                    </Grid>

                    <!-- Trigger Mode -->
                    <StackPanel>
                        <TextBlock Text="{Binding [DirectWriteTriggerModeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableTriggerModes}" 
                                  SelectedValue="{Binding TriggerMode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                  Height="28" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Card 2: Mode Parameters -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="16,14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding [DirectWriteSectionParameters], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="11.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12" />

                    <!-- Mode A: Digital Output (DO) -->
                    <StackPanel Visibility="{Binding IsDigitalOutputMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Active Level -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWriteActiveLevelLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableActiveLevels}" 
                                          SelectedValue="{Binding IsActiveHigh}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                          Height="28" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                            </StackPanel>

                            <!-- Fail-Safe State -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [DirectWriteFailSafeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableFailSafeStates}" 
                                          SelectedValue="{Binding FailSafeState}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                          Height="28" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Mode B: PWM Duty Cycle -->
                    <StackPanel Visibility="{Binding IsPwmMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <!-- Frequency -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWritePwmFreqLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PwmFrequencyHz, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                         Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <!-- Min Duty -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [DirectWriteDutyMinLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DutyMin, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                         Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <!-- Max Duty -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding [DirectWriteDutyMaxLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DutyMax, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                         Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Mode C: Pulse Train Output (PTO) -->
                    <StackPanel Visibility="{Binding IsPulseTrainMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Pulse Width -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWritePulseWidthLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PulseWidthUs, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                         Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <!-- Max Frequency -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [DirectWriteMaxFreqLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MaxFrequencyHz, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                         Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Mode D: Addressable Bus -->
                    <StackPanel Visibility="{Binding IsAddressableBusMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Channel Count -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWriteChannelCountLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ChannelCount, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="28" Padding="6,4" FontSize="11.5" FontFamily="Consolas" TextAlignment="Center" 
                                         Background="#FFFFFF" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <!-- Exclusive Checkbox -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <CheckBox IsChecked="{Binding IsExclusiveChannel}" VerticalContentAlignment="Center">
                                    <TextBlock Text="{Binding [DirectWriteExclusiveChannelLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontSize="11" Foreground="#334155" Margin="4,0,0,0" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Footer Action -->
            <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <DockPanel LastChildFill="False">
                    <!-- Left: Target Terminal Summary Badge -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [DirectWriteSummaryPin], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="#64748B" Margin="0,0,6,0" />
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="6,2">
                            <TextBlock Text="{Binding SummaryBadgeText}" 
                                       FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#0284C7" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Apply and Cancel Buttons -->
                    <Button Content="{Binding [BtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            DockPanel.Dock="Right" Click="Apply_Click"
                            IsEnabled="{Binding HasAvailablePins}"
                            Style="{StaticResource BtnPrimary}"
                            FontSize="11.5" Height="28" Padding="18,4" Margin="8,0,0,0" />
                    <Button Content="{Binding [BtnCancel], Source={x:Static services:LocalizationService.Instance}}" 
                            DockPanel.Dock="Right" Click="Cancel_Click"
                            Style="{StaticResource TiaTactileBtnStyle}"
                            FontSize="11.5" Height="28" Padding="16,4" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
