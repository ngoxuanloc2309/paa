<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit1030: ConfigureAwait(false) in test helpers is intentional for
         infrastructure-level async E2E tests; suppress the analyzer warning -->
    <NoWarn>$(NoWarn);xUnit1030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimplePLC.Domain\SimplePLC.Domain.csproj" />
    <ProjectReference Include="..\..\src\SimplePLC.Protocol\SimplePLC.Protocol.csproj" />
    <ProjectReference Include="..\..\src\SimplePLC.Infrastructure\SimplePLC.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SimplePLC.Application\SimplePLC.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
